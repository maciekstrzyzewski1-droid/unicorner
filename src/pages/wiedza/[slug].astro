---
import Base from '../../layouts/Base.astro';
import '../../styles/wiedza.css';
import Bar from '../../components/wiedza/Bar.astro';
import Card from '../../components/wiedza/Card.astro';
import Foot from '../../components/wiedza/Foot.astro';
import { getArticles, seriesNeighbours } from '../../lib/wiedza.js';

export function getStaticPaths() {
  return getArticles().map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const all = getArticles();
const { prev, next } = seriesNeighbours(a);
const seriesList = a.series ? all.filter((x) => x.series === a.series).sort((x, y) => x.part - y.part) : [];
const related = all.filter((x) => x.category === a.category && x.slug !== a.slug && x.series !== a.series || (x.category === a.category && !a.series && x.slug !== a.slug))
  .filter((x, i, arr) => arr.findIndex((y) => y.slug === x.slug) === i).slice(0, 3);
// Do nagłówka artykułu dokładamy: podtytuł „o czym to jest” (pod h1) i — w seriach —
// informację, że część czyta się osobno (przed końcem <header>).
const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
let html = a.html;
if (a.topic) html = html.replace('</h1>', `</h1><p class="wz-topic">${esc(a.topic)}</p>`);
if (a.series) html = html.replace('</header>', `<div class="wz-solo"><b>Część ${a.part} z ${a.seriesTotal} · ${esc(a.seriesName.toLowerCase())}.</b> Nie musisz znać poprzednich części. Gdy tekst nawiązuje do czegoś z innej części, przy pojęciu jest numerek — najedź na niego albo go stuknij, a zobaczysz krótkie wyjaśnienie.</div></header>`);
const url = `https://unicorner.pl${a.url}`;
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: a.seoTitle, description: a.lede, inLanguage: 'pl',
  url, mainEntityOfPage: url, articleSection: a.categoryName, wordCount: a.words,
  publisher: { '@type': 'Organization', name: 'Unicorner', url: 'https://unicorner.pl' },
  ...(a.series ? { isPartOf: { '@type': 'CreativeWorkSeries', name: a.seriesName } } : {}),
};
---
<Base title={`${a.seoTitle} · Unicorner`} description={a.lede}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <link rel="stylesheet" href="/fonts/fonty-artykul.css" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={a.seoTitle} />
    <meta property="og:description" content={a.lede} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content="https://unicorner.pl/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="article:section" content={a.categoryName} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <style is:inline>
      /* przywrócenie domyślnych odstępów (Tailwind preflight je zeruje); :where = zero specyficzności, CSS artykułu wygrywa */
      :where(.art) p{margin:0 0 1.15em;}
      :where(.art) ul{list-style:disc;padding-left:1.4em;margin:0 0 1.15em;}
      :where(.art) ol{list-style:decimal;padding-left:1.4em;margin:0 0 1.15em;}
      :where(.art) li{margin-bottom:.35em;}
      :where(.art) h3{font-size:1.17em;font-weight:600;margin:1.6em 0 .6em;}
      :where(.art) h4{font-weight:600;margin:1.2em 0 .5em;}
      :where(.art) blockquote{margin:1.4em 0;padding-left:1em;border-left:2px solid #d1a13f;}
      :where(.art) table{border-collapse:collapse;}
      :where(.art) sup{font-size:.7em;vertical-align:super;line-height:0;}
    </style>
    <style is:inline set:html={a.css}></style>
    <style is:inline>
      /* strona artykułu w palecie i czcionkach pliku źródłowego (ciemna zieleń, złoto, Fraunces + Work Sans);
         zmienne nadpisane na body, więc ramka (pasek, kafelki, nawigacja serii) też jest w tej palecie */
      html body{--ink:#14150f;--ink2:#1b1c15;--surface:#1b1c15;--surface2:#22231a;--line:rgba(236,229,209,.1);--line2:rgba(236,229,209,.2);
        --text:#ece5d1;--muted:#a9a292;--muted2:#8a8474;--accent:#d1a13f;--cyan:#d1a13f;--magenta:#c96a4e;--gold:#d1a13f;--ok:#7fa06a;
        --iris:linear-gradient(115deg,#d1a13f,#e6c06a);--disp:'Fraunces',Georgia,serif;--mono:'Work Sans',-apple-system,'Segoe UI',sans-serif;
        background:#14150f;font-family:'Work Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}
      html body::before{display:none;}
      .art{background:transparent;}
      article.art .wz-topic{color:#d1a13f;}
      article.art .wz-solo{background:rgba(209,161,63,.07);}
      article.art sup.ex{color:#d1a13f;background:rgba(209,161,63,.14);}
      article.art sup.ex:hover,article.art sup.ex[aria-expanded="true"]{background:rgba(209,161,63,.26);}
      .wz-fn{background:#1b1c15;border-color:rgba(209,161,63,.5);box-shadow:0 18px 50px rgba(0,0,0,.6);}
      .wz-fn a{color:#d1a13f;}
      .art .wrap{position:relative;}
      .art .caption{margin-bottom:30px;}
      .art table{display:block;overflow-x:auto;}
      @media (min-width:561px){.art table{display:table;}}
      /* spis treści (generowany przy buildzie w src/lib/wiedza.js) */
      article.art .wz-toc{margin:0 0 30px;border:1px solid rgba(236,229,209,.1);background:#1b1c15;}
      article.art .wz-toc summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;padding:13px 16px;}
      article.art .wz-toc summary::-webkit-details-marker{display:none;}
      article.art .wz-toc summary .k{font:600 12px/1.2 'Work Sans',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#d1a13f;}
      article.art .wz-toc summary .m{font-size:.82rem;color:#a9a292;flex:1;}
      article.art .wz-toc summary::after{content:"+";color:#d1a13f;font:400 1.2rem/1 'Work Sans',sans-serif;}
      article.art .wz-toc details[open] summary::after{content:"–";}
      article.art .wz-toc ol{list-style:none;margin:0;padding:0 16px 10px;}
      article.art .wz-toc li{margin:0;}
      article.art .wz-toc li a{display:grid;grid-template-columns:1fr auto;gap:2px 14px;padding:9px 0;border-top:1px solid rgba(236,229,209,.08);text-decoration:none;color:#ece5d1;}
      article.art .wz-toc li a:hover .t{color:#d1a13f;}
      article.art .wz-toc .n{grid-column:1/-1;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#a9a292;}
      article.art .wz-toc .t{font-size:.95rem;line-height:1.35;}
      article.art .wz-toc .min{font-size:.8rem;color:#a9a292;white-space:nowrap;align-self:end;}
      article.art .wz-toc li.mk .t::after{content:"  · tu jest znacznik";color:#d1a13f;font-size:.8rem;white-space:nowrap;}
      /* znacznik czytania */
      article.art .wrap > *{scroll-margin-top:84px;}
      article.art .wz-marked{position:relative;}
      article.art .wz-marked::before{content:"";position:absolute;left:-14px;top:3px;bottom:3px;width:3px;background:#d1a13f;}
      article.art .wz-flash{outline:2px solid transparent;outline-offset:8px;animation:wzflash 1.8s ease;}
      @keyframes wzflash{0%{outline-color:rgba(209,161,63,.75);}100%{outline-color:rgba(209,161,63,0);}}
      article.art .wz-bm-bar{display:flex;align-items:center;gap:10px 14px;flex-wrap:wrap;margin:0 0 30px;padding:12px 16px;border:1px solid rgba(209,161,63,.4);background:rgba(209,161,63,.07);}
      article.art .wz-bm-bar[hidden]{display:none;}
      article.art .wz-bm-bar .tx{flex:1;min-width:180px;line-height:1.35;}
      article.art .wz-bm-bar .k{display:block;font:600 11px/1.4 'Work Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#d1a13f;}
      article.art .wz-bm-bar .c{font-size:.9rem;color:#ece5d1;}
      article.art .wz-bm-bar button,.wz-bm button,article.art .wz-bm-stop{font:500 13px/1 'Work Sans',-apple-system,'Segoe UI',sans-serif;color:#ece5d1;background:#1b1c15;border:1px solid rgba(209,161,63,.45);padding:9px 14px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;}
      article.art .wz-bm-bar button.go{background:#d1a13f;color:#14150f;border-color:#d1a13f;}
      article.art .wz-bm-bar button.rm{border-color:rgba(236,229,209,.2);color:#a9a292;}
      article.art .wz-bm-bar button:hover,.wz-bm button:hover,article.art .wz-bm-stop:hover{border-color:#d1a13f;}
      article.art .wz-bm-stop{margin-top:12px;}
      .wz-bm{position:fixed;right:18px;bottom:18px;z-index:30;display:flex;gap:8px;}
      .wz-bm button{border-radius:999px;padding:11px 16px;box-shadow:0 10px 28px rgba(0,0,0,.5);}
      .wz-bm button[hidden]{display:none;}
      .wz-bm svg,article.art .wz-bm-bar svg,article.art .wz-bm-stop svg{width:15px;height:15px;fill:none;stroke:#d1a13f;stroke-width:1.8;stroke-linejoin:round;flex-shrink:0;}
      article.art .wz-bm-bar button.go svg{stroke:#14150f;}
      .wz-bm-toast{position:fixed;left:50%;bottom:78px;transform:translateX(-50%);z-index:31;max-width:min(92vw,420px);background:#1b1c15;border:1px solid rgba(209,161,63,.5);color:#ece5d1;font:400 .88rem/1.45 'Work Sans',sans-serif;padding:10px 14px;box-shadow:0 12px 30px rgba(0,0,0,.55);}
      .wz-bm-toast[hidden]{display:none;}
      @media (max-width:560px){.wz-bm{right:12px;bottom:12px;}.wz-bm .lbl{display:none;}.wz-bm button{padding:13px;}}
      @media (prefers-reduced-motion:reduce){article.art .wz-flash{animation:none;}}
    </style>
  </Fragment>

  <Bar crumbs={[{ label: 'Wiedza', href: '/wiedza.html' }, { label: a.categoryName, href: `/wiedza.html#${a.category}` }, { label: a.title }]}
       back={{ label: '← Wszystkie teksty', href: '/wiedza.html' }} progress={true} />

  <main id="main">
  <article class="art art-shell" set:html={html} />
  <div class="wz-fn" id="wzFn" role="tooltip" hidden></div>

  <div class="wz-after">
    {a.series && (
      <nav class="wz-series" aria-label={a.seriesName}>
        <div class="lbl">// {a.seriesName} · część {a.part} z {seriesList.length}</div>
        <ol>
          {seriesList.map((s) => (
            <li class={s.slug === a.slug ? 'cur' : ''}><a href={s.url} aria-current={s.slug === a.slug ? 'page' : undefined}><span class="n">{String(s.part).padStart(2, '0')}</span>{s.title}</a></li>
          ))}
        </ol>
      </nav>
    )}
    {(prev || next) && (
      <div class="wz-pn">
        {prev && <a href={prev.url}><span class="k">← Poprzednia część</span><span class="t">{prev.title}</span></a>}
        {next && <a class="next" href={next.url}><span class="k">Następna część →</span><span class="t">{next.title}</span></a>}
      </div>
    )}
  </div>

  {related.length > 0 && (
    <section class="wz-more">
      <div class="wz-glabel"><h2>Czytaj dalej</h2><span class="line"></span></div>
      <div class="wz-grid">{related.map((r) => <Card a={r} />)}</div>
    </section>
  )}
  </main>

  <Foot />

  <script is:inline>
    // Objaśnienia w dymku: numerek przy pojęciu (np. „drabina dowodów”) po najechaniu (mysz), fokusie
    // (klawiatura) albo stuknięciu (telefon) pokazuje w ramce, o co chodzi — bez wychodzenia z artykułu
    // i szukania definicji w innej części. Treść objaśnień: <ol class="explain"> na końcu pliku artykułu.
    (function(){
      var art=document.querySelector('.art'), pop=document.getElementById('wzFn'); if(!art||!pop) return;
      var notes={}; art.querySelectorAll('ol.explain li[data-ex]').forEach(function(li){ notes[li.dataset.ex]=li; });
      var cur=null, hideT=0;
      function show(sup){
        clearTimeout(hideT); if(cur===sup&&!pop.hidden) return;
        var li=notes[sup.dataset.ex]; if(!li) return; cur=sup;
        pop.innerHTML='<div class="fi"><span class="n">'+sup.textContent+'</span><div class="t">'+li.innerHTML+'</div></div>';
        pop.hidden=false;
        pop.querySelectorAll('a').forEach(function(l){ l.target='_blank'; l.rel='noopener'; });
        var r=sup.getBoundingClientRect(), w=pop.offsetWidth, h=pop.offsetHeight, vw=document.documentElement.clientWidth;
        var left=Math.min(Math.max(12, r.left+r.width/2-w/2), vw-w-12);
        var top= r.top-h-10 >= 66 ? r.top-h-10 : r.bottom+10;
        pop.style.left=left+'px'; pop.style.top=top+'px';
        sup.setAttribute('aria-expanded','true');
      }
      function hide(){ if(cur) cur.setAttribute('aria-expanded','false'); pop.hidden=true; cur=null; }
      function later(){ clearTimeout(hideT); hideT=setTimeout(hide,220); }
      art.querySelectorAll('sup.ex[data-ex]').forEach(function(sup){
        if(!notes[sup.dataset.ex]) return;
        sup.tabIndex=0; sup.setAttribute('role','button');
        sup.setAttribute('aria-label','Objaśnienie '+sup.textContent); sup.setAttribute('aria-expanded','false');
        sup.addEventListener('pointerenter',function(e){ if(e.pointerType==='mouse') show(sup); });
        sup.addEventListener('pointerleave',function(e){ if(e.pointerType==='mouse') later(); });
        sup.addEventListener('focus',function(){ show(sup); });
        sup.addEventListener('blur',later);
        sup.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation(); if(cur===sup&&!pop.hidden&&e.pointerType!=='mouse') hide(); else show(sup); });
        sup.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); show(sup); } });
      });
      pop.addEventListener('pointerenter',function(){ clearTimeout(hideT); });
      pop.addEventListener('pointerleave',function(e){ if(e.pointerType==='mouse') later(); });
      pop.addEventListener('focusin',function(){ clearTimeout(hideT); });
      pop.addEventListener('focusout',later);
      document.addEventListener('click',function(e){ if(!pop.hidden&&!pop.contains(e.target)) hide(); });
      document.addEventListener('keydown',function(e){ if(e.key==='Escape') hide(); });
      window.addEventListener('scroll',function(){ if(!pop.hidden&&!pop.matches(':hover')) hide(); },{passive:true});
      window.addEventListener('resize',hide);
    })();
  </script>
  <script is:inline>
    // Znacznik czytania: czytelnik stawia znacznik w miejscu, w którym przerywa (pływający przycisk albo
    // przycisk w ramce „Przystanek”). Znacznik zapisuje się w tej przeglądarce (localStorage). Po powrocie
    // strona NIE przewija sama — u góry artykułu pojawia się pasek „Twój znacznik” z przyciskiem
    // „Przejdź do znacznika”, żeby można było najpierw przypomnieć sobie początek.
    (function(){
      var art=document.querySelector('.art'); if(!art) return;
      var wrap=art.querySelector('.wrap')||art;
      var store; try{ store=window.localStorage; store.setItem('wz-t','1'); store.removeItem('wz-t'); }catch(e){ return; }
      var KEY='wz-znacznik:'+location.pathname;
      var head=wrap.querySelector('header.top'), toc=wrap.querySelector('nav.wz-toc');
      var blocks=[].filter.call(wrap.children,function(el){ return el!==head && el!==toc && !/^(HR|STYLE|SCRIPT|FOOTER)$/.test(el.tagName); });
      if(blocks.length<5) return;
      var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ICON='<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h8v12l-4-3-4 3z"/></svg>';
      function snip(el){ return (el.textContent||'').replace(/\s+/g,' ').trim().slice(0,80); }
      function headOf(el){ for(var i=blocks.indexOf(el);i>=0;i--){ if(blocks[i].tagName==='H2') return blocks[i]; } return null; }
      function label(el){ var h=headOf(el); if(!h) return 'Początek tekstu'; var n=h.querySelector('.num'); var t=h.textContent.replace(n?n.textContent:'','').trim(); return (n?n.textContent.trim()+': ':'')+t; }
      function load(){ try{ var d=JSON.parse(store.getItem(KEY)||'null'); if(!d) return null;
        var el=blocks[d.i]; if(!el||snip(el)!==d.t){ el=null; for(var k=0;k<blocks.length;k++){ if(snip(blocks[k])===d.t){ el=blocks[k]; break; } } }
        return el?{el:el,d:d}:null; }catch(e){ return null; } }
      var mark=load();

      var bar=document.createElement('div'); bar.className='wz-bm-bar'; bar.hidden=true; bar.setAttribute('role','region'); bar.setAttribute('aria-label','Twój znacznik');
      bar.innerHTML=ICON+'<div class="tx"><span class="k">Twój znacznik</span><span class="c"></span></div><button type="button" class="go">Przejdź do znacznika</button><button type="button" class="rm">Usuń</button>';
      (toc||head) ? (toc||head).insertAdjacentElement('afterend',bar) : wrap.insertBefore(bar,wrap.firstChild);
      blocks=blocks.filter(function(b){ return b!==bar; });

      var fab=document.createElement('div'); fab.className='wz-bm';
      fab.innerHTML='<button type="button" class="go" hidden aria-label="Przejdź do znacznika">'+ICON+'<span class="lbl">Do znacznika</span></button><button type="button" class="set" aria-label="Postaw znacznik w tym miejscu">'+ICON+'<span class="lbl">Zaznacz miejsce</span></button>';
      document.body.appendChild(fab);
      var toast=document.createElement('div'); toast.className='wz-bm-toast'; toast.hidden=true; toast.setAttribute('role','status'); document.body.appendChild(toast);
      var tt=0; function say(t){ toast.textContent=t; toast.hidden=false; clearTimeout(tt); tt=setTimeout(function(){ toast.hidden=true; },3200); }

      function render(){
        art.querySelectorAll('.wz-marked').forEach(function(b){ b.classList.remove('wz-marked'); });
        art.querySelectorAll('.wz-toc li.mk').forEach(function(li){ li.classList.remove('mk'); });
        var goF=fab.querySelector('.go'), setF=fab.querySelector('.set .lbl');
        if(mark){ mark.el.classList.add('wz-marked'); bar.hidden=false; bar.querySelector('.c').textContent=mark.d.c; goF.hidden=false; setF.textContent='Przenieś znacznik';
          var h=headOf(mark.el); if(h&&h.id){ var li=art.querySelector('.wz-toc li[data-sec="'+h.id+'"]'); if(li) li.classList.add('mk'); } }
        else { bar.hidden=true; goF.hidden=true; setF.textContent='Zaznacz miejsce'; }
      }
      function topBlock(){ for(var i=0;i<blocks.length;i++){ if(blocks[i].getBoundingClientRect().bottom>110) return blocks[i]; } return blocks[blocks.length-1]; }
      function put(el){ var d={i:blocks.indexOf(el),t:snip(el),c:label(el),ts:Date.now()};
        try{ store.setItem(KEY,JSON.stringify(d)); }catch(e){ say('Nie udało się zapisać znacznika w tej przeglądarce.'); return; }
        mark={el:el,d:d}; render(); say('Znacznik zapisany w tej przeglądarce. Po powrocie znajdziesz go na górze artykułu.'); }
      function go(){ if(!mark) return; mark.el.scrollIntoView({behavior:reduce?'auto':'smooth',block:'start'});
        mark.el.classList.remove('wz-flash'); void mark.el.offsetWidth; mark.el.classList.add('wz-flash'); }
      fab.querySelector('.set').addEventListener('click',function(){ put(topBlock()); });
      fab.querySelector('.go').addEventListener('click',go);
      bar.querySelector('.go').addEventListener('click',go);
      bar.querySelector('.rm').addEventListener('click',function(){ try{ store.removeItem(KEY); }catch(e){} mark=null; render(); say('Znacznik usunięty.'); });
      art.querySelectorAll('.stop').forEach(function(st){
        var b=document.createElement('button'); b.type='button'; b.className='wz-bm-stop'; b.innerHTML=ICON+'Postaw tu znacznik';
        b.addEventListener('click',function(){ put(st); }); st.appendChild(b);
      });
      render();
    })();
  </script>
</Base>
