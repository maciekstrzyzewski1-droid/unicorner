<script is:inline>
const RAW = [
  // ZESTAW 1 — Rynek turystyczny (10)
  {set:0,q:"Rynek turystyczny to...",opts:["Miejsce, w którym sprzedaje się wyłącznie wycieczki zagraniczne","Ogół relacji między nabywcami zgłaszającymi popyt a sprzedawcami tworzącymi podaż","Zbiór biur podróży działających w danym kraju","Lista atrakcji turystycznych regionu"],ans:1,exp:"Rynek to system współzależnych transakcji kupna i sprzedaży — relacje między popytem (nabywcy) a podażą (sprzedawcy)."},
  {set:0,q:"Ujęcie podmiotowe rynku usług turystycznych to...",opts:["Zbiór nabywców i wytwórców usług dokonujących transakcji","Proces ustalania, co kupić i sprzedać","Zestaw walorów i atrakcji obszaru","Cena i jakość produktu turystycznego"],ans:0,exp:"Podmiotowe = kto (zbiór nabywców i wytwórców). Przedmiotowe = proces ustalania warunków transakcji."},
  {set:0,q:"Którą cechę ma rynek usług turystycznych?",opts:["Przewagę dóbr materialnych nad usługami","Konsumpcję wyłącznie po powrocie z podróży","Konsumpcję w miejscu podaży, równocześnie z produkcją usługi","Brak popytu łącznego"],ans:2,exp:"Usługa turystyczna jest konsumowana tam, gdzie jest wytwarzana i w tym samym czasie. Dominują usługi, a popyt jest łączny."},
  {set:0,q:"Do struktury przedmiotowej rynku turystycznego należą...",opts:["Nabywcy indywidualni i instytucjonalni","Organy polityki turystycznej","Popyt, podaż/produkt, cena i jakość produktu","JST i organizacje branżowe"],ans:2,exp:"Struktura przedmiotowa = elementy transakcji: popyt turystyczny, podaż/produkt, cena i jakość. Podmioty to struktura podmiotowa."},
  {set:0,q:"Który element NIE jest subrynkiem rynku turystycznego?",opts:["Rynek dóbr turystycznych","Rynek usług turystycznych","Rynek środków i warunków do uprawiania turystyki","Rynek pracy sezonowej"],ans:3,exp:"Rynek turystyczny tworzą trzy subrynki: dóbr, usług oraz środków i warunków do uprawiania turystyki."},
  {set:0,q:"Konkurencja doskonała charakteryzuje się...",opts:["Jednym producentem i brakiem substytutów","Dużą liczbą producentów, produktem standardowym i brakiem kontroli nad ceną","Kilkoma firmami silnie współzależnymi","Znacznym naciskiem na reklamę i markę"],ans:1,exp:"Konkurencja doskonała: dużo firm, produkt standardowy, żadna firma nie kontroluje ceny, bardzo łatwe wejście na rynek."},
  {set:0,q:"Monopol to model rynku, w którym...",opts:["Jest wielu producentów z produktem zróżnicowanym","Kilku producentów kontroluje się wzajemnie","Jest jeden producent, brak bliskich substytutów i znaczna kontrola ceny","Wejście na rynek jest bardzo łatwe"],ans:2,exp:"Monopol: jeden producent, produkt niepowtarzalny, brak bliskich substytutów, znaczna kontrola ceny, bardzo trudne wejście (np. wodociągi)."},
  {set:0,q:"Rynek turystyczny najlepiej opisują modele...",opts:["Wyłącznie konkurencji doskonałej","Konkurencji monopolistycznej i oligopolu (wysoka, lecz ograniczona konkurencyjność)","Wyłącznie czystego monopolu","Braku jakiejkolwiek konkurencji"],ans:1,exp:"Rynek turystyczny ma wysoki, ale nieraz ograniczony poziom konkurencyjności — łączy cechy konkurencji monopolistycznej, oligopolu i (niejednoznacznego) monopolu."},
  {set:0,q:"Koopetycja to...",opts:["Walka o rynek z konkurentem","Umiejętność konkurowania","Współkonkurowanie — jednoczesna konkurencja i współpraca","Całkowita rezygnacja z konkurencji"],ans:2,exp:"Koopetycja = koalicja słów kooperacja + konkurencja: podmioty jednocześnie konkurują i współpracują."},
  {set:0,q:"Który element należy do polityki konkurencji?",opts:["Liberalizacja, deregulacja i prywatyzacja","Zwiększanie barier wejścia na rynek","Centralizacja decyzji gospodarczych","Ograniczanie swobody działalności gospodarczej"],ans:0,exp:"Polityka konkurencji obejmuje m.in. liberalizację (znoszenie barier), decentralizację, restrukturyzację i prywatyzację oraz deregulację — chroni konkurencję i konsumenta."},

  // ZESTAW 2 — Produkt turystyczny (10)
  {set:1,q:"Produkt turystyczny w ujęciu wąskim (sensu stricte) to...",opts:["Kompozycja tego, co turyści robią, plus sfera ich wrażeń","Wszystko to, co turyści kupują oddzielnie lub w formie pakietu","Wyłącznie walory przyrodnicze obszaru","Tylko usługa noclegowa"],ans:1,exp:"Sensu stricte = to, co turysta kupuje (osobno lub w pakiecie): konferencja, wycieczka, pobyt w uzdrowisku. Sensu largo dokłada wrażenia i odczucia."},
  {set:1,q:"Impreza turystyczna to...",opts:["Pojedyncza usługa hotelarska","Co najmniej dwie usługi tworzące jednolity program, objęte wspólną ceną","Dobro materialne typu mapa lub przewodnik","Region zdeterminowany geograficznie"],ans:1,exp:"Impreza = pakiet: co najmniej dwie usługi, wspólny program i wspólna cena, jeśli obejmują nocleg lub trwają ponad 24 h."},
  {set:1,q:"Który rodzaj produktu turystycznego ma charakter punktowy — jedna główna atrakcja w jednym miejscu?",opts:["Szlak","Obszar","Obiekt","Impreza"],ans:2,exp:"OBIEKT — jedna główna atrakcja i kilka usług towarzyszących w jednym miejscu (muzeum, hotel, hala, jaskinia)."},
  {set:1,q:"Szlak jako rodzaj produktu turystycznego to...",opts:["Pojedyncza usługa transportowa","Miejsca/obiekty połączone wytyczoną trasą i infrastrukturą wzdłuż niej","Dobro materialne sprzedawane turyście","Wydarzenie o charakterze cyklicznym"],ans:1,exp:"SZLAK = szereg miejsc lub obiektów połączonych nadrzędną ideą i oznakowaną trasą (pieszą, rowerową, wodną) oraz infrastrukturą wzdłuż niej."},
  {set:1,q:"Rdzeń produktu turystycznego to...",opts:["Podstawowe elementy pakietu (posiłki, noclegi, przejazdy)","Dodatki wyróżniające ofertę na tle konkurencji","Niematerialna, podstawowa potrzeba turysty decydująca o wyborze","Materialne opakowanie usługi"],ans:2,exp:"Rdzeń ma charakter niematerialny — to podstawowa potrzeba (poznania, zadowolenia), która ostatecznie decyduje o wyborze."},
  {set:1,q:"Produkt poszerzony (powiększony) to...",opts:["Sama istota potrzeby turysty","Podstawowe elementy umożliwiające realizację produktu","Dodatkowe świadczenia, które wyróżniają ofertę i czynią ją atrakcyjniejszą","Potencjalne elementy przyszłej oferty"],ans:2,exp:"Produkt poszerzony = dodatki wyróżniające ofertę (np. pobyt w gospodarstwie ekoturystycznym z nauką robienia przetworów)."},
  {set:1,q:"Produkt potencjalny dotyczy strony...",opts:["Konsumenta (jego oczekiwań)","Producenta — elementów, które w przyszłości mogą wejść do oferty","Pośrednika finansowego","Organów polityki turystycznej"],ans:1,exp:"Produkt potencjalny to wymiar od strony producenta — elementy, które obecnie (z przyczyn ekonomicznych, technologicznych) jeszcze nie są w ofercie."},
  {set:1,q:"Produkt psychologiczny to...",opts:["Zbiór cech oczekiwanych przez nabywcę przed zakupem","Wszystko, co pozostaje w pamięci klienta od pierwszego kontaktu po konsumpcję","Rdzeń niematerialnej potrzeby","Materialny element pakietu"],ans:1,exp:"Produkt psychologiczny (strona konsumenta) = to, co zostaje w świadomości i pamięci klienta. Oczekiwany = czego oczekuje przed zakupem."},
  {set:1,q:"Która cecha jest typowa dla produktu turystycznego?",opts:["Można go magazynować na zapas","Jest trwały i niezależny od miejsca","Jest nietrwały i nie może być magazynowany (można go tylko rezerwować)","Jest w pełni standaryzowalny"],ans:2,exp:"Produkt turystyczny jest nietrwały, nie da się go magazynować (tylko rezerwować), a brak standaryzacji sprawia, że o jakości decyduje sposób świadczenia usługi."},
  {set:1,q:"Zintegrowany produkt turystyczny to...",opts:["Pojedyncza impreza jednego touroperatora","Oferta obszaru tworzona wspólnie przez podmioty gospodarki turystycznej, JST i organizacje turystyczne","Wyłącznie dobro materialne","Produkt sprzedawany bez udziału samorządu"],ans:1,exp:"Zintegrowany produkt turystyczny to oferta obszaru kreowana we współpracy usługodawców, JST i organizacji turystycznych (np. lokalnych i regionalnych organizacji turystycznych)."},

  // ZESTAW 3 — Podaż turystyczna (8)
  {set:2,q:"Podaż turystyczna to...",opts:["Wielkość zapotrzebowania turystów na dobra i usługi","Wolumen dóbr i usług oferowany turystom przy danej cenie i w danym okresie","Suma wydatków turystów zagranicznych","Liczba przyjazdów do kraju"],ans:1,exp:"Podaż = to, co jest oferowane na sprzedaż (wolumen dóbr i usług produktu turystycznego) przy danej cenie i w danym okresie."},
  {set:2,q:"Podaż pierwotna obejmuje...",opts:["Hotelarstwo i gastronomię","Biura podróży i pośrednictwo","Warunki naturalne, środowisko społeczno-kulturowe i infrastrukturę ogólną","Wypożyczalnie sprzętu i parki rozrywki"],ans:2,exp:"Podaż pierwotna: walory naturalne (plaża, góry), środowisko społeczno-kulturowe (zabytki, tradycje) i infrastruktura ogólna (transport, gosp. komunalne)."},
  {set:2,q:"Podaż wtórna to...",opts:["Naturalne walory turystyczne","Infrastruktura turystyczna: hotelarstwo, gastronomia, organizacja podróży","Środowisko kulturowe obszaru","Klimat i ukształtowanie terenu"],ans:1,exp:"Podaż wtórna = urządzenia i instytucje infrastruktury turystycznej: hotelarstwo, urządzenia wypoczynkowe, gastronomia, pośrednictwo i organizacja podróży."},
  {set:2,q:"Która cecha jest typowa dla podaży turystycznej?",opts:["Niski udział kosztów stałych","Pełna elastyczność przestrzenna","Sztywność przestrzenna i sezonowość","Całkowita niezależność od innych sektorów gospodarki"],ans:2,exp:"Podaż jest sztywna przestrzennie (o lokalizacji decydują walory), sezonowa, ma duży udział kosztów stałych i zależy od sytuacji gospodarczej i innych sektorów."},
  {set:2,q:"Syntetycznym miernikiem podaży turystycznej jest...",opts:["Liczba przyjazdów turystów","Atrakcyjność turystyczna","Stopa bezrobocia w regionie","Saldo bilansu płatniczego"],ans:1,exp:"Atrakcyjność turystyczna = suma ocen elementów podaży: walory, zagospodarowanie (baza noclegowa, gastronomiczna, uzupełniająca), dostępność, stan środowiska."},
  {set:2,q:"Sztywność przestrzenna podaży turystycznej oznacza, że...",opts:["Ceny nie zmieniają się w czasie","O lokalizacji decyduje występowanie walorów, a turysta musi się do nich przemieścić","Podaż jest taka sama w każdym kraju","Nie można jej rezerwować"],ans:1,exp:"Podaż jest przywiązana do miejsca występowania walorów i obiektów — to turysta przemieszcza się do produktu, a nie odwrotnie."},
  {set:2,q:"Obszar recepcji turystycznej jako punkt widzenia podaży to układ...",opts:["Wyłącznie bazy noclegowej","Atrakcji i środowiska, infrastruktury i usług oraz dostępności miejsca docelowego","Tylko biur podróży","Wyłącznie transportu lotniczego"],ans:1,exp:"Z perspektywy obszaru recepcji podaż to układ: atrakcje i środowisko, infrastruktura i usługi, dostępność miejsca docelowego."},
  {set:2,q:"Do mierników podaży turystycznej NIE zalicza się bezpośrednio...",opts:["Liczby miejsc noclegowych","Liczby walorów przyrodniczych i kulturowych","Gęstości i jakości sieci transportowej","Kursu waluty krajowej"],ans:3,exp:"Mierniki podaży dotyczą walorów, bazy noclegowej, transportu i bazy uzupełniającej. Kurs waluty nie jest miernikiem podaży turystycznej."},

  // ZESTAW 4 — Turystyka międzynarodowa (9)
  {set:3,q:"Definicja turystyki międzynarodowej różni się od ogólnej definicji turystyki tym, że dodaje określenie...",opts:["Dłużej niż rok","Poza krajem stałego zamieszkania","Wyłącznie w celach służbowych","Krócej niż 24 godziny"],ans:1,exp:"Turystyka międzynarodowa = ta sama definicja co turystyka, ale z dodaniem warunku wyjazdu poza kraj stałego zamieszkania (24 h – 1 rok)."},
  {set:3,q:"Turystyka przyjazdowa (incoming) obejmuje...",opts:["Wyjazdy obywateli danego kraju za granicę","Przyjazdy zagranicznych turystów do kraju","Podróże krajowe w obrębie jednego państwa","Wyłącznie podróże służbowe"],ans:1,exp:"Incoming = przyjazdy cudzoziemców do kraju. Outgoing = wyjazdy obywateli za granicę."},
  {set:3,q:"Eksport turystyczny to...",opts:["Zakup produktu turystycznego za granicą przez turystów krajowych","Suma wydatków turystów zagranicznych na terenie danego państwa","Wywóz pamiątek przez turystów","Sprzedaż biletów lotniczych za granicę"],ans:1,exp:"Eksport turystyczny = sprzedaż produktu i innych dóbr/usług cudzoziemcom w czasie ich wizyty, czyli suma wydatków turystów zagranicznych w danym kraju."},
  {set:3,q:"Import turystyczny to...",opts:["Wydatki turystów krajowych na terenie krajów odwiedzanych","Przychody kraju od turystów zagranicznych","Liczba przyjazdów cudzoziemców","Zakup usług turystycznych przez cudzoziemców w naszym kraju"],ans:0,exp:"Import turystyczny = zakup produktu za granicą przez turystów krajowych, czyli ich wydatki w krajach, które odwiedzają."},
  {set:3,q:"Bezpośredni wpływ turystyki na PKB to...",opts:["Efekt drugiej fali w łańcuchu dostaw","Wartość dodana branż mających bezpośredni kontakt z turystą","Wydatki rządu na promocję turystyki","Wpływ turystyki na kurs waluty"],ans:1,exp:"Bezpośredni: zakwaterowanie, gastronomia, transport pasażerski, atrakcje — pieniądze płyną wprost od turysty do usługodawcy."},
  {set:3,q:"Pośredni wpływ turystyki na PKB (efekt drugiej fali) polega na tym, że...",opts:["Turysta płaci bezpośrednio w hotelu","Pieniądze turysty pracują dalej w łańcuchu dostaw (hotel kupuje od rolnika)","Rząd dotuje linie lotnicze","Turystyka nie wpływa na inne branże"],ans:1,exp:"Pośredni: wydatki turysty w hotelu trafiają do dostawców i kooperantów (rolnictwo, agencje reklamowe, pralnie) — turystyka napędza inne sektory."},
  {set:3,q:"Który wskaźnik UNWTO NIE obejmuje kosztów transportu między krajami?",opts:["Liczba przyjazdów turystycznych","Przychody z turystyki międzynarodowej (receipts)","Liczba miejsc noclegowych","Powierzchnia obszarów chronionych"],ans:1,exp:"Przychody z turystyki międzynarodowej obejmują wyżywienie, nocleg, zakupy i rozrywkę, ale NIE koszty transportu między krajami."},
  {set:3,q:"Monokultura turystyczna to kraj/terytorium, w którym...",opts:["Turystyka jest zakazana","Udział turystyki w PKB jest bardzo wysoki, często ponad 40%","Nie ma żadnych walorów turystycznych","Turyści przyjeżdżają tylko zimą"],ans:1,exp:"Monokultury turystyczne (np. Antigua i Barbuda 78,5%, Aruba 78%, Malediwy 63,4%) mają gospodarkę ukierunkowaną na eksport usług turystycznych."},
  {set:3,q:"Który z poniższych to nowy trend w turystyce?",opts:["Turystyka regeneratywna i gastroturystyka","Wyłącznie turystyka masowa","Rezygnacja z autentyczności","Powrót do biur stacjonarnych zamiast online"],ans:0,exp:"Nowe trendy: gastroturystyka, city hopping, turystyka zrównoważona i regeneratywna, autentyczność, indywidualizm, storytelling."},

  // ZESTAW 5 — Gospodarka turystyczna (7)
  {set:4,q:"Gospodarka turystyczna to...",opts:["Samodzielny sektor gospodarki narodowej","Element gospodarki narodowej (głównie usług) zaspokajający potrzeby turystyczne","Wyłącznie działalność biur podróży","Rynek pracy w hotelarstwie"],ans:1,exp:"Gospodarka turystyczna nie jest samodzielnym sektorem — obejmuje te fragmenty gospodarki narodowej, które tworzą dobra i usługi na rzecz turystyki."},
  {set:4,q:"Bezpośrednia gospodarka turystyczna dzieli się na...",opts:["Krajową i zagraniczną","Typową i uzupełniającą","Publiczną i prywatną","Sezonową i całoroczną"],ans:1,exp:"Bezpośrednia gospodarka turystyczna obejmuje część typową (typowe przedsiębiorstwa turystyczne) i uzupełniającą (podmioty spoza branży działające na rzecz turystyki)."},
  {set:4,q:"Do typowej gospodarki turystycznej należy...",opts:["Bankowość i telekomunikacja","Hotelarstwo, biura podróży i transport pasażerski turystyczny","Produkcja kosmetyków","Ochrona środowiska"],ans:1,exp:"Typowa gospodarka turystyczna: hotelarstwo, gastronomia w obiektach noclegowych, transport turystyczny, biura podróży, udostępnianie walorów, organizacje turystyczne."},
  {set:4,q:"Uzupełniająca gospodarka turystyczna obejmuje np...",opts:["Bankowość i pocztę","Produkcję pamiątek i map, ubezpieczenia turystyczne","Wyłącznie hotelarstwo","Gospodarkę komunalną"],ans:1,exp:"Uzupełniająca (wciąż bezpośrednia): produkcja pamiątek, map, sprzętu; ubezpieczenia turystyczne; usługi finansowe dla turystów; obiekty kultury i sportu; działania JST."},
  {set:4,q:"Pośrednia gospodarka turystyczna to...",opts:["Typowe biura podróży","Bankowość, handel, telekomunikacja — zaspokajające też potrzeby turystów","Wyłącznie hotelarstwo i gastronomia","Organizacje turystyczne"],ans:1,exp:"Pośrednia (nietypowa) gospodarka turystyczna: bankowość, ubezpieczenia, transport, poczta, handel, produkcja — realizując potrzeby mieszkańców, obsługuje też turystów."},
  {set:4,q:"Według W.W. Gaworeckiego gospodarka turystyczna i przemysł turystyczny to...",opts:["Dwa różne, wykluczające się pojęcia","Synonimy","Pojęcia dotyczące różnych krajów","Terminy odnoszące się tylko do transportu"],ans:1,exp:"Wg Gaworeckiego gospodarkę turystyczną i przemysł turystyczny można traktować jako synonimy."},
  {set:4,q:"Biznes turystyczny należy utożsamiać z...",opts:["Pośrednią gospodarką turystyczną","Bezpośrednią gospodarką turystyczną — przedsiębiorstwami branży typowo turystycznej","Gospodarką komunalną","Wyłącznie sektorem publicznym"],ans:1,exp:"Biznes turystyczny = bezpośrednia gospodarka turystyczna, czyli przedsiębiorstwa działające w branży typowo turystycznej."}
];

const SETS = [
  {name:"Zestaw 1 – Rynek turystyczny",range:[0,10]},
  {name:"Zestaw 2 – Produkt turystyczny",range:[10,20]},
  {name:"Zestaw 3 – Podaż turystyczna",range:[20,28]},
  {name:"Zestaw 4 – Turystyka międzynarodowa",range:[28,37]},
  {name:"Zestaw 5 – Gospodarka turystyczna",range:[37,44]},
  {name:"Wszystkie (44 pytania)",range:[0,44]},
];
// Tasowanie opcji – zwraca {opts, ans} z pomieszaną kolejnością
function shuffle(q){
  const idxs=[0,1,2,3];
  for(let i=idxs.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idxs[i],idxs[j]]=[idxs[j],idxs[i]];}
  const newOpts=idxs.map(i=>q.opts[i]);
  const newAns=idxs.indexOf(q.ans);
  return{opts:newOpts,ans:newAns};
}

let activeSet=null; // null = wybór zestawu
let questions=[];
let shuffled=[];
let current=0,score=0,answered=[];

function switchTab(id,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
  if(id==='quiz')renderSetPicker();
}

function startSet(si){
  const s=SETS[si];
  questions=RAW.slice(s.range[0],s.range[1]);
  shuffled=questions.map(q=>shuffle(q));
  current=0;score=0;answered=new Array(questions.length).fill(null);
  activeSet=si;
  renderQuiz();
}

function renderSetPicker(){
  activeSet=null;
  const c=document.getElementById('quiz-container');
  c.innerHTML=`<div class="card"><div class="card-label">Wybierz zestaw pytań</div><div class="card-title" style="font-size:1.1rem;margin-bottom:1rem">Z czego chcesz się teraz pouczyć?</div>`+
  SETS.map((s,i)=>`<button class="opt" style="margin-bottom:6px" onclick="startSet(${i})">${s.name}</button>`).join('')+`</div>`;
}

function renderQuiz(){
  const c=document.getElementById('quiz-container');
  if(current>=questions.length){
    const pct=Math.round(score/questions.length*100);
    c.innerHTML=`<div class="card" style="text-align:center;padding:2.5rem">
      <div class="card-label">${SETS[activeSet].name}</div>
      <div class="score-big">${score}/${questions.length}</div>
      <div class="card-body" style="margin-bottom:1.5rem">
        ${pct>=80?'✅ Solidna znajomość materiału.':pct>=60?'⚠️ Kilka rzeczy warto powtórzyć.':'❌ Wróć do notatek i spróbuj ponownie.'}
        <br><span style="color:var(--ink-light)">${pct}% poprawnych odpowiedzi</span>
      </div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
        <button class="nav-btn primary" onclick="startSet(${activeSet})">Powtórz zestaw</button>
        <button class="nav-btn" onclick="renderSetPicker()">← Zmień zestaw</button>
      </div>
    </div>`;
    return;
  }
  const q=questions[current];
  const sh=shuffled[current];
  const isAnswered=answered[current]!==null;
  const pct=Math.round((current/questions.length)*100);
  c.innerHTML=`
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
    <div style="margin-bottom:.5rem"><button class="nav-btn" style="font-size:11px;padding:4px 12px" onclick="renderSetPicker()">← Zestawy</button></div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;margin-bottom:1rem">
        <span class="card-label">${SETS[activeSet].name.split('–')[1]||SETS[activeSet].name} · pytanie ${current+1}/${questions.length}</span>
        <span class="card-label">Wynik: ${score} pkt</span>
      </div>
      <div class="quiz-q">${q.q}</div>
      <div class="quiz-opts">
        ${sh.opts.map((o,i)=>{
          let cls='opt';
          if(isAnswered){if(i===sh.ans)cls+=' correct';else if(i===answered[current]&&i!==sh.ans)cls+=' wrong';}
          const oc=isAnswered?'':` onclick="pickAnswer(${i})"`;
          return `<button class="${cls}"${oc}>${o}</button>`;
        }).join('')}
      </div>
      ${isAnswered?`<div class="quiz-feedback ${answered[current]===sh.ans?'ok':'fail'}">${answered[current]===sh.ans?'✅':'❌'} ${q.exp}</div>`:''}
      <div class="quiz-nav">
        <span class="quiz-counter">${current+1} / ${questions.length}</span>
        ${current>0?`<button class="nav-btn" onclick="prevQ()">← Wstecz</button>`:''}
        ${isAnswered&&current<questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Dalej →</button>`:''}
        ${isAnswered&&current===questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Pokaż wynik</button>`:''}
      </div>
    </div>`;
}

function pickAnswer(i){
  if(answered[current]!==null)return;
  answered[current]=i;
  if(i===shuffled[current].ans)score++;
  renderQuiz();
}
function nextQ(){current++;renderQuiz();}
function prevQ(){if(current>0){current--;renderQuiz();}}

// inicjalizacja
document.addEventListener('DOMContentLoaded',()=>{
  const quizTab=document.querySelector('.tab[onclick*="quiz"]');
  if(quizTab) quizTab.addEventListener('click',renderSetPicker);
});
</script>

</Base>
