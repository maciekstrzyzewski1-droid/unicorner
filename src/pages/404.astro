---
// Strona błędu 404. GitHub Pages pokazuje dist/404.html pod KAŻDYM nieistniejącym adresem (także /x/y/z),
// więc wszystkie linki i zasoby są absolutne (/…). Bez canonical i poza sitemapą ('404' w SKIP w sitemap.xml.js).
import Base from '../layouts/Base.astro';
const title = 'Nie ma takiej strony · Unicorner';
const description = 'Pod tym adresem nie ma strony Unicornera.';
const cele = [
  { href: '/index.html#przedmioty', nazwa: 'Przedmioty', opis: 'kursy, fiszki i quizy do egzaminów' },
  { href: '/wiedza.html', nazwa: 'Wiedza', opis: 'artykuły oparte na faktach' },
  { href: '/jezyki.html', nazwa: 'Języki obce', opis: 'lekcje krok po kroku' },
];
---

<Base title={title} description={description}>
<meta slot="head" name="robots" content="noindex" />
<style is:inline>
  :root{
    --ink2:#0d0c13; --line:rgba(255,255,255,.09); --line2:rgba(255,255,255,.16);
    --text:#ece9f7; --fiolet:#bd8bff; --fiolet-zgaszony:#4c2a86;
    --mono:'Chakra Petch','Space Grotesk',ui-monospace,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    background:#050505; color:var(--text); min-height:100vh; line-height:1.6;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  a{color:inherit; text-decoration:none;}
  .lwrap{max-width:720px; margin:0 auto; padding:0 22px 72px;}

  header.ltop{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:22px 0 8px;}
  .brand{display:flex; align-items:center; gap:10px;}
  .horn{width:24px; height:24px; flex-shrink:0;}
  .horn .seg{fill:url(#irisGrad);}
  .wordmark{font-family:var(--mono); font-weight:700; font-size:1.2rem; letter-spacing:.3px;}
  .back{font-family:var(--mono); font-size:.8rem; font-weight:600; color:var(--muted); border:1px solid var(--line); background:var(--ink2); padding:7px 13px; border-radius:999px; transition:color .2s, border-color .2s;}
  .back:hover{color:var(--text); border-color:var(--line2);}

  /* Neon „404”: kontur rurek w fiolecie z poświatą; środkowe zero gaśnie raz po wczytaniu jak przepalona rurka */
  .neon{display:flex; font-family:var(--mono); font-weight:700; font-size:clamp(6.5rem,31vw,11.5rem); line-height:.95;
    letter-spacing:-.02em; color:transparent; -webkit-text-stroke:2px var(--fiolet);
    text-shadow:0 0 14px rgba(189,139,255,.55), 0 0 40px rgba(189,139,255,.22); margin:40px 0 18px; user-select:none;}
  .neon .zgaslo{-webkit-text-stroke-color:var(--fiolet-zgaszony); text-shadow:none; animation:gasnie 1.6s steps(1,end) .5s both;}
  @keyframes gasnie{
    0%{-webkit-text-stroke-color:var(--fiolet); text-shadow:0 0 14px rgba(189,139,255,.55), 0 0 40px rgba(189,139,255,.22);}
    18%{-webkit-text-stroke-color:var(--fiolet-zgaszony); text-shadow:none;}
    26%{-webkit-text-stroke-color:var(--fiolet); text-shadow:0 0 14px rgba(189,139,255,.55);}
    40%{-webkit-text-stroke-color:var(--fiolet-zgaszony); text-shadow:none;}
    48%{-webkit-text-stroke-color:var(--fiolet); text-shadow:0 0 10px rgba(189,139,255,.4);}
    60%,100%{-webkit-text-stroke-color:var(--fiolet-zgaszony); text-shadow:none;}
  }
  @media (prefers-reduced-motion:reduce){ .neon .zgaslo{animation:none;} }

  h1{font-family:var(--mono); font-weight:700; font-size:clamp(1.6rem,4.6vw,2.2rem); line-height:1.15; letter-spacing:-.4px; margin-bottom:10px;}
  .lede{color:var(--muted); font-size:1rem; max-width:34em;}
  /* --muted (7,15:1 na #050505), nie --muted2 (3,96:1, poniżej WCAG AA 4,5:1 dla małego tekstu) */
  .adres{margin-top:16px; font-family:var(--mono); font-size:.85rem; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .adres[hidden]{display:none;}
  .adres b{color:var(--fiolet); font-weight:600;}

  .dalej{margin-top:40px;}
  .dalej h2{font-family:var(--mono); font-size:.95rem; font-weight:600; color:var(--muted); margin-bottom:6px;}
  .cele{list-style:none; border-top:1px solid var(--line);}
  .cele a{display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:15px 2px; border-bottom:1px solid var(--line); transition:color .2s;}
  .cele .n{font-family:var(--mono); font-weight:700; font-size:1.08rem; color:var(--text); transition:color .2s;}
  .cele .o{color:var(--muted); font-size:.88rem; text-align:right;}
  .cele a:hover .n{color:var(--fiolet);}
  .zglos{margin-top:26px; font-size:.92rem; color:var(--muted);}
  .zglos a{color:var(--fiolet); border-bottom:1px dashed rgba(189,139,255,.45);}

  .lfoot{margin-top:48px; padding-top:18px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:14px; justify-content:space-between; align-items:center; font-family:var(--mono); font-size:.78rem; color:var(--muted);}
  .lfoot .fnav{display:flex; gap:16px; flex-wrap:wrap;}
  .lfoot a{color:var(--muted);}
  .lfoot a:hover{color:var(--text);}
  @media (max-width:480px){ .cele a{flex-direction:column; gap:2px;} .cele .o{text-align:left;} }
</style>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#6d28d9"/><stop offset=".4" stop-color="#a78bfa"/><stop offset=".72" stop-color="#bd8bff"/><stop offset="1" stop-color="#efe6ff"/>
  </linearGradient>
</defs></svg>
<div class="lwrap">
  <header class="ltop">
    <a class="brand" href="/index.html" aria-label="Unicorner — strona główna">
      <svg class="horn" viewBox="0 0 24 24" aria-hidden="true"><path class="seg" d="M12 1 L15 22 H9 Z"/></svg>
      <span class="wordmark">unicorner</span>
    </a>
    <a class="back" href="/index.html">← Strona główna</a>
  </header>
  <main id="main">
    <p class="neon" aria-hidden="true"><span>4</span><span class="zgaslo">0</span><span>4</span></p>
    <h1>Tej strony tu nie ma</h1>
    <p class="lede">Adres mógł się zmienić albo w linku jest literówka. Sprawdź go albo wybierz, dokąd iść dalej.</p>
    <p class="adres" id="adres" hidden>&gt; unicorner.pl<b id="sciezka"></b></p>

    <nav class="dalej" aria-labelledby="dalej-h">
      <h2 id="dalej-h">Dokąd dalej</h2>
      <ul class="cele">
        {cele.map((c) => (
          <li><a href={c.href}><span class="n">{c.nazwa}</span><span class="o">{c.opis}</span></a></li>
        ))}
      </ul>
    </nav>
    <p class="zglos">Ten adres był w linku na naszej stronie? <a href="/kontakt.html">Daj znać, gdzie</a>, a poprawimy go.</p>
  </main>
  <div class="lfoot">
    <div class="fnav">
      <a href="/index.html">Strona główna</a>
      <a href="/regulamin.html">Regulamin</a>
      <a href="/prywatnosc.html">Polityka prywatności</a>
    </div>
    <span>© 2026 Unicorner</span>
  </div>
</div>
<script is:inline>
  // Pokazuje adres, pod który ktoś wszedł (tylko jako tekst — textContent, bez wstawiania HTML).
  (function(){
    var el = document.getElementById('sciezka'), wiersz = document.getElementById('adres');
    if (!el || !wiersz) return;
    var p = location.pathname;
    try { p = decodeURIComponent(p); } catch (e) {}
    el.textContent = p;
    wiersz.hidden = false;
  })();
</script>
</Base>
