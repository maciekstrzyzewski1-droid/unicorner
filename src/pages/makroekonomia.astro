<style is:inline>
/* ===== KWADRACIK ZAMIAST NUMERU (ostatnie zadania) — w kolorach przycisku „Zostaw opinię" ===== */
.acc-num.acc-sq{background:linear-gradient(115deg,#27e8ff 0%,#a78bfa 38%,#ff2e97 72%,#ffd84a 100%);border-radius:4px;box-shadow:0 2px 11px rgba(167,139,250,.45),inset 0 0 0 1px rgba(255,255,255,.12);}

/* ===== INTERAKTYWNE WYKRESY MAKRO (krok po kroku: szok → reakcja, opis + rzut na obie osie) ===== */
.econ-fig{position:relative;margin:14px 0 4px;background:#0a0818;border:1px solid var(--border2);border-radius:4px;padding:12px 12px 4px;outline:none;}
.econ-fig svg{display:block;width:100%;height:auto;max-width:440px;margin:0 auto;overflow:visible;}
.econ-fig .axis{stroke:#6f679a;stroke-width:1.4;}
.econ-fig .ax-lbl{fill:var(--muted);font:600 9.5px 'Chakra Petch','Inter',sans-serif;letter-spacing:.2px;}
.econ-fig .curve{fill:none;stroke-width:2.6;stroke-linecap:round;}
.econ-fig .c-ad{stroke:#27e8ff;}
.econ-fig .c-sras{stroke:#ff2e97;}
.econ-fig .c-lras{stroke:#a78bfa;}
.econ-fig .c-ae{stroke:#27e8ff;}
.econ-fig .c-45{stroke:#6f679a;stroke-width:1.5;stroke-dasharray:5 4;}
.econ-fig .curve-lbl{font:700 11px 'Chakra Petch','Inter',sans-serif;}
.econ-fig .e-dot{fill:#ffd84a;stroke:#0a0818;stroke-width:1.5;}
.econ-fig .e-lbl{fill:#ffd84a;font:800 11px 'Chakra Petch','Inter',sans-serif;}
.econ-fig .ghost,.econ-fig .ghost2{opacity:0;stroke-dasharray:5 5;stroke-width:2;transition:opacity .5s ease;}
.econ-fig .mv{transition:transform .65s cubic-bezier(.45,.05,.2,1);}
.econ-fig .gA,.econ-fig .gB,.econ-fig .eqB,.econ-fig .arrow{opacity:0;transition:opacity .5s ease;}
.econ-fig .guide2{stroke:#ffd84a;stroke-width:1.2;stroke-dasharray:3 3;}
.econ-fig .gmark{fill:#ffd84a;font:800 8.5px 'Chakra Petch',sans-serif;}
.econ-fig .arrow line{stroke:#ffd84a;stroke-width:2.2;}
.econ-fig .arrow polygon{fill:#ffd84a;stroke:none;}
.econ-fig .arr-lbl{font:800 9px 'Chakra Petch',sans-serif;fill:#ffd84a;}
.econ-fig .arrow.fix line{stroke:#5ad1a0;}
.econ-fig .arrow.fix polygon{fill:#5ad1a0;}
.econ-fig .arrow.fix .arr-lbl{fill:#5ad1a0;}
.econ-fig .eqA{transition:opacity .5s ease;}
.econ-fig .fig-cap{font-size:.85rem;line-height:1.5;margin:10px 2px 6px;border-left:3px solid;padding:8px 12px;border-radius:0 6px 6px 0;display:none;}
.econ-fig .fig-cap b{color:#fff;}
.econ-fig .fig-cap.c0{border-color:#a78bfa;background:rgba(167,139,250,.08);color:#d8d3ee;}
.econ-fig .fig-cap.c1{border-color:#ff2e97;background:rgba(255,46,151,.09);color:#f6dbe8;}
.econ-fig .fig-cap.c2{border-color:#5ad1a0;background:rgba(90,209,160,.10);color:#d8f3e8;}
/* pasek sterowania etapami (krok po kroku) */
.econ-fig .fig-steps{display:flex;align-items:center;gap:10px;margin:8px 2px 4px;flex-wrap:wrap;}
.econ-fig .fig-btn{font:700 .72rem 'Chakra Petch',sans-serif;letter-spacing:.3px;color:var(--text);background:var(--surface);border:1px solid var(--border2);border-radius:4px;padding:5px 11px;cursor:pointer;transition:border-color .2s,color .2s,opacity .2s;}
.econ-fig .fig-btn:hover:not(:disabled){color:#fff;border-color:#a78bfa;}
.econ-fig .fig-btn:disabled{opacity:.32;cursor:default;}
.econ-fig .fig-track{display:inline-flex;gap:6px;align-items:center;}
.econ-fig .fig-dot{width:8px;height:8px;border-radius:50%;background:#3a3357;transition:background .3s,transform .3s;}
.econ-fig .fig-dot.on{background:linear-gradient(115deg,#27e8ff,#a78bfa 60%,#ff2e97);transform:scale(1.15);}
.econ-fig .fig-now{font:700 .7rem 'Chakra Petch',sans-serif;color:var(--muted);letter-spacing:.3px;}
/* widoczność i ruch zależne od etapu (data-stage) */
.econ-fig[data-stage="0"] .fig-cap.c0,
.econ-fig[data-stage="1"] .fig-cap.c1,
.econ-fig[data-stage="2"] .fig-cap.c2{display:block;}
.econ-fig[data-stage="1"] .gB,.econ-fig[data-stage="1"] .eqB{opacity:1;}
.econ-fig[data-stage="1"] .eqA{opacity:.32;}
.econ-fig[data-stage="1"] .arrow.shock{opacity:1;}
.econ-fig[data-stage="1"] .ghost{opacity:.5;}
.econ-fig[data-stage="2"] .gA{opacity:1;}
.econ-fig[data-stage="2"] .arrow.fix{opacity:1;}
.econ-fig[data-stage="2"] .ghost2{opacity:.45;}
.econ-fig[data-stage="1"] .mv-sras-left{transform:translate(-46px,0);}
.econ-fig[data-stage="1"] .mv-ad-right{transform:translate(46px,0);}
.econ-fig[data-stage="1"] .mv-ad-left{transform:translate(-46px,0);}
.econ-fig[data-stage="1"] .mv-ae-down{transform:translate(0,34px);}
/* wyblakłe etykiety pozycji krzywej (₁ wyjściowa / ₂ po szoku) + znacznik luki produkcyjnej */
.econ-fig .lbl-g1,.econ-fig .lbl-g2{opacity:0;transition:opacity .5s ease;}
.econ-fig[data-stage="1"] .lbl-g1{opacity:.55;}
.econ-fig[data-stage="2"] .lbl-g2{opacity:.5;}
.econ-fig .gap1{opacity:0;transition:opacity .5s ease;}
.econ-fig[data-stage="1"] .gap1{opacity:1;}
.econ-fig .gapln{stroke:#ffd84a;stroke-width:1.3;stroke-linecap:round;}
.econ-fig .gaptx{fill:#ffd84a;font:800 8px 'Chakra Petch',sans-serif;}
@media(prefers-reduced-motion:reduce){.econ-fig .mv{transition:none;}}
</style>
