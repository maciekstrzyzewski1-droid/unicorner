---
import Base from '../layouts/Base.astro';
import cssGigaNapis from '../styles/giga-napis.css?raw';
const title = "Makroekonomia – nauka do egzaminu";
const description = "Makroekonomia do egzaminu: pieniądz, inflacja, bezrobocie, wzrost gospodarczy, cykl koniunkturalny i polityka banku centralnego. Fiszki, zadania i quiz.";
import jsFiszki from '../scripts/makroekonomia/fiszki.js?raw';
import jsDane from '../scripts/makroekonomia/dane.js?raw';
---

<Base title={title} description={description}>
<style is:inline>
:root{
  --ink:#07060f; --ink2:#0b0918; --line:#241d4a; --line2:#3a2e74;
  --accent:#a78bfa; --accent-d:#8b5cf6; --cyan:#27e8ff; --magenta:#ff2e97;
  --iris:linear-gradient(115deg,#27e8ff 0%,#a78bfa 38%,#ff2e97 72%,#ffd84a 100%);
  --gold-line:linear-gradient(115deg,#ffd84a,#a78bfa 60%,#27e8ff);
  --disp:'Chakra Petch','Space Grotesk',sans-serif; --mono:'Chakra Petch',ui-monospace,monospace;
  --bad:#ff6b8b; --bad-bg:#2a0d18; --bad-line:#5a2233; --ok-line:#1d4a3a;
  /* aliasy dla istniejacej struktury makro + blok econ-fig */
  --bg:#07060f; --bg2:#0b0918; --surface:#100d22; --surface2:#171132;
  --border:#241d4a; --border2:#3a2e74;
  --green:#8b5cf6; --green-l:#a78bfa; --green-bright:#c4b5fd; --mint:#c4b5fd;
  --gold:#ffd84a; --gold-d:#d4a843;
  --text:#eef0ff; --muted:#9b93c4; --muted2:#6f679a;
  --red:#ff6b8b; --red-bg:#2a0d18; --ok:#5ad1a0; --ok-bg:#0c241d;
  --shadow:0 18px 60px rgba(0,0,0,.6);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;letter-spacing:.1px;color:var(--text);min-height:100vh;font-size:16px;line-height:1.55;overflow-x:hidden;position:relative;
  background:
    radial-gradient(900px 520px at 85% -8%, #1a1150 0%, transparent 58%),
    radial-gradient(720px 480px at -8% 4%, #2a0b3f 0%, transparent 52%),
    radial-gradient(600px 600px at 50% 120%, #0d2440 0%, transparent 60%),
    var(--ink);}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:linear-gradient(rgba(39,232,255,.025) 1px,transparent 1px) 0 0/100% 3px,linear-gradient(90deg,rgba(167,139,250,.04) 1px,transparent 1px) 0 0/52px 100%,linear-gradient(rgba(167,139,250,.04) 1px,transparent 1px) 0 0/100% 52px;mix-blend-mode:screen;opacity:.6;}
body::after{content:"";position:fixed;inset:-40% -10%;z-index:0;pointer-events:none;background:linear-gradient(115deg,transparent 40%,rgba(167,139,250,.06) 48%,rgba(39,232,255,.05) 52%,transparent 60%);transform:translateX(-30%);}
@media (prefers-reduced-motion:no-preference){body::after{animation:sweep 14s ease-in-out infinite;}}
@keyframes sweep{0%,100%{transform:translateX(-30%);}50%{transform:translateX(30%);}}
header,main,.giant,footer.uc-foot{position:relative;z-index:1;}
h1,h2,h3,h4,h5,h6,h2.section-title,.wall-card h3,.fc-term,.acc-head,.head-top h1{font-family:var(--disp);letter-spacing:.3px;}

.scanbar{position:fixed;top:0;left:0;right:0;height:2px;z-index:60;background:var(--iris);background-size:200% 100%;opacity:.9;}
@media (prefers-reduced-motion:no-preference){.scanbar{animation:shimmer 6s linear infinite;}}
@keyframes shimmer{to{background-position:200% 0;}}

/* HEADER + NAV */
header{position:sticky;top:0;z-index:50;background:linear-gradient(180deg,rgba(7,6,15,.92),rgba(7,6,15,.6));backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
.head-top{max-width:1040px;margin:0 auto;padding:13px 18px 0;display:flex;align-items:center;gap:12px;}
.logo{width:34px;height:34px;border-radius:8px;background:var(--iris);display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-weight:800;color:#0b0918;font-size:1.1rem;flex-shrink:0;box-shadow:0 0 16px rgba(39,232,255,.35);}
.head-top h1{font-family:var(--disp);font-size:1.16rem;font-weight:700;letter-spacing:.2px;}
.head-top h1 span{color:var(--accent);}
.head-sub{color:var(--muted2);font-size:.72rem;font-weight:500;}
.uc-brand{display:flex;align-items:center;gap:9px;text-decoration:none;flex-shrink:0;}
.uc-horn{width:32px;height:32px;flex-shrink:0;display:block;filter:drop-shadow(0 0 6px rgba(39,232,255,.5));}
@media (prefers-reduced-motion:no-preference){.uc-horn{animation:hornFloat 5s ease-in-out infinite;}}
@keyframes hornFloat{50%{transform:translateY(-2px) rotate(-3deg);}}
.uc-wordmark{font-family:var(--disp);font-weight:700;font-size:1.34rem;letter-spacing:.4px;color:var(--text);text-transform:lowercase;}
.uc-wordmark .ai{background:var(--iris);-webkit-background-clip:text;background-clip:text;color:transparent;background-size:220% 100%;}
@media (prefers-reduced-motion:no-preference){.uc-wordmark .ai{animation:shimmer 7s linear infinite;}}
.uc-sep{color:var(--muted2);font-weight:300;font-size:1.1rem;}
.uc-subject{font-family:var(--mono);font-weight:600;font-size:.82rem;letter-spacing:1px;text-transform:uppercase;color:var(--muted);}
.uc-back{margin-left:auto;display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:.76rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--muted);text-decoration:none;border:1px solid var(--line);background:var(--ink2);padding:8px 13px;transition:.2s;
  clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));}
.uc-back:hover{color:var(--text);border-color:var(--accent);box-shadow:0 0 14px rgba(167,139,250,.2);}
@media(max-width:560px){.uc-back{display:none;}}
nav{max-width:1040px;margin:0 auto;padding:10px 12px;display:flex;gap:8px;overflow-x:auto;}
.tab{flex:1;min-width:max-content;white-space:nowrap;padding:10px 16px;border:1px solid var(--line);background:var(--surface);color:var(--muted);cursor:pointer;font-family:var(--mono);font-size:.76rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;transition:.2s;display:flex;align-items:center;gap:7px;justify-content:center;
  clip-path:polygon(0 0,calc(100% - 9px) 0,100% 9px,100% 100%,9px 100%,0 calc(100% - 9px));}
.tab:hover{border-color:var(--accent);color:var(--text);box-shadow:0 0 14px rgba(167,139,250,.18);}
.tab.active{color:#fff;border-color:transparent;background:linear-gradient(160deg,var(--surface2),var(--ink2));position:relative;}
.tab.active::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--iris);}

main{max-width:1040px;margin:0 auto;padding:20px 16px 70px;}
.view{display:none;animation:fade .3s ease;}
.view.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
h2.section-title{font-size:1.7rem;font-weight:700;letter-spacing:-.3px;margin-bottom:4px;background:var(--iris);-webkit-background-clip:text;background-clip:text;color:transparent;}
.section-intro{color:var(--muted);font-size:.92rem;margin-bottom:20px;max-width:700px;}

.card{position:relative;background:linear-gradient(160deg,var(--surface),var(--ink2));border:1px solid var(--line);border-radius:4px;padding:18px;margin-bottom:14px;
  clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));}

/* FISZKI */
.fc-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:14px;}
.fc-label{font-family:var(--mono);font-size:.62rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin:0 6px 0 2px;opacity:.75;}
.chip{font-family:var(--mono);padding:7px 13px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:4px;cursor:pointer;font-size:.76rem;font-weight:600;letter-spacing:.5px;transition:.2s;}
.chip:hover{border-color:var(--accent);color:var(--text);box-shadow:0 0 12px rgba(167,139,250,.15);}
.chip.active{background:var(--iris);border-color:transparent;color:#0b0918;font-weight:700;}
.chip-action{font-family:var(--mono);padding:7px 13px 7px 11px;border:1px solid rgba(39,232,255,.28);background:rgba(39,232,255,.04);color:var(--muted);border-radius:4px;cursor:pointer;font-size:.72rem;font-weight:600;letter-spacing:.5px;text-transform:uppercase;transition:.2s;border-left-width:3px;border-left-color:var(--cyan);}
.chip-action:hover{background:rgba(39,232,255,.10);color:var(--text);box-shadow:0 0 12px rgba(39,232,255,.18);}
.chip-action.active{background:rgba(39,232,255,.14);color:var(--text);border-color:rgba(39,232,255,.55);border-left-color:var(--cyan);}
.fc-stats{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px;}
.stat{font-family:var(--mono);background:linear-gradient(180deg,rgba(15,12,32,.6),rgba(7,6,15,.75));border:1px solid var(--line);border-radius:6px;padding:8px 16px;color:var(--muted2);letter-spacing:1px;text-transform:uppercase;font-size:.6rem;font-weight:700;display:flex;flex-direction:column;gap:2px;min-width:96px;cursor:default;position:relative;overflow:hidden;}
.stat::before{content:"";position:absolute;top:0;left:0;width:2px;height:100%;background:var(--muted2);opacity:.4;}
.stat b{color:var(--text);font-size:1.15rem;font-family:'Orbitron',var(--disp);letter-spacing:1px;font-weight:800;}
.stat.know::before{background:var(--cyan);opacity:1;box-shadow:0 0 8px var(--cyan);}
.stat.know b{color:var(--cyan);}
.stat.dont::before{background:var(--gold);opacity:1;box-shadow:0 0 8px var(--gold);}
.stat.dont b{color:var(--gold);}
.flashcard{perspective:1600px;width:100%;height:340px;margin:0 auto 14px;cursor:pointer;}
.fc-inner{position:relative;width:100%;height:100%;transition:transform .5s;transform-style:preserve-3d;}
.flashcard.flipped .fc-inner{transform:rotateY(180deg);}
.fc-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:4px;padding:26px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;border:1px solid var(--line2);box-shadow:var(--shadow);overflow:auto;
  clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));}
.fc-front{background:linear-gradient(160deg,var(--surface2),var(--ink2));}
.fc-front::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--iris);}
.fc-back{background:linear-gradient(160deg,var(--ink2),var(--surface));transform:rotateY(180deg);}
.fc-tag{position:absolute;top:14px;left:14px;font-family:var(--mono);font-size:.62rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--cyan);background:rgba(39,232,255,.08);padding:4px 9px;border-radius:4px;}
.fc-hint{position:absolute;bottom:14px;font-family:var(--mono);font-size:.68rem;color:var(--muted2);}
.fc-term{font-size:1.6rem;font-weight:800;line-height:1.25;color:#fff;}
.fc-def{font-size:1.02rem;color:#cfc9e8;line-height:1.6;}
.fc-deflabel{font-family:var(--mono);font-size:.66rem;text-transform:uppercase;letter-spacing:1px;color:var(--muted2);margin-bottom:10px;}
.fc-controls{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;}
.btn{font-family:var(--mono);padding:14px;border:1px solid transparent;border-radius:4px;font-size:.82rem;font-weight:700;letter-spacing:.5px;text-transform:uppercase;cursor:pointer;transition:.15s;color:#fff;
  clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));}
.btn:active{transform:scale(.98);}
.btn-dont{background:linear-gradient(135deg,#7a2438,#b3405a);}
.btn-know{background:linear-gradient(135deg,var(--accent-d),var(--accent));}
.btn-ghost{background:var(--surface);border:1px solid var(--line);color:var(--muted);}
.btn-ghost:hover{color:var(--text);border-color:var(--accent);box-shadow:0 0 12px rgba(167,139,250,.15);}
.fc-nav{display:flex;gap:10px;justify-content:space-between;align-items:center;}
.fc-nav button{flex:1;}
.fc-progress{height:6px;background:var(--ink2);border-radius:20px;overflow:hidden;margin-bottom:12px;border:1px solid var(--line);}
.fc-progress div{height:100%;background:var(--iris);transition:width .3s;box-shadow:0 0 10px rgba(39,232,255,.5);}
.fc-done{text-align:center;padding:34px 18px;}
.fc-done .em{font-size:3rem;}
.fc-done h3{color:var(--cyan);margin:10px 0 6px;font-size:1.3rem;}
.fc-done p{color:var(--muted);font-size:.9rem;margin-bottom:18px;}

/* ZADANIA */
.accordion{position:relative;background:linear-gradient(160deg,var(--surface),var(--ink2));border:1px solid var(--line);border-radius:4px;margin-bottom:12px;overflow:hidden;
  clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));}
.acc-head{padding:16px 18px;cursor:pointer;display:flex;align-items:center;gap:12px;font-weight:700;font-size:.98rem;transition:background .2s;}
.acc-head:hover{background:rgba(167,139,250,.06);}
.acc-num{width:30px;height:30px;flex-shrink:0;border-radius:8px;background:var(--iris);color:#0b0918;display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-size:.85rem;font-weight:800;box-shadow:0 0 12px rgba(39,232,255,.3);}
.acc-arrow{margin-left:auto;color:var(--muted);transition:.25s;font-size:1.1rem;}
.accordion.open .acc-arrow{transform:rotate(90deg);color:var(--cyan);}
.acc-body{display:none;padding:0 18px 18px;border-top:1px solid var(--line);}
.accordion.open .acc-body{display:block;animation:fade .25s;}
.acc-body h4{color:var(--accent);margin:16px 0 6px;font-size:.95rem;}
.acc-body p{margin:8px 0;font-size:.92rem;color:#d8d3ee;}
.acc-body .muted{color:var(--muted);}
.given{background:var(--ink2);border:1px solid var(--line);border-radius:4px;padding:12px 14px;margin:12px 0;font-size:.9rem;}
.given b{color:var(--gold);}
.formula{background:#0a0818;border:1px dashed var(--line2);border-radius:4px;padding:12px 14px;margin:10px 0;font-family:'Cambria Math','Georgia',serif;font-size:1.05rem;color:var(--mint);text-align:center;overflow-x:auto;}
.answer{background:var(--ok-bg);border-left:3px solid var(--ok);border-radius:0 4px 4px 0;padding:12px 14px;margin:12px 0;font-size:.94rem;}
.answer b{color:var(--cyan);}
.eli5{background:rgba(255,216,74,.07);border-left:3px solid var(--gold);border-radius:0 4px 4px 0;padding:14px 16px;margin:12px 0;font-size:.92rem;color:#f0e4c4;line-height:1.55;}
.eli5 b{color:var(--gold);}
.eli5 .step{display:block;margin-top:9px;}
.eli5 .step:first-child{margin-top:6px;}
.eli5 .step-lbl{font-family:var(--mono);font-size:.7rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--gold);opacity:.85;margin-right:6px;}
.reveal-btn{font-family:var(--mono);margin-top:10px;background:var(--surface2);border:1px solid var(--line2);color:var(--mint);padding:9px 16px;border-radius:4px;cursor:pointer;font-weight:700;font-size:.78rem;letter-spacing:.5px;text-transform:uppercase;transition:.2s;}
.reveal-btn:hover{background:#241a44;border-color:var(--accent);}
.sol{display:none;margin-top:10px;}
.sol.show{display:block;animation:fade .25s;}
table.mini{width:100%;border-collapse:collapse;margin:10px 0;font-size:.85rem;}
table.mini th,table.mini td{border:1px solid var(--line);padding:7px 9px;text-align:center;}
table.mini th{background:var(--surface2);color:var(--mint);font-family:var(--mono);text-transform:uppercase;font-size:.7rem;letter-spacing:.5px;}

/* LEGENDA */
.legend-card{border:1px solid rgba(255,216,74,.35) !important;margin-bottom:22px !important;}
.legend-card .acc-head{background:rgba(255,216,74,.04);}
.legend-card .acc-head:hover{background:rgba(255,216,74,.08);}
.legend-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:8px;margin-top:8px;}
.lg-item{display:flex;align-items:flex-start;gap:10px;padding:8px 11px;background:var(--ink2);border:1px solid var(--line);border-radius:4px;font-size:.85rem;}
.lg-item b{color:var(--gold);font-family:'Cambria Math',Georgia,serif;font-size:1.02rem;min-width:42px;flex-shrink:0;}
.lg-item span{color:#d8d3ee;line-height:1.45;}
.lg-formula{display:grid;grid-template-columns:1fr 1.4fr;gap:14px;align-items:center;background:#0a0818;border:1px solid var(--line2);border-radius:4px;padding:12px 14px;margin:10px 0;}
.lg-f-eq{font-family:'Cambria Math',Georgia,serif;color:var(--mint);font-size:1rem;text-align:center;line-height:1.5;}
.lg-f-use{font-size:.86rem;color:#d8d3ee;line-height:1.55;border-left:2px solid var(--gold);padding-left:12px;}
.lg-f-use b{color:var(--gold);}
@media(max-width:640px){.lg-formula{grid-template-columns:1fr;gap:8px;}.lg-f-use{border-left:none;border-top:1px solid var(--line);padding-left:0;padding-top:8px;}}

/* SCIANA */
.wall-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;width:min(1280px,94vw);position:relative;left:50%;transform:translateX(-50%);}
.wall-card{position:relative;background:linear-gradient(165deg,var(--surface),var(--ink2));border:1px solid var(--line);border-radius:4px;padding:24px 26px 22px;box-shadow:0 14px 40px rgba(0,0,0,.4);overflow:hidden;transition:transform .25s,border-color .25s,box-shadow .25s;
  clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));}
.wall-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--iris);opacity:.9;}
.wall-card:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 22px 54px rgba(0,0,0,.52),0 0 22px rgba(167,139,250,.18);}
.wall-card h3{font-size:1.16rem;font-weight:700;color:#fff;margin-bottom:16px;display:flex;align-items:center;gap:12px;letter-spacing:.2px;}
.wall-card .ico{width:40px;height:40px;border-radius:8px;background:linear-gradient(135deg,rgba(39,232,255,.16),rgba(167,139,250,.1));border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.wall-card ul{list-style:none;}
.wall-card li{padding:11px 0;border-bottom:1px solid rgba(58,46,116,.42);font-size:.94rem;line-height:1.62;color:#d8d3ee;}
.wall-card li:last-child{border-bottom:none;padding-bottom:0;}
.wall-card li b{color:#fff;font-weight:600;}
.wall-card code{display:inline-block;background:#0a0818;border:1px solid var(--line2);border-radius:4px;padding:2px 8px;margin:1px 0;color:var(--mint);font-family:'Cambria Math',Georgia,serif;font-size:.95rem;white-space:normal;}
.kv{color:var(--gold);font-weight:700;}

/* QUIZ */
#quizStart .chip{font-size:.78rem;}
.qstep{color:var(--cyan);font-size:.98rem;font-weight:700;letter-spacing:.2px;font-family:var(--mono);}
#quizBatches .chip{font-variant-numeric:tabular-nums;}
.qcount{font-family:var(--mono);font-size:.78rem;color:var(--muted);margin:14px 0;letter-spacing:.5px;}
.q-meta{display:flex;justify-content:space-between;color:var(--muted2);font-family:var(--mono);font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;margin-bottom:8px;}
.q-text{font-family:var(--disp);font-size:1.12rem;font-weight:600;line-height:1.5;margin-bottom:16px;}
.opt{background:var(--ink2);border:1px solid var(--line);border-radius:4px;padding:13px 14px;margin-bottom:10px;cursor:pointer;display:flex;gap:12px;align-items:center;font-size:.94rem;transition:.15s;}
.opt:hover:not(.dis){border-color:var(--accent);box-shadow:0 0 14px rgba(167,139,250,.15);}
.opt .lt{width:30px;height:30px;flex-shrink:0;border-radius:8px;background:var(--iris);color:#0b0918;display:flex;align-items:center;justify-content:center;font-family:var(--disp);font-weight:800;font-size:.85rem;}
.opt.correct{background:var(--ok-bg);border-color:var(--ok-line);color:#bff3d3;}
.opt.correct .lt{background:var(--ok);color:#06251a;}
.opt.wrong{background:var(--bad-bg);border-color:var(--bad-line);color:#ffc9cb;}
.opt.wrong .lt{background:var(--bad);color:#2a0d18;}
.opt.dis{cursor:default;}
.q-exp{background:var(--ok-bg);border-left:3px solid var(--ok);border-radius:0 4px 4px 0;padding:12px 14px;margin-top:6px;font-size:.88rem;color:#cdeed9;display:none;}
.q-exp.wrongx{background:var(--bad-bg);border-left-color:var(--bad);color:#f3d2d4;}
.q-exp.show{display:block;animation:fade .2s;}
.q-next{margin-top:14px;width:100%;display:none;}
.q-next.show{display:block;}
.result{text-align:center;padding:30px 18px;}
.result .em{font-size:3.2rem;}
