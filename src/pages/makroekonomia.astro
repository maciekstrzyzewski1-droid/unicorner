<script is:inline set:html={jsFiszki}></script>
<script is:inline id="dataScript" set:html={jsDane}></script>
<script is:inline>
/* ---------- bezpieczny localStorage ---------- */
const store={
  get(k,def){try{const v=localStorage.getItem(k);return v?JSON.parse(v):def;}catch(e){return def;}},
  set(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
};

/* ---------- NAWIGACJA ---------- */
document.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    document.getElementById(t.dataset.view).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  });
});

/* ============ FISZKI ============ */
let fcKnown=store.get('makro_known',{});
let fcCat='all', fcMode='all', fcDeck=[], fcIdx=0, fcFlipped=false;

function buildCatChips(){
  const wrap=document.getElementById('fcCats');
  let html=`<span class="chip active" data-c="all" onclick="fcSetCat('all',this)">Wszystkie kategorie</span>`;
  for(const k in CATS){html+=`<span class="chip" data-c="${k}" onclick="fcSetCat('${k}',this)">${CATS[k]}</span>`;}
  wrap.innerHTML=html;
}
function fcSetCat(c,el){
  fcCat=c;
  document.querySelectorAll('#fcCats .chip').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  fcBuildDeck();
}
function fcSetMode(m){
  fcMode=m;
  document.getElementById('modeAll').classList.toggle('active',m==='all');
  document.getElementById('modeDont').classList.toggle('active',m==='dont');
  fcBuildDeck();
}
function fcBuildDeck(){
  fcDeck=FLASHCARDS.filter(c=>fcCat==='all'||c.c===fcCat);
  if(fcMode==='dont') fcDeck=fcDeck.filter(c=>fcKnown[c.t]!==true);
  fcIdx=0; fcFlipped=false;
  fcRender();
}
function fcShuffle(){
  for(let i=fcDeck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[fcDeck[i],fcDeck[j]]=[fcDeck[j],fcDeck[i]];}
  fcIdx=0; fcFlipped=false; fcRender();
}
function fcStats(){
  const pool=FLASHCARDS.filter(c=>fcCat==='all'||c.c===fcCat);
  const know=pool.filter(c=>fcKnown[c.t]===true).length;
  const dont=pool.filter(c=>fcKnown[c.t]===false).length;
  document.getElementById('stTotal').textContent=pool.length;
  document.getElementById('stKnow').textContent=know;
  document.getElementById('stDont').textContent=dont;
}
function fcRender(){
  fcStats();
  const area=document.getElementById('fcArea'), done=document.getElementById('fcDone');
  if(fcDeck.length===0){
    area.style.display='none'; done.style.display='block';
    document.getElementById('fcDoneTitle').textContent= fcMode==='dont'?'Brawo! 🏆':'Brak kart';
    document.getElementById('fcDoneMsg').textContent= fcMode==='dont'
      ? 'Nie masz tu już nic do powtórki w tej kategorii — wszystko oznaczone jako „Umiem".'
      : 'W tej kategorii nie ma kart.';
    document.getElementById('fcBar').style.width='100%';
    return;
  }
  if(fcIdx>=fcDeck.length){
    area.style.display='none'; done.style.display='block';
    const know=fcDeck.filter(c=>fcKnown[c.t]===true).length;
    document.getElementById('fcDoneTitle').textContent='Koniec zestawu! 🎉';
    document.getElementById('fcDoneMsg').textContent=`Przejrzałeś ${fcDeck.length} fiszek. Umiesz: ${know}/${fcDeck.length}.`;
    document.getElementById('fcBar').style.width='100%';
    return;
  }
  area.style.display='block'; done.style.display='none';
  const card=fcDeck[fcIdx];
  const fc=document.getElementById('flashcard');
  fc.classList.remove('flipped'); fcFlipped=false;
  document.getElementById('fcTagF').textContent=CATS[card.c];
  document.getElementById('fcTagB').textContent=CATS[card.c];
  document.getElementById('fcTerm').textContent=card.t;
  document.getElementById('fcDef').textContent=card.d;
  let pos=`${fcIdx+1} / ${fcDeck.length}`;
  if(fcKnown[card.t]===true)pos+=' ✓'; else if(fcKnown[card.t]===false)pos+=' ✗';
  document.getElementById('fcPos').textContent=pos;
  document.getElementById('fcBar').style.width=((fcIdx)/fcDeck.length*100)+'%';
}
function fcFlip(){fcFlipped=!fcFlipped;document.getElementById('flashcard').classList.toggle('flipped',fcFlipped);}
function fcMark(known){
  const card=fcDeck[fcIdx];
  fcKnown[card.t]=known; store.set('makro_known',fcKnown);
  fcNext();
}
function fcNext(){fcIdx++;fcRender();}
function fcPrev(){if(fcIdx>0){fcIdx--;fcRender();}}
function fcRestartAll(){fcSetMode('all');fcIdx=0;fcRender();}
function fcResetProgress(){
  if(confirm('Wyczyścić cały postęp (oznaczenia „Umiem/Nie umiem")?')){
    fcKnown={}; store.set('makro_known',fcKnown); fcBuildDeck();
  }
}

/* ============ ZADANIA ============ */
function renderZadania(){
  const wrap=document.getElementById('zadaniaArea');
  /* kolejność: zadanie wzorcowe (★) → kolorowe zadania egzaminacyjne (sq) → reszta */
  const ordered=[ZADANIA[0], ...ZADANIA.slice(1).filter(z=>z.sq), ...ZADANIA.slice(1).filter(z=>!z.sq)];
  wrap.innerHTML=ordered.map((z,i)=>`
   <div class="accordion${i===0?' open':''}">
     <div class="acc-head" onclick="this.parentElement.classList.toggle('open')">
       ${z.sq?'<span class="acc-num acc-sq" aria-hidden="true"></span>':`<span class="acc-num">${z.num}</span>`}
       <span><span style="font-size:.66rem;letter-spacing:.5px;color:var(--gold);display:block;">${z.badge}</span>${z.title}</span>
       <span class="acc-arrow">▸</span>
     </div>
     <div class="acc-body">${z.html}</div>
   </div>`).join('');
  /* wykresy: ustaw stan początkowy paska kroków (działa tak samo na dotyku i myszy) */
  wrap.querySelectorAll('.econ-fig').forEach(figUpdate);
}
/* sterowanie etapami wykresów: szok → reakcja, krok po kroku */
function figStep(btn,d){
  const fig=btn.closest('.econ-fig'); if(!fig) return;
  const max=+fig.dataset.stages, s=Math.max(0,Math.min(max,(+fig.dataset.stage||0)+d));
  fig.dataset.stage=s; figUpdate(fig);
}
function figUpdate(fig){
  const max=+fig.dataset.stages, s=+fig.dataset.stage||0;
  const names=(fig.dataset.names||'').split('|');
  const prev=fig.querySelector('.fig-prev'), next=fig.querySelector('.fig-next'), now=fig.querySelector('.fig-now');
  if(prev) prev.disabled=s<=0;
  if(next) next.disabled=s>=max;
  if(now) now.textContent=s+' / '+max+(names[s]?' · '+names[s]:'');
  fig.querySelectorAll('.fig-dot').forEach((dot,i)=>dot.classList.toggle('on',i<=s));
}
function revealSol(btn){
  const sol=btn.nextElementSibling;
  const open=sol.classList.toggle('show');
  btn.textContent=btn.textContent.replace(/[▾▴]/,open?'▴':'▾');
}

/* ============ ŚCIANA ============ */
function renderWall(){
  document.getElementById('wallArea').innerHTML=WALL.map(c=>`
    <div class="wall-card">
      <h3><span class="ico">${c.ico}</span>${c.title}</h3>
      <ul>${c.items.map(it=>`<li>${it}</li>`).join('')}</ul>
    </div>`).join('');
}

/* ============ QUIZ ============ */
const QCATS={all:"Wszystko",pkb:"PKB",adas:"AD-AS / mnożnik",bezr:"Bezrobocie",inf:"Pieniądz / inflacja",fisk:"Pol. fiskalna",wzr:"Wzrost",handel:"Handel",met:"Podstawy"};
let qCat='all', qMode='full', qBatch=0, qList=[], qIdx=0, qScore=0, qByTopic={}, qAnswered=false, qOrder=[];

function renderQuizCats(){
  const wrap=document.getElementById('quizCats');
  let html='';
  for(const k in QCATS){html+=`<span class="chip${k==='all'?' active':''}" data-c="${k}" onclick="quizSetCat('${k}',this)">${QCATS[k]}</span>`;}
  wrap.innerHTML=html; quizUpdateCount();
}
function quizSetCat(c,el){
  qCat=c; qBatch=0;
  document.querySelectorAll('#quizCats .chip').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  if(qMode==='batch') renderBatches();
  quizUpdateCount();
}
function quizSetMode(m){
  qMode=m; qBatch=0;
  document.getElementById('qmFull').classList.toggle('active',m==='full');
  document.getElementById('qmBatch').classList.toggle('active',m==='batch');
  const box=document.getElementById('quizBatches');
  if(m==='batch'){box.style.display='flex';renderBatches();}
  else{box.style.display='none';}
  quizUpdateCount();
}
function renderBatches(){
  const total=quizPool().length, n=Math.ceil(total/10);
  let html='';
  for(let i=0;i<n;i++){
    const from=i*10+1, to=Math.min((i+1)*10,total);
    html+=`<span class="chip${i===qBatch?' active':''}" onclick="quizSetBatch(${i},this)">Zestaw ${i+1} · ${from}–${to}</span>`;
  }
  document.getElementById('quizBatches').innerHTML=html;
}
function quizSetBatch(i,el){
  qBatch=i;
  document.querySelectorAll('#quizBatches .chip').forEach(x=>x.classList.remove('active'));
  el.classList.add('active'); quizUpdateCount();
}
function quizPool(){return QUIZ.filter(q=>qCat==='all'||q.cat===qCat);}
function quizSelected(){
  const p=quizPool();
  if(qMode==='batch') return p.slice(qBatch*10, qBatch*10+10);
  return p;
}
function quizUpdateCount(){
  const n=quizSelected().length;
  const extra=qMode==='batch'?` (zestaw ${qBatch+1})`:'';
  document.getElementById('quizCount').textContent=`Pytań w wybranym zakresie: ${n}${extra}`;
}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function quizStart(){
  qList=shuffle(quizSelected().slice());
  if(qList.length===0){alert('Brak pytań w tym zakresie.');return;}
  qIdx=0;qScore=0;qByTopic={};qAnswered=false;
  document.getElementById('quizStart').style.display='none';
  document.getElementById('quizResult').style.display='none';
  document.getElementById('quizPlay').style.display='block';
  renderQ();
}
function renderQ(){
  qAnswered=false;
  const q=qList[qIdx];
  document.getElementById('qBar').style.width=(qIdx/qList.length*100)+'%';
  document.getElementById('qProg').textContent=`Pytanie ${qIdx+1} z ${qList.length}`;
  document.getElementById('qTopic').textContent=q.topic;
  document.getElementById('qText').textContent=q.q;
  const L=['A','B','C','D'];
  qOrder=shuffle(q.o.map((_,i)=>i));
  document.getElementById('qOpts').innerHTML=qOrder.map((origIdx,pos)=>
    `<div class="opt" onclick="quizPick(${pos})"><span class="lt">${L[pos]}</span><span>${q.o[origIdx]}</span></div>`).join('');
  const exp=document.getElementById('qExp'); exp.className='q-exp'; exp.textContent='';
  document.getElementById('qNext').classList.remove('show');
}
function quizPick(pos){
  if(qAnswered)return; qAnswered=true;
  const q=qList[qIdx];
  const picked=qOrder[pos];
  const opts=document.querySelectorAll('#qOpts .opt');
  opts.forEach((o,p)=>{o.classList.add('dis');
    const oi=qOrder[p];
    if(oi===q.a)o.classList.add('correct');
    if(p===pos&&picked!==q.a)o.classList.add('wrong');});
  qByTopic[q.topic]=qByTopic[q.topic]||{c:0,t:0}; qByTopic[q.topic].t++;
  const exp=document.getElementById('qExp');
  if(picked===q.a){qScore++;qByTopic[q.topic].c++;exp.className='q-exp show';exp.innerHTML='✓ Dobrze! '+q.e;}
  else{exp.className='q-exp show wrongx';exp.innerHTML='✗ Poprawna: <b>'+q.o[q.a]+'</b>. '+q.e;}
  const nx=document.getElementById('qNext');
  nx.textContent=(qIdx===qList.length-1)?'Zobacz wynik →':'Następne →';
  nx.classList.add('show');
}
function quizNext(){
  if(qIdx<qList.length-1){qIdx++;renderQ();window.scrollTo({top:0,behavior:'smooth'});}
  else quizShowResult();
}
function quizShowResult(){
  document.getElementById('quizPlay').style.display='none';
  const res=document.getElementById('quizResult'); res.style.display='block';
  const pct=Math.round(qScore/qList.length*100);
  document.getElementById('rScore').textContent=`${qScore} / ${qList.length}`;
  let em,grade,msg;
  if(pct>=90){em='🏆';grade='Świetnie!';msg='Materiał masz opanowany — tak trzymaj na egzaminie.';}
  else if(pct>=70){em='💪';grade='Dobrze!';msg='Solidnie. Dopnij słabsze tematy na fiszkach.';}
  else if(pct>=50){em='📚';grade='Nieźle, ale jest co poprawiać.';msg='Wróć do ściany i fiszek z najsłabszych działów.';}
  else{em='🔁';grade='Trzeba poćwiczyć.';msg='Spokojnie — przejdź fiszki i ścianę, potem powtórz quiz.';}
  document.getElementById('rEm').textContent=em;
  document.getElementById('rGrade').textContent=`${grade} (${pct}%)`;
  document.getElementById('rMsg').textContent=msg;
  let bd='<h3 style="color:var(--green-bright);font-size:.95rem;margin-bottom:8px;">Wynik wg tematów</h3>';
  for(const t in qByTopic){const o=qByTopic[t];bd+=`<div class="bd-row"><span>${t}</span><span style="font-weight:700;color:${o.c===o.t?'var(--green-bright)':'var(--gold)'}">${o.c}/${o.t}</span></div>`;}
  document.getElementById('rBreak').innerHTML=bd;
  window.scrollTo({top:0,behavior:'smooth'});
}
function quizReset(){
  document.getElementById('quizResult').style.display='none';
  document.getElementById('quizStart').style.display='block';
}

/* ---------- INIT ---------- */
buildCatChips();
fcSetMode('all');
renderZadania();
renderWall();
renderQuizCats();
</script>



