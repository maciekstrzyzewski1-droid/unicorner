<script is:inline>
/* footer equalizer + motion guard */
(function(){
  var stars = document.getElementById('footStars');
  var clip = document.getElementById('ufClip');
  var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stars) {
    var N = 80, html = '';
    for (var i = 0; i < N; i++) {
      var sz = (1 + Math.random() * 2.4).toFixed(1);
      var col = Math.random() < .78 ? '167,139,250' : (Math.random() < .5 ? '39,232,255' : '255,46,151');
      html += '<i style="left:' + (Math.random()*100).toFixed(2) + '%;top:' + (Math.random()*100).toFixed(2) +
              '%;width:' + sz + 'px;height:' + sz + 'px;background:rgba(' + col + ',1);' +
              'box-shadow:0 0 6px rgba(' + col + ',.7);--o:' + (.18 + Math.random()*.5).toFixed(2) +
              ';--d:' + (2 + Math.random()*4).toFixed(1) + 's;--dl:' + (Math.random()*4).toFixed(1) + 's"></i>';
    }
    stars.innerHTML = html;
  }
  if (clip) {
    if (calm) {
      clip.removeAttribute('autoplay'); clip.pause();
      /* wymuś dekodowanie i pokazanie pierwszej klatki, mimo braku odtwarzania —
         bez tego mix-blend-mode:screen renderuje pustą klatkę jako całkowicie niewidoczną */
      clip.addEventListener('loadeddata', function(){ clip.currentTime = 0.1; }, { once:true });
      if (clip.readyState >= 2) clip.currentTime = 0.1;
    }
    else {
      var p = clip.play(); if (p && p.catch) p.catch(function(){});
      /* don't decode video while the footer is off-screen */
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(es){
          es.forEach(function(e){
            if (e.isIntersecting) { var q = clip.play(); if (q && q.catch) q.catch(function(){}); }
            else clip.pause();
          });
        }, { rootMargin: '200px' }).observe(clip);
      }
    }
  }
})();

</script>

