---
// Strona główna, wariant „Siatka” (cyberpunk, fiolet). Style: src/styles/siatka.css, skrypty: src/scripts/siatka/.
// Elementy dawnych wersji (strona live sprzed przebudowy, wariant „Świt”) do szybkiego przywracania: KATALOG-ELEMENTOW.md.
import Base from '../layouts/Base.astro';
import '../styles/siatka.css';
import { getArticles, CATEGORIES } from '../lib/wiedza.js';

// Karty przedmiotów renderują się przy buildzie (zwykłe <a href> w HTML-u, widoczne bez JS i dla wyszukiwarek).
// Nowy przedmiot = nowy wpis w SUBJECTS. `sub` to dopisek obok nazwy, `badge` to stan („w budowie”).
const SUBJECTS = [
  { name:"Makroekonomia", emoji:"📈",
    desc:"Pieniądz, inflacja, bezrobocie, wzrost, cykl koniunkturalny i polityka banku centralnego.",
    tags:["Fiszki","Zadania","Ściana","Quiz"], status:"live", file:"makroekonomia.html" },
  { name:"Podstawy marketingu", emoji:"🎯",
    desc:"Reguły Cialdiniego, marketing mix (4P/7P/4C), proces decyzyjny konsumenta, segmentacja i perswazja.",
    tags:["Materiały","Quiz 55 pytań"], status:"live", file:"marketing.html" },
  { name:"Metody i Techniki Zarządzania", emoji:"⚙️",
    desc:"VUCA, narzędzia jakości, analiza przyczyn źródłowych (RCA), kreatywność i praca zespołowa.",
    tags:["Kompendium","Quiz"], status:"live", file:"mitz.html" },
  { name:"Zarządzanie Jakością", emoji:"🏅",
    desc:"Ewolucja QI→QC→QA→TQM, guru jakości, 7 zasad ISO, TQM/Lean/Six Sigma, normalizacja, ISO 9001, akredytacja i koszty jakości.",
    tags:["Kompendium","Quiz 100 pytań"], status:"live", file:"zarzadzanie-jakoscia.html" },
  { name:"Ekonomika Turystyki i Rekreacji", emoji:"🧳",
    desc:"Rynek turystyczny, produkt, podaż, turystyka międzynarodowa i gospodarka turystyczna.",
    tags:["Kompendium","Quiz 44 pytania"], status:"live", file:"etir.html" },
  { name:"Obsługa Ruchu Turystycznego", emoji:"🧭",
    desc:"Ruch turystyczny, rodzaje turystyki, obsługa na etapach podróży, organizacja imprez, praca pilota i przewodnika.",
    tags:["Kompendium","Quiz 41 pytań"], status:"live", file:"ort.html" },
  { name:"Geografia atrakcji turystycznych", emoji:"🗺️",
    desc:"Środowisko przyrodnicze sześciu kontynentów — góry, rzeki, jeziora, wulkany, pustynie i rekordy natury.",
    tags:["6 kontynentów","Quiz 40 pytań"], status:"live", file:"geografia.html" },
  { name:"Matematyka", sub:"kurs od zera", emoji:"∑",
    desc:"Logika, zbiory, relacje, macierze, programowanie liniowe, pochodne i całki. Każdy symbol wyjaśniony, zadania krok po kroku z „dlaczego”.",
    tags:["Kurs krok po kroku","Interaktywne tabele","Quizy"], status:"live", badge:"w budowie", file:"matematyka.html" },
  { name:"Rachunkowość", sub:"kurs od zera", emoji:"⊤",
    desc:"Bilans, operacje gospodarcze, konto teowe, Wn i Ma, saldo i podwójny zapis. Zadania z zajęć krok po kroku, bilans i konta wypełniające się na oczach.",
    tags:["Kurs krok po kroku","Konta teowe","Ćwiczenia"], status:"live", badge:"w budowie", file:"rachunkowosc.html" },
  { name:"Metody badań rynku", sub:"kurs od zera", emoji:"n",
    desc:"Skale pomiarowe i kafeteria, błędy w pytaniach ankiety, minimalna liczebność próby z danych GUS i dobór kwotowy. Każdy parametr wyjaśniony, zadania krok po kroku.",
    tags:["Kurs krok po kroku","Kwestionariusz","Liczebność próby"], status:"live", badge:"w budowie", file:"metody-badan-rynku.html" },
  { name:"Języki obce", sub:"ścieżka jak w apce", emoji:"🗣️",
    desc:"Hiszpański w biznesie w kolejności zajęć: krótkie lekcje, wyjaśnienie przy każdej odpowiedzi, XP, seria dni, kamienie milowe i próbne kolokwium jako escape room. Angielski w drodze.",
    tags:["Ścieżka lekcji","Kamienie milowe","Escape room"], status:"live", file:"jezyki.html" },
  { name:"Statystyka", sub:"final boss", boss:true, emoji:"📊",
    desc:"Od miar opisowych, przez dynamikę i szeregi czasowe, po korelację i regresję. Teoria, zadania i quizy w ośmiu działach.",
    tags:["8 działów","Quizy","Zadania"], status:"live", file:"statystyka-kurs.html" },
  { name:"Kolejne przedmioty", emoji:"✦",
    desc:"Dochodzą po kolei. Masz przedmiot, który chcesz tu zobaczyć następny? Daj znać.",
    tags:["Wkrótce"], status:"soon", file:"kontakt.html" }
];

const STAT_DZIALY = 8; // działy statystyki liczą się osobno (lista: src/pages/statystyka-kurs.astro)
const zywe = SUBJECTS.filter(s=>s.status==='live');
const liveCount = zywe.length - 1 + STAT_DZIALY;
const odmiana = (n, jeden, kilka, wiele) => (n===1 ? jeden : (n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? kilka : wiele));
const countText = liveCount + ' ' + odmiana(liveCount, 'gotowy', 'gotowe', 'gotowych');
// opóźnienia wejścia kart: coraz mniejsze odstępy, żeby siatka weszła jak fala, a nie jak kolejka
const opoznienie = (i) => Math.min(320, Math.round(55 * (1 - Math.pow(0.82, i)) / 0.18));

// Zdanie, które „dekoduje się” słowo po słowie przy przewijaniu (tekst z dawnego „Po co to jest”).
const ZDANIE = 'Wkuwanie definicji rzadko wystarcza. Egzaminy lubią przykłady i zastosowanie. Materiały są pod to ułożone.';
const slowa = ZDANIE.split(' ');

const KROKI = [
  { t:'Wybierz przedmiot', d:'Otwiera się od razu. Bez konta i bez logowania.' },
  { t:'Przejdź fiszki', d:'Pojęcia i definicje. Odznaczasz to, co już umiesz.' },
  { t:'Rozwiąż zadania', d:'Krok po kroku, z omówieniem.' },
  { t:'Sprawdź się quizem', d:'Informację zwrotną dostajesz od razu po odpowiedzi.' },
];

const FAQS = [
  { q:"Co to jest Unicorner?",
    a:"Zbiór materiałów do egzaminów: fiszki, zadania z omówieniem krok po kroku i quizy z natychmiastową informacją zwrotną. Wszystko w jednym miejscu, bez opłat i bez reklam. Materiały otwierasz bez logowania; konto (logowanie przez Google) jest potrzebne tylko w generatorze AI. Działa w przeglądarce, na telefonie i na komputerze. Pomysł jest prosty: chcesz się nauczyć jednego przedmiotu — otwierasz zakładkę i się uczysz." },
  { q:"Czy to oficjalna strona UEP?",
    a:"<b>Nie.</b> To projekt studencki, niepowiązany z uczelnią, żadną katedrą ani konkretnym wykładowcą. Robiony przez studentów, dla studentów. Wszystkie materiały to nasze własne opracowania — nie znajdziesz tu prezentacji ani skanów notatek wykładowców." },
  { q:"Skąd biorą się materiały?",
    a:"To <b>nasze własne opracowania</b> na bazie zajęć, notatek i literatury — układane pod to, co realnie sprawdzają na kolokwiach i egzaminach. Traktuj Unicornera jako dodatek do nauki i szybką powtórkę przed egzaminem, a nie zamiennik oryginalnych źródeł. Slajdów i skryptów z UEP tu nie kopiujemy." },
  { q:"Czy to darmowe?",
    a:"Tak. Materiały są za darmo i bez reklam, a do nich nie potrzebujesz konta. Generator AI też jest darmowy: co miesiąc dostajesz pulę kredytów, a ile zostało, widzisz w generatorze. Nie mamy płatnej wersji i nie sprzedajemy danych. Adres e-mail mamy tylko wtedy, gdy sam go dasz: przy logowaniu do generatora (przekazuje go Google) albo przy zapisie na powiadomienia o nowych materiałach. Szczegóły są w <a href=\"prywatnosc.html\">polityce prywatności</a>. Cały projekt utrzymujemy sami, bo sami się z niego uczymy." },
  { q:"Czy postęp się zapisuje?",
    a:"Tak, ale tylko lokalnie. W quizach i fiszkach postęp (co odznaczyłeś jako „Umiem”, jaki masz wynik quizu) trzymany jest w Twojej przeglądarce (localStorage). Ten postęp nie trafia na żaden serwer. Wyczyścisz dane przeglądarki lub otworzysz stronę w trybie incognito — zacznie się od zera, a między dwoma urządzeniami się nie zsynchronizuje. Wyjątek to generator AI: talie i postęp w nich zapisują się na Twoim koncie, więc po zalogowaniu widzisz je na każdym urządzeniu." }
];

// Czytelnia: liczby i po jednym tekście z każdego działu, prosto z danych artykułów.
const artykuly = getArticles();
const wiedzaGodz = Math.round(artykuly.reduce((s,a)=>s+a.minutes,0) / 60);
const polecane = CATEGORIES.map(c => artykuly.find(a => a.category === c.id)).filter(Boolean);

const NAV = [['Przedmioty', '#przedmioty'], ['Generator', '#generator'], ['Wiedza', '#wiedza'], ['FAQ', '#faq']];
---

<Base>
<script is:inline>
/* Klasy startowe: `js` (animacje wolno ukrywać treść przed wejściem), `rm` (system prosi o mniej ruchu).
   Gdyby główny skrypt strony nie ruszył w 3,5 s, `bez-anim` pokazuje wszystko od razu. */
(function(d){var h=d.documentElement;h.classList.add('js');try{if(matchMedia('(prefers-reduced-motion: reduce)').matches)h.classList.add('rm');}catch(e){}
setTimeout(function(){if(!h.classList.contains('gotowe'))h.classList.add('bez-anim');},3500);})(document);
</script>

<svg class="defs" width="0" height="0" aria-hidden="true">
  <defs>
    <symbol id="i-strz" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  </defs>
</svg>

<!-- Tło całej strony: neonowa siatka (oczko 38 px jak dotąd) i światło kursora, które ją rozjaśnia. -->
<div class="tlo" aria-hidden="true">
  <div class="tlo-siatka"></div>
  <div class="swiatlo" data-swiatlo><div class="sw-siatka"></div></div>
</div>

<header class="nav" data-nav>
  <a class="marka" href="#top" aria-label="Unicorner, początek strony" data-marka>UNICORNER</a>
  <nav class="nav-linki" aria-label="Sekcje strony">
    {NAV.map(([t, h]) => <a href={h}>{t}</a>)}
  </nav>
  <div class="nav-kon">
    <a class="btn btn-pelny nav-cta" href="#przedmioty">Zacznij naukę</a>
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" data-menu-otworz>
      <span class="menu-ik" aria-hidden="true"><i></i><i></i></span><span>Menu</span>
    </button>
  </div>
</header>

<dialog class="menu" id="menu" aria-label="Menu strony">
  <button class="menu-zamknij" type="button" data-menu-zamknij>Zamknij</button>
  <nav aria-label="Sekcje strony">
    {NAV.map(([t, h]) => <a href={h} data-menu-link>{t}</a>)}
    <a href="kontakt.html">Kontakt</a>
  </nav>
  <p class="menu-stopa">Fiszki, zadania i quizy do egzaminów. Bez logowania.</p>
</dialog>

<main id="main">

  <!-- ===== HERO: neonowy napis w ramce HUD. Przy przewijaniu napis zmniejsza się i wlatuje do nawigacji. ===== -->
  <div class="hero-wrap" id="top" data-hero>
    <section class="hero" aria-labelledby="hero-t">
      <div class="podloga h-podloga" aria-hidden="true"><i data-podloga></i></div>
      <div class="h-srodek">
        <div class="h-rama" aria-hidden="true">
          <i class="r-lg"></i><i class="r-pg"></i><i class="r-ld"></i><i class="r-pd"></i>
          <span class="e-lg">unicorner_os</span>
          <span class="e-pg"><b></b>system online</span>
          <span class="e-ld">{countText}</span>
          <span class="e-pd">bez logowania</span>
        </div>
        <div class="napis-scena" data-napis>
          <h1 class="napis-t" id="hero-t" aria-label="Unicorner">UNICORNER</h1>
          <canvas class="napis-gl" aria-hidden="true"></canvas>
        </div>
      </div>
      <div class="wrap h-dol">
        <div class="h-tekst">
          <p class="h-haslo" data-szyfr>Edukacja po ludzku.</p>
          <p class="h-lid">Fiszki, zadania i quizy do egzaminów. Jedno miejsce, cała Twoja nauka.</p>
        </div>
        <div class="h-akcje">
          <a class="btn btn-pelny btn-duzy" href="#przedmioty">Zacznij naukę <svg class="ik" aria-hidden="true"><use href="#i-strz"/></svg></a>
          <a class="lacze" href="#generator">Albo zrób fiszki z własnych notatek</a>
        </div>
      </div>
    </section>
  </div>

  <!-- ===== PRZEDMIOTY: karty z poświatą, która sunie za kursorem ===== -->
  <section class="sek sek-przedmioty" id="przedmioty" aria-labelledby="przedmioty-h">
    <div class="wrap">
      <h2 class="tytul" id="przedmioty-h" data-tytul data-t="Przedmioty">Przedmioty</h2>
      <p class="sek-dop"><b>{countText}</b>. Wybierz swój, otwiera się od razu.</p>
      <div class="karty" data-poswiata data-wejscie>
        {SUBJECTS.map((s, i) => (
          <a class:list={['karta', 'pw', { przyszla: s.status !== 'live', boss: s.boss }]} href={s.file} style={`--d:${opoznienie(i)}ms`}>
            <span class="k-srodek">
              <span class="k-gora">
                <span class="k-ikona" aria-hidden="true">{s.emoji}</span>
                <span class:list={['k-stan', { budowa: s.badge, wkrotce: s.status !== 'live' }]}>{s.badge || (s.status === 'live' ? 'gotowe' : 'wkrótce')}</span>
              </span>
              <span class="k-nazwa">{s.name}{s.sub && <span class="k-sub">{s.sub}</span>}</span>
              <span class="k-opis">{s.desc}</span>
              <span class="k-tagi">{s.tags.map((t) => <span>{t}</span>)}</span>
              <span class="k-idz">{s.status === 'live' ? 'Otwórz' : 'Napisz do nas'} <svg class="ik" aria-hidden="true"><use href="#i-strz"/></svg></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PO CO: zdanie dekodowane scrollem + cztery kroki ===== -->
  <section class="sek sek-po-co" aria-labelledby="po-co-h">
    <div class="wrap">
      <h2 class="zdanie" id="po-co-h" data-zdanie>
        {slowa.map((s, i) => <><span class="s">{s}</span>{i < slowa.length - 1 ? ' ' : ''}</>)}
      </h2>

      <div class="kroki-blok" data-kroki>
        <h3 class="etykieta">Jak korzystać</h3>
        <div class="szyna" aria-hidden="true"><i></i></div>
        <ol class="kroki" data-poswiata>
          {KROKI.map((k, i) => (
            <li class="pw">
              <span class="k-srodek">
                <span class="kr-nr">0{i + 1}</span>
                <span class="kr-t">{k.t}</span>
                <span class="kr-d">{k.d}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="kroki-stopka">Postęp zapisuje się w Twojej przeglądarce. To nasze własne opracowania na bazie zajęć: robimy je, bo sami się z nich uczymy.</p>
      </div>
    </div>
  </section>

  <!-- ===== GENERATOR: okno, w którym notatki zamieniają się w fiszkę i quiz (sterowane scrollem) ===== -->
  <section class="sek sek-gen" id="generator" aria-labelledby="gen-h">
    <div class="wrap">
      <h2 class="tytul" id="gen-h" data-tytul data-t="Generator">Generator</h2>
      <div class="gen-siatka">
        <div class="gen-tekst">
          <p class="etykieta">Generator AI <span class="et-stan">beta</span></p>
          <p class="gen-haslo">Twoje notatki. Gotowa nauka.</p>
          <p class="lid">Wrzuć PDF z wykładu, zdjęcia notatek albo wklej tekst. AI ułoży z tego fiszki i quiz z wyjaśnieniami i skupi się na tym, o co poprosisz.</p>
          <ul class="gen-wejscia" aria-label="Co możesz wrzucić">
            <li>PDF</li><li>Zdjęcia notatek</li><li>Wklejony tekst</li>
          </ul>
          <a class="btn btn-pelny btn-duzy" href="generator.html">Otwórz generator <svg class="ik" aria-hidden="true"><use href="#i-strz"/></svg></a>
        </div>
        <div class="okno" data-demo aria-hidden="true">
          <div class="o-belka"><span>notatki.pdf</span><i></i><span>fiszki + quiz</span></div>
          <div class="o-cialo">
            <div class="o-notatki">
              <i style="--w:92%"></i><i style="--w:74%"></i><i style="--w:86%"></i><i style="--w:52%"></i><i style="--w:88%"></i><i style="--w:68%"></i><i style="--w:80%"></i><i style="--w:44%"></i><i style="--w:90%"></i><i style="--w:61%"></i>
              <span class="o-skan"></span>
            </div>
            <div class="o-wynik">
              <div class="o-fiszka"><div class="o-obrot">
                <span class="o-strona o-przod"><small>fiszka</small>Koszt alternatywny</span>
                <span class="o-strona o-tyl">Wartość najlepszej opcji, z której rezygnujesz, wybierając inną.</span>
              </div></div>
              <div class="o-quiz">
                <span class="o-qn">Pytanie 3 z 10</span>
                <span class="o-opt">Popyt rośnie przy wzroście ceny</span>
                <span class="o-opt o-ok">Popyt spada przy wzroście ceny</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WIEDZA ===== -->
  <section class="sek sek-wiedza" id="wiedza" aria-labelledby="wiedza-h">
    <div class="wrap">
      <h2 class="tytul" id="wiedza-h" data-tytul data-t="Wiedza">Wiedza</h2>
      <div class="wiedza-siatka">
        <div class="wiedza-tekst">
          <p class="gen-haslo">Teksty, które sprawdzają fakty.</p>
          <p class="lid">Świat i technika, zdrowie, polska polityka i krypto. Długie rozbiory tematów oparte na źródłach, z faktami oddzielonymi od zarzutów.</p>
          <p class="wiedza-liczby">{artykuly.length} {odmiana(artykuly.length, 'tekst', 'teksty', 'tekstów')}, około {wiedzaGodz} {odmiana(wiedzaGodz, 'godzina', 'godziny', 'godzin')} czytania</p>
          <a class="btn btn-ramka btn-duzy" href="wiedza.html"><span>Przejdź do czytelni <svg class="ik" aria-hidden="true"><use href="#i-strz"/></svg></span></a>
        </div>
        <ul class="teksty" data-poswiata>
          {polecane.map((a) => (
            <li><a class="pw tekst-w" href={a.url.replace(/^\//, '')}><span class="k-srodek">
              <span class="t-dzial">{a.categoryName}</span>
              <span class="t-tyt">{a.topic || a.title}</span>
              <span class="t-min">ok. {a.minutes} min</span>
            </span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="sek sek-faq" id="faq" aria-labelledby="faq-h">
    <div class="wrap">
      <h2 class="tytul" id="faq-h" data-tytul data-t="FAQ">FAQ</h2>
      <div class="faq-siatka">
        <div class="faq-lista">
          {FAQS.map((f) => (
            <details name="faq">
              <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
              <div class="faq-odp"><p set:html={f.a}></p></div>
            </details>
          ))}
        </div>
        <div class="brak">
          <h3>Brakuje przedmiotu?</h3>
          <p>Masz przedmiot, który chciałbyś tu zobaczyć? Daj znać. Możesz też podesłać własne notatki lub materiały — dobre wrzucę na stronę.</p>
          <a class="lacze" href="kontakt.html">Napisz do nas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== OPINIE: wczytywane z Workera (albo z reviews.json), sekcja pojawia się po wczytaniu ===== -->
  <section class="sek sek-opinie" id="reviews" hidden aria-labelledby="opinie-h">
    <div class="wrap opinie-glowa">
      <h2 class="etykieta etykieta-duza" id="opinie-h">Opinie</h2>
      <a class="btn btn-ramka" href="recenzje.html"><span>Zostaw opinię</span></a>
    </div>
    <div class="karuzela"><div class="karuzela-tor" id="reviewTrack"></div></div>
  </section>
</main>

<!-- ===== STOPKA: wielki neonowy napis nad podłogą z siatki, jak dotąd ===== -->
<footer class="stopka" data-stopka>
  <div class="podloga st-podloga" aria-hidden="true"><i data-podloga></i></div>
  <div class="st-hero">
    <p class="st-status"><b></b>unicorner_os · system online</p>
    <p class="st-napis" aria-label="Unicorner"><span data-text="UNICORNER">UNICORNER</span></p>
    <p class="st-haslo">Wszystkie materiały do egzaminów — w jednym miejscu.</p>
  </div>
  <div class="wrap st-prawne">
    <div class="st-lewa">
