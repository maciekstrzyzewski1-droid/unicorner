---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import Dither from '../components/Dither.jsx';
import Shuffle from '../components/Shuffle.jsx';
---

<Base>
<div class="glow-drift" aria-hidden="true"></div>
<div class="site-grid" id="siteGrid"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#27e8ff"/><stop offset="0.38" stop-color="#a78bfa"/>
      <stop offset="0.72" stop-color="#ff2e97"/><stop offset="1" stop-color="#ffd84a"/>
    </linearGradient>
  </defs>
</svg>

<!-- ===== INTRO: czaszka x-ray + panorama (skull-hero -> pan klub->nauka) ===== -->
<!-- Model 3D szkieletu: "three-skull" (Cullen Webber) — licencja MIT. -->
<div class="hero-screen" id="heroScreen">
  <div class="liquid-bg" id="liquidBars"><Dither client:load waveColor={[0.55, 0.35, 0.95]} colorNum={4} pixelSize={2} waveAmplitude={0.4} waveFrequency={3} waveSpeed={0.04} enableMouseInteraction={true} mouseRadius={0.39} /></div>
  <canvas id="gl" aria-hidden="true"></canvas>
  <div class="hero-fx"><div class="scan"></div><div class="vig"></div></div>
  <div class="title" id="hudTitle">
    <div class="eb">◢ OPEN STUDENT WORKSPACE</div>
    <Shuffle client:load text="unicorner" tag="div" className="ttl" duration={0.45} stagger={0.045} shuffleTimes={2} style={{ pointerEvents: 'auto' }} />
    <div class="sub">egzaminy ogarnięte po ludzku</div>
    <div class="meta">v.2026 · UEP · materiały do nauki</div>
    <p class="hero-lede">Fiszki, zadania krok po kroku i quizy z natychmiastową informacją zwrotną. <b>Jedno miejsce na wszystkie przedmioty</b> — bez logowania, działa na telefonie, otwierasz i się uczysz.</p>
  </div>
  <div class="telem br" id="hudTelemBR">RUSZAJ MYSZĄ ✕</div>
  <div class="skull-cap" id="hudCap">psssssst… tak skończysz, jak będziesz próbował ogarnąć materiał z podręczników. tak tylko mówię :)</div>
  <a class="scroll-hint" id="hudHint" href="#przedmioty">Zobacz, o co chodzi <span class="arr">↓</span></a>

  <!-- WIDOK 2: kula + generator (wchodzi crossfadem przy scrollu, na tym samym tunelu) -->
  <div class="gen-screen" id="genScreen">
    <div class="gen-top">
      <h2 class="aif-h gen-h">Twoje notatki.<br><span class="hl">Gotowa nauka.</span></h2>
      <p class="gen-lead">Wrzuć notatki albo PDF, a sztuczna inteligencja rozbije materiał na <b>fiszki i quiz pod Twój egzamin</b> — bez przepisywania.</p>
    </div>
    <a class="aif-launch gen-launch" id="genLaunch" href="generator.html?v=1" aria-label="Uruchom Generator AI">
      <span class="hexbtn" aria-hidden="true">
        <svg class="rings" viewBox="0 0 100 100">
          <defs><linearGradient id="hexRing" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#27e8ff"/><stop offset=".5" stop-color="#a78bfa"/><stop offset="1" stop-color="#ff2e97"/>
          </linearGradient></defs>
          <polygon class="ring" points="50,7 90,28.5 90,71.5 50,93 10,71.5 10,28.5"/>
          <polygon class="ring ring2" points="50,22 77,37 77,63 50,78 23,63 23,37"/>
        </svg>
        <svg class="chip" viewBox="0 0 48 48" fill="none">
          <rect x="16" y="16" width="16" height="16" rx="3" stroke="currentColor" stroke-width="2.4"/>
          <rect x="21" y="21" width="6" height="6" rx="1.2" fill="currentColor"/>
          <g stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M19 16v-5M24 16v-6M29 16v-5"/><path d="M19 32v5M24 32v6M29 32v5"/>
            <path d="M16 19h-5M16 24h-6M16 29h-5"/><path d="M32 19h5M32 24h6M32 29h5"/>
          </g>
        </svg>
      </span>
      <span class="lx-wrap">
        <span class="lx-tx">Uruchom generator</span>
        <span class="lx-sub">generator.html · faza beta</span>
      </span>
    </a>
  </div>
</div>
<div class="hero-spacer"></div>

<div class="wrap">
  <div class="ow" aria-hidden="true"><span>NEXT LEVEL</span></div>

  <div class="row-label" data-rev id="przedmioty"><h2>Przedmioty</h2><span class="count" id="count"></span><span class="line"></span></div>
  <div class="grid" id="grid"></div>

  <div class="about">
    <div class="item"><h4>Po co to jest</h4><p>Wkuwanie definicji rzadko wystarcza — egzaminy lubią przykłady i zastosowanie. Materiały są pod to ułożone.</p></div>
    <div class="item"><h4>Jak korzystać</h4><p>Wybierz przedmiot, przejdź fiszki, rozwiąż zadania, sprawdź się quizem. Postęp zapisuje się w przeglądarce.</p></div>
    <div class="item"><h4>Skąd się bierze</h4><p>To nasze własne opracowania na bazie zajęć. Robione, bo sami się z tego uczymy — i bo działa. Masz swoje notatki i chcesz je dorzucić? Wyślij je na <a href="mailto:unicornernotatki@gmail.com" class="ilink">unicornernotatki@gmail.com</a>.</p></div>
  </div>

  <div class="ow" aria-hidden="true"><span>LEARNING</span></div>

  <div class="row-label" data-rev><h2>FAQ</h2><span class="line"></span></div>
  <div class="faq" id="faq"></div>

  <section class="reviews" id="reviews" style="display:none">
    <div class="reviews-head">
      <span class="lbl">Opinie</span>
      <a class="btn-review" href="recenzje.html">★ Zostaw opinię</a>
    </div>
    <div class="marquee"><div class="marquee-track" id="reviewTrack"></div></div>
  </section>
</div>

<footer class="site-foot">
