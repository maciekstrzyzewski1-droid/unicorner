    .wiedza-band .grad{background:var(--iris);-webkit-background-clip:text;background-clip:text;color:transparent;}
    .wiedza-band .wb-p{color:var(--muted);max-width:640px;font-size:.95rem;}
    .wiedza-band .wb-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
    .wiedza-band .wb-tags span{font-family:var(--mono);font-size:.7rem;color:var(--muted);background:var(--ink2);border:1px solid var(--line);border-radius:3px;padding:4px 9px;}
    .wiedza-band .wb-go{font-family:var(--mono);font-weight:600;font-size:.82rem;letter-spacing:1.5px;text-transform:uppercase;margin-top:6px;}
    .wiedza-band .wb-go .arr{color:var(--cyan);display:inline-block;transition:transform .25s;}
    .wiedza-band:hover .wb-go .arr{transform:translateX(4px);}
  </style>

  <div class="ow" aria-hidden="true"><span>LEARNING</span></div>

