<script is:inline>
/* Opinie: lista z Workera, zapasowo reviews.json. Bez opinii sekcja pokazuje zaproszenie. */
(function(){
  var sekcja = document.getElementById('reviews'), tor = document.getElementById('reviewTrack');
  if (!sekcja || !tor) return;
  var spokojnie = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var esc = function(s){ return String(s).replace(/[&<>"]/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c]; }); };
  function gwiazdki(n){ n = Math.max(1, Math.min(5, Math.round(n || 5))); return '★'.repeat(n) + '☆'.repeat(5 - n); }
  function zbuduj(lista){
    var sa = Array.isArray(lista) && lista.length;
    var karta = function(r){
      return '<div class="opinia"><div class="op-gw" aria-label="' + (r.stars || 5) + ' na 5">' + gwiazdki(r.stars) + '</div>' +
        '<div class="op-tekst">' + esc(r.text || '') + '</div>' +
        '<div class="op-kto">' + esc(r.name || 'Anonim') + (r.subject ? ', ' + esc(r.subject) : '') + '</div></div>';
    };
    var pol = sa ? lista.map(karta).join('') : '<span class="op-pusto">Tu będą Wasze opinie</span>'.repeat(6);
    tor.innerHTML = spokojnie ? pol : pol + pol;
    if (!spokojnie) tor.style.animationDuration = (sa ? Math.max(20, lista.length * 7) : 30) + 's';
    sekcja.hidden = false;
  }
  var ADRES = "https://red-queen-3002.unicorner.workers.dev/reviews";
  fetch(ADRES)
    .then(function(r){ return r.ok ? r.json() : Promise.reject(); })
    .then(zbuduj)
    .catch(function(){
      fetch('reviews.json', { cache: 'no-store' })
        .then(function(r){ return r.ok ? r.json() : []; })
        .then(zbuduj)
        .catch(function(){ zbuduj([]); });
    });
})();
</script>
