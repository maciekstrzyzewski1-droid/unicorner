const grid = document.getElementById('grid');
const statParts = STAT_GROUP.parts.length;
const liveCount = SUBJECTS.filter(s=>s.status==='live').length + statParts;
document.getElementById('count').textContent =
  liveCount + (liveCount===1?' gotowy':(liveCount>=2&&liveCount<=4?' gotowe':' gotowych'));

function cardHtml(s){
  const live = s.status==='live';
  const tagHtml = s.tags.map(t=>`<span class="tag">${t}</span>`).join('');
  const inner = `
    <span class="card-glow" aria-hidden="true"></span>
    <div class="card-top"><div class="emoji">${s.emoji}</div>
    <span class="badge ${live?'live':'soon'}">${s.badge || (live?'gotowe':'wkrótce')}</span></div>
    <h3>${s.name}</h3><p class="desc">${s.desc}</p>
    <div class="tags">${tagHtml}</div>
    <span class="go">${live?'Otwórz':'W przygotowaniu'} <span class="arr">→</span></span>`;
  return live ? `<a class="card live" href="${s.file}">${inner}</a>`
              : `<div class="card soon">${inner}</div>`;
}

function statHubHtml(g){
  const links = g.parts.map(p=>`
    <a class="stat-link" href="${p.file}">
      <span class="sl-ic">${p.ic}</span>
      <span class="sl-name">${p.name}</span>
      <span class="sl-desc">${p.desc}</span>
      <span class="sl-go">Otwórz <span class="arr">→</span></span>
    </a>`).join('');
  return `<div class="stat-hub">
    <div class="stat-head">
      <div class="emoji">${g.emoji}</div>
      <div>
        <h3>${g.name} <span class="fb-tag">— FINAL BOSS</span></h3>
        <p class="desc">${g.desc}</p>
      </div>
      <span class="badge live">${g.parts.length} ${g.parts.length>=2&&g.parts.length<=4?'działy':'działów'}</span>
    </div>
    <div class="stat-divider">działy statystyki</div>
    <div class="stat-links">
      <div class="stat-shards" aria-hidden="true">
        <span class="shard"></span><span class="shard"></span><span class="shard"></span><span class="shard"></span>
        <span class="shard"></span><span class="shard"></span><span class="shard"></span><span class="shard"></span>
      </div>
      ${links}
    </div>
  </div>`;
}

const liveSubjects = SUBJECTS.filter(s=>s.status==='live');
const soonSubjects = SUBJECTS.filter(s=>s.status!=='live');
grid.innerHTML =
  liveSubjects.map(cardHtml).join('') +
  statHubHtml(STAT_GROUP);
const nextCard = document.getElementById('nextCard');
if (nextCard) nextCard.innerHTML = soonSubjects.map(cardHtml).join('');

// ===== Magic Bento: border-glow per karta (proximity) — cache rectow + rAF, bez lagu =====
(function(){
  if (matchMedia('(hover: none)').matches) return;   // pomijaj na dotyku
  const R=380, prox=R*0.5, fade=R*0.75, GLOWR=R+'px';
  const cardsSel='.card, .stat-hub';
  let cards=[], gr=null, rects=[], measured=false, mx=0, my=0, raf=0;
  function measure(){
    cards=[...grid.querySelectorAll(cardsSel)];
    gr=grid.getBoundingClientRect();
    rects=cards.map(c=>c.getBoundingClientRect());
    measured=true;
  }
  function invalidate(){ measured=false; }
  function clearGlow(){ cards.forEach(c=>c.style.setProperty('--glow-intensity','0')); }
  function apply(){
    raf=0;
    if(!measured) measure();
    if(mx<gr.left||mx>gr.right||my<gr.top||my>gr.bottom){ clearGlow(); return; }
    for(let i=0;i<cards.length;i++){
      const r=rects[i], cx=r.left+r.width/2, cy=r.top+r.height/2;
      const eff=Math.max(0, Math.hypot(mx-cx,my-cy)-Math.max(r.width,r.height)/2);
      let gi=0; if(eff<=prox) gi=1; else if(eff<=fade) gi=(fade-eff)/(fade-prox);
      const st=cards[i].style;
      st.setProperty('--glow-x', (((mx-r.left)/r.width)*100).toFixed(1)+'%');
      st.setProperty('--glow-y', (((my-r.top)/r.height)*100).toFixed(1)+'%');
      st.setProperty('--glow-intensity', gi.toFixed(3));
      st.setProperty('--glow-radius', GLOWR);
    }
  }
  function onMove(e){ mx=e.clientX; my=e.clientY; if(!raf) raf=requestAnimationFrame(apply); }
  document.addEventListener('mousemove', onMove, {passive:true});
  document.addEventListener('mouseleave', ()=>{ if(raf){cancelAnimationFrame(raf);raf=0;} if(measured) clearGlow(); });
  addEventListener('scroll', invalidate, {passive:true});
  addEventListener('resize', invalidate);
})();

const faq = document.getElementById('faq');
faq.innerHTML = FAQS.map((f,i)=>`
  <button class="faq-item" data-rev aria-expanded="false">
    <div class="faq-q"><span class="faq-ic"></span><span class="faq-t"><span class="faq-num">${String(i+1).padStart(2,'0')}</span>${f.q}</span></div>
    <div class="faq-a"><p>${f.a}</p></div>
  </button>`).join('');
faq.querySelectorAll('.faq-item').forEach(it=>{
  it.addEventListener('click',()=>{
    const open = it.classList.toggle('open');
    it.setAttribute('aria-expanded', open);
  });
});

const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
(function(){
  const targets=[...document.querySelectorAll('.card, .stat-hub, [data-rev]')];
  if(reduce){ targets.forEach(t=>t.classList.add('in')); return; }
  const groups=new Map();
  targets.forEach(t=>{
    const key=t.parentElement;
    const n=(groups.get(key)||0); groups.set(key,n+1);
    t.style.setProperty('--rev-d',(n*0.08)+'s');
    if(!t.hasAttribute('data-rev')) t.style.transitionDelay=(n*0.08)+'s';
  });
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(t=>io.observe(t));
})();

(function(){
  if(reduce || innerWidth<760) return;
  const g=document.querySelector('.glow-drift'); if(!g) return;
  let last=-1, ticking=false;
  function move(){
    const y=scrollY*0.12;
    if(y!==last){ g.style.transform='translate3d(0,'+y+'px,0)'; last=y; }
    ticking=false;
  }
  addEventListener('scroll',()=>{ if(!ticking){ ticking=true; requestAnimationFrame(move); } },{passive:true});
})();

const escR = s => String(s).replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c]));
function starRow(n){ n=Math.max(1,Math.min(5,Math.round(n||5))); return '★'.repeat(n)+'☆'.repeat(5-n); }
function buildReviews(list){
  const track = document.getElementById('reviewTrack');
  const has = Array.isArray(list) && list.length;
  const chip = r => `<div class="review-chip">
      <div class="stars" aria-label="${(r.stars||5)} na 5">${starRow(r.stars)}</div>
      <div class="rtext">${escR(r.text||'')}</div>
      <div class="rname">— <b>${escR(r.name||'Anonim')}</b>${r.subject?' · '+escR(r.subject):''}</div>
    </div>`;
  const half = has
    ? list.map(chip).join('')
    : '<span class="rev-ph">✦ Tu będą Wasze opinie ✦</span>'.repeat(6);
  track.innerHTML = reduce ? half : half + half;
  if(!reduce){ track.style.animationDuration = (has ? Math.max(20, list.length*7) : 30) + 's'; }
  document.getElementById('reviews').style.display = 'block';
}
const REVIEWS_URL = "https://red-queen-3002.unicorner.workers.dev/reviews";
fetch(REVIEWS_URL)
  .then(r=>r.ok?r.json():Promise.reject())
  .then(buildReviews)
  .catch(()=>fetch('reviews.json',{cache:'no-store'})
    .then(r=>r.ok?r.json():[])
    .then(buildReviews)
    .catch(()=>buildReviews([])));

</script>

<script is:inline>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.ow'));
  if (!els.length) return;
  var tick = false;
  function upd(){
    tick = false;
    var vh = window.innerHeight;
    for (var i = 0; i < els.length; i++){
      var r = els[i].getBoundingClientRect();
      if (r.bottom < 0 || r.top > vh) continue;
      var p = (r.top + r.height/2 - vh/2) / (vh/2 + r.height/2);
      els[i].firstElementChild.style.transform = 'translateX(' + (p * (i % 2 ? -14 : 14)).toFixed(2) + 'vw)';
    }
  }
  window.addEventListener('scroll', function(){ if(!tick){ tick = true; requestAnimationFrame(upd); } }, {passive:true});
  window.addEventListener('resize', upd);
  upd();
})();

</script>

<script is:inline>
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var GL = "ΞΔΣΨΩλØ¥§¤µ†‡/\\|=+<>^?#%$@01".split("");
  function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function glyph(){ return GL[(Math.random() * GL.length) | 0]; }
  function run(el) {
    var full = el.getAttribute('data-final') || el.textContent;
    el.setAttribute('data-final', full);
    var n = full.length, start = null;
    var per = n > 100 ? 12 : (n > 16 ? 26 : 40);
    var flash = 150;
    var win = 6;
    function frame(ts) {
      if (start === null) start = ts;
      var t = ts - start, out = '', done = true, i, front = t / per;
      for (i = 0; i < n; i++) {
        var ch = full[i], rt = i * per;
        if (ch === ' ') { out += ' '; continue; }
        if (t >= rt + flash) { out += esc(ch); }
        else if (t >= rt) { out += '<span class="rz">' + esc(ch) + '</span>'; done = false; }
        else { done = false; out += (i < front + win) ? '<span class="scr">' + glyph() + '</span>' : ''; }
      }
      el.innerHTML = out + (done ? '' : '<span class="cursor">▍</span>');
      if (!done) requestAnimationFrame(frame); else el.textContent = full;
    }
    requestAnimationFrame(frame);
  }
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
  }, { threshold: .3 });
  document.querySelectorAll('[data-scramble]').forEach(function (el) { io.observe(el); });
})();

</script>

<script is:inline>
/* Pierwszy ekran przy przewijaniu: jedzie w górę (paralaksa) i wygasza się od dołu maską; pojawia się siatka tła.
   (Dawniej w scenie three.js z tunelem i kulą; scena nic nie rysowała, bo widok kuli był wyłączony.) */
(function(){
  var hero=document.getElementById('heroScreen'), grid=document.getElementById('siteGrid');
  if(!hero) return;
  var c=function(v,a,b){ return Math.min(Math.max(v,a),b); };
  function alignGrid(){ if(!grid) return; var f=document.querySelector('.site-foot'); var r=f&&f.getBoundingClientRect();
    var cx=r?(r.left+r.width/2):innerWidth/2; grid.style.setProperty('--gx', ((((cx%38)+38)%38)).toFixed(1)+'px'); }
  function upd(){
    var vh=innerHeight, s=scrollY;
    var ep=c((s - vh*0.15)/(vh*1.05), 0, 1);
    hero.style.opacity='1';
    hero.style.transform='translateY(' + (-(s*0.4)).toFixed(1) + 'px)';
    var fs=Math.max(0, 100 - Math.round(c(s/(vh*1.2), 0, 1)*100));
    var mask='linear-gradient(to bottom, #000 ' + fs + '%, rgba(0,0,0,0) 100%)';
    hero.style.webkitMaskImage=mask; hero.style.maskImage=mask;
    hero.style.pointerEvents = ep>0.5 ? 'none' : 'auto';
    if(grid) grid.style.opacity=(ep*0.9).toFixed(3);
  }
  var tick=false;
  addEventListener('scroll', function(){ if(!tick){ tick=true; requestAnimationFrame(function(){ tick=false; upd(); }); } }, {passive:true});
  addEventListener('resize', function(){ alignGrid(); upd(); });
  alignGrid(); upd();
})();
</script>
