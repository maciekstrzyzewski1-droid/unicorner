        <path d="M700 380 H620 V404" fill="none" stroke="#a78bfa" stroke-opacity=".3"/>
        <g fill="none" stroke="#a78bfa" stroke-opacity=".2">
          <circle cx="470" cy="215" r="120"/><circle cx="470" cy="215" r="168"/>
          <circle cx="470" cy="215" r="72" stroke-dasharray="3 7"/>
        </g>
        <g stroke="#3b3560">
          <line x1="60" y1="196" x2="60" y2="330"/>
          <line x1="55" y1="196" x2="66" y2="196"/><line x1="55" y1="240" x2="66" y2="240"/>
          <line x1="58" y1="218" x2="64" y2="218"/><line x1="55" y1="286" x2="66" y2="286"/>
          <line x1="58" y1="262" x2="64" y2="262"/><line x1="55" y1="330" x2="66" y2="330"/>
        </g>
        <g class="uf-haz" stroke="#bd8bff" stroke-opacity=".85" stroke-width="6">
          <line x1="200" y1="404" x2="228" y2="374"/><line x1="220" y1="404" x2="248" y2="374"/>
          <line x1="240" y1="404" x2="268" y2="374"/>
        </g>
        <path d="M300 96 V130 H392 V186 H470" fill="none" stroke="#27e8ff" stroke-opacity=".3"/>
        <circle cx="470" cy="186" r="3" fill="#27e8ff" fill-opacity=".65"/>
        <path d="M20 250 H96 V318 H176" fill="none" stroke="#a78bfa" stroke-opacity=".25"/>
        <circle cx="176" cy="318" r="2.5" fill="#a78bfa" fill-opacity=".5"/>
      </svg>
      <div class="uf-read">
        <div>NODE <b>UNICORNER</b> / PL</div>
        <div>STATUS <b>&#9679; ONLINE</b></div>
        <div>SESJA <span class="mg">0xA7-2F9</span></div>
      </div>
      <div class="uf-eq" id="ufEq"></div>
    </div>

    <div class="uf-clip" aria-hidden="true">
      <video id="ufClip" src="assets/unicorn-loop.mp4" muted loop playsinline autoplay preload="auto"></video>
    </div>

    <div class="giant">
      <span class="gw" data-text="UNICORNER">UNICORNER</span>
      <span class="giant-scan" aria-hidden="true"></span>
    </div>
    <p class="uf-sub">materiały do nauki</p>
  </div>

  <div class="wrap foot-simple">
    <div class="foot-grid">
      <div class="foot-note">
        <p><b>Projekt studencki.</b> Niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu ani z żadną katedrą.</p>
        <p>Wszystkie materiały to nasze własne opracowania — nie udostępniamy tu prezentacji ani materiałów wykładowców.</p>
        <p>Opinie są dobrowolne; publikujemy podane imię i treść, nie zbieramy adresów e-mail.</p>
        <p>Bez gwarancji kompletności — ucz się też z oryginalnych źródeł.</p>
        <p>Model 3D szkieletu w intro: „three-skull" (Cullen Webber) — licencja MIT.</p>
      </div>
      <div class="foot-side">
        <div class="foot-brand">
          <svg class="horn" style="animation:none" viewBox="0 0 24 24" aria-hidden="true"><path class="seg" d="M12 1 L15 22 H9 Z"/></svg>
          <span><span class="fb-uni">uni</span><span class="fb-corner">corner</span></span>
        </div>
        <p class="foot-sys">© 2026 unicorner · system online</p>
      </div>
    </div>
  </div>
</footer>


<script is:inline>
/* footer equalizer + motion guard */
(function(){
  var eq = document.getElementById('ufEq');
  var clip = document.getElementById('ufClip');
  var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (eq && !calm) {
    var N = 46, html = '';
    for (var i = 0; i < N; i++) {
      var t = i / (N - 1), col;
      if (t < .5) col = 'rgba(' + (167 + 88 * t * 2 | 0) + ',' + (139 - 93 * t * 2 | 0) + ',' + (250 - 99 * t * 2 | 0) + ',.9)';
      else        col = 'rgba(' + (255 - 216 * (t - .5) * 2 | 0) + ',' + (46 + 186 * (t - .5) * 2 | 0) + ',' + (151 + 104 * (t - .5) * 2 | 0) + ',.9)';
      html += '<i style="height:' + (14 + Math.random() * 20 | 0) + 'px;background:' + col +
              ';box-shadow:0 0 6px ' + col + ';--d:' + (.5 + Math.random() * .9).toFixed(2) +
              's;--dl:' + (Math.random() * .8).toFixed(2) + 's;--lo:' + (.15 + Math.random() * .35).toFixed(2) + '"></i>';
    }
    eq.innerHTML = html;
  }
  if (clip) {
    if (calm) {
      clip.removeAttribute('autoplay'); clip.pause();
      /* wymuś dekodowanie i pokazanie pierwszej klatki, mimo braku odtwarzania —
         bez tego mix-blend-mode:screen renderuje pustą klatkę jako całkowicie niewidoczną */
      clip.addEventListener('loadeddata', function(){ clip.currentTime = 0.1; }, { once:true });
      if (clip.readyState >= 2) clip.currentTime = 0.1;
    }
    else {
      var p = clip.play(); if (p && p.catch) p.catch(function(){});
      /* don't decode video while the footer is off-screen */
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function(es){
          es.forEach(function(e){
            if (e.isIntersecting) { var q = clip.play(); if (q && q.catch) q.catch(function(){}); }
            else clip.pause();
          });
        }, { rootMargin: '200px' }).observe(clip);
      }
    }
  }
})();

</script>

<script is:inline>
const SUBJECTS = [
  { name:"Makroekonomia", emoji:"📈",
    desc:"Pieniądz, inflacja, bezrobocie, wzrost, cykl koniunkturalny i polityka banku centralnego.",
    tags:["Fiszki","Zadania","Ściana","Quiz"], status:"live", file:"makroekonomia.html" },
  { name:"Podstawy marketingu", emoji:"🎯",
    desc:"Reguły Cialdiniego, marketing mix (4P/7P/4C), proces decyzyjny konsumenta, segmentacja i perswazja.",
    tags:["Materiały","Quiz 55 pytań"], status:"live", file:"marketing.html" },
  { name:"Metody i Techniki Zarządzania", emoji:"⚙️",
    desc:"VUCA, narzędzia jakości, analiza przyczyn źródłowych (RCA), kreatywność i praca zespołowa.",
    tags:["Kompendium","Quiz"], status:"live", file:"mitz.html" },
  { name:"Zarządzanie Jakością", emoji:"🏅",
    desc:"Ewolucja QI→QC→QA→TQM, guru jakości, 7 zasad ISO, TQM/Lean/Six Sigma, normalizacja, ISO 9001, akredytacja i koszty jakości.",
    tags:["Kompendium","Quiz 100 pytań"], status:"live", file:"zarzadzanie-jakoscia.html" },
  { name:"Ekonomika Turystyki i Rekreacji", emoji:"🧳",
    desc:"Rynek turystyczny, produkt, podaż, turystyka międzynarodowa i gospodarka turystyczna.",
    tags:["Kompendium","Quiz 44 pytania"], status:"live", file:"etir.html" },
  { name:"Obsługa Ruchu Turystycznego", emoji:"🧭",
    desc:"Ruch turystyczny, rodzaje turystyki, obsługa na etapach podróży, organizacja imprez, praca pilota i przewodnika.",
    tags:["Kompendium","Quiz 41 pytań"], status:"live", file:"ort.html" },
  { name:"Geografia atrakcji turystycznych", emoji:"🗺️",
    desc:"Środowisko przyrodnicze sześciu kontynentów — góry, rzeki, jeziora, wulkany, pustynie i rekordy natury.",
    tags:["6 kontynentów","Quiz 40 pytań"], status:"live", file:"geografia.html" },
  { name:"Kolejne przedmioty", emoji:"✦",
    desc:"Dochodzą po kolei. Masz przedmiot, który chcesz tu zobaczyć następny? Daj znać.",
    tags:["Wkrótce"], status:"soon", file:null }
];

const STAT_GROUP = {
  name:"Statystyka",
  emoji:"📊",
  desc:"Powiązane działy w jednym miejscu — od miar opisowych, przez dynamikę i szeregi czasowe, po korelację i regresję. Kompletny materiał ze statystyki.",
  parts:[
    { ic:"📊", name:"Statystyka opisowa", file:"statystyka.html",
      desc:"Miary średnie, pozycyjne i zróżnicowania, asymetria i koncentracja." },
    { ic:"📉", name:"Analiza dynamiki", file:"dynamika.html",
      desc:"Przyrosty, indeksy indywidualne i agregatowe (Laspeyres, Paasche, Fisher)." },
    { ic:"📐", name:"Tendencja rozwojowa", file:"trend.html",
      desc:"Szeregi czasowe, trend liniowy (MNK), dopasowanie R²/φ², prognozowanie." },
    { ic:"🌊", name:"Sezonowość", file:"sezonowosc.html",
      desc:"Wahania sezonowe, wskaźniki sezonowości i prognozowanie szeregów czasowych." },
    { ic:"🔗", name:"Analiza korelacji", file:"korelacja.html",
      desc:"Współczynnik Pearsona i korelacja rang Spearmana, siła i kierunek zależności." },
    { ic:"📈", name:"Analiza regresji", file:"regresja.html",
      desc:"Model Y=a+bX, metoda najmniejszych kwadratów, R² i φ², prognozowanie." },
    { ic:"🧮", name:"Korelacja wieloraka", file:"korelacja-wieloraka.html",
      desc:"Korelacja cząstkowa i wieloraka, współczynnik R i determinacja R²." },
    { ic:"📝", name:"Statystyka — kurs Navoica + AI", file:"Statystyka_Navoica_Egzamin.html",
      desc:"Indeksy, trend, sezonowość, korelacja i regresja — pytania wprost z testów Navoica, quiz 70 pytań." }
  ]
};

const FAQS = [
  { q:"Co to jest Unicorner?",
    a:"Zbiór materiałów do egzaminów: fiszki, zadania z omówieniem krok po kroku i quizy z natychmiastową informacją zwrotną. Wszystko w jednym miejscu — bez logowania, bez opłat, bez reklam. Działa w przeglądarce, na telefonie i na komputerze. Pomysł jest prosty: chcesz się nauczyć jednego przedmiotu — otwierasz zakładkę i się uczysz." },
  { q:"Czy to oficjalna strona UEP?",
    a:"<b>Nie.</b> To projekt studencki, niepowiązany z uczelnią, żadną katedrą ani konkretnym wykładowcą. Robiony przez studentów, dla studentów. Wszystkie materiały to nasze własne opracowania — nie znajdziesz tu prezentacji ani skanów notatek wykładowców." },
  { q:"Skąd biorą się materiały?",
    a:"To <b>nasze własne opracowania</b> na bazie zajęć, notatek i literatury — układane pod to, co realnie sprawdzają na kolokwiach i egzaminach. Traktuj Unicornera jako dodatek do nauki i szybką powtórkę przed egzaminem, a nie zamiennik oryginalnych źródeł. Slajdów i skryptów z UEP tu nie kopiujemy." },
  { q:"Czy to darmowe?",
    a:"Tak. Otwierasz i się uczysz — bez kont, bez opłat, bez reklam. Nie zbieramy adresów e-mail, nie sprzedajemy danych, nie mamy żadnego produktu premium. Cały projekt utrzymujemy sami, bo sami się z niego uczymy." },
  { q:"Czy postęp się zapisuje?",
    a:"Tak, ale tylko lokalnie. W quizach i fiszkach postęp (co odznaczyłeś jako „Umiem\", jaki masz wynik quizu) trzymany jest w Twojej przeglądarce (localStorage). Nic nie wysyłamy na żaden serwer. Wyczyścisz dane przeglądarki lub otworzysz stronę w trybie incognito — zacznie się od zera. Jeśli chcesz uczyć się na dwóch urządzeniach, postęp się między nimi nie zsynchronizuje." },
  { q:"Mam własne notatki albo materiały — jak je dorzucić?",
    a:"Wyślij mi je na <a href=\"mailto:unicornernotatki@gmail.com\" style=\"color:var(--cyan);text-decoration:none;border-bottom:1px dashed rgba(39,232,255,.4);\">unicornernotatki@gmail.com</a>. Notatki, skany, skrypty, opracowania — cokolwiek. Jeżeli materiał jest dobrej jakości, dorzucę go do odpowiedniego przedmiotu albo zrobię z niego osobną zakładkę. Jak nie masz notatek, ale znasz przedmiot, który powinien tu być — też się odezwij." }
];

const grid = document.getElementById('grid');
const statParts = STAT_GROUP.parts.length;
const liveCount = SUBJECTS.filter(s=>s.status==='live').length + statParts;
document.getElementById('count').textContent =
  liveCount + (liveCount===1?' gotowy':(liveCount>=2&&liveCount<=4?' gotowe':' gotowych'));

function cardHtml(s){
  const live = s.status==='live';
  const tagHtml = s.tags.map(t=>`<span class="tag">${t}</span>`).join('');
  const inner = `
    <div class="card-top"><div class="emoji">${s.emoji}</div>
    <span class="badge ${live?'live':'soon'}">${s.badge || (live?'gotowe':'wkrótce')}</span></div>
    <h3>${s.name}</h3><p class="desc">${s.desc}</p>
    <div class="tags">${tagHtml}</div>
    <span class="go">${live?'Otwórz':'W przygotowaniu'} <span class="arr">→</span></span>`;
  return live ? `<a class="card live" href="${s.file}">${inner}</a>`
              : `<div class="card soon">${inner}</div>`;
}

function statHubHtml(g){
  const links = g.parts.map(p=>`
    <a class="stat-link" href="${p.file}">
      <span class="sl-ic">${p.ic}</span>
      <span class="sl-name">${p.name}</span>
      <span class="sl-desc">${p.desc}</span>
      <span class="sl-go">Otwórz <span class="arr">→</span></span>
    </a>`).join('');
  return `<div class="stat-hub">
    <div class="stat-head">
      <div class="emoji">${g.emoji}</div>
      <div>
        <h3>${g.name} <span class="fb-tag">— FINAL BOSS</span></h3>
        <p class="desc">${g.desc}</p>
      </div>
      <span class="badge live">${g.parts.length} ${g.parts.length>=2&&g.parts.length<=4?'działy':'działów'}</span>
    </div>
    <div class="stat-divider">działy statystyki</div>
    <div class="stat-links">
      <div class="stat-shards" aria-hidden="true">
        <span class="shard"></span><span class="shard"></span><span class="shard"></span><span class="shard"></span>
        <span class="shard"></span><span class="shard"></span><span class="shard"></span><span class="shard"></span>
      </div>
      ${links}
    </div>
  </div>`;
}

const liveSubjects = SUBJECTS.filter(s=>s.status==='live');
const soonSubjects = SUBJECTS.filter(s=>s.status!=='live');
grid.innerHTML =
  liveSubjects.map(cardHtml).join('') +
  statHubHtml(STAT_GROUP) +
  soonSubjects.map(cardHtml).join('');

const faq = document.getElementById('faq');
faq.innerHTML = FAQS.map((f,i)=>`
  <button class="faq-item" data-rev aria-expanded="false">
    <div class="faq-q"><span class="faq-ic"></span><span class="faq-t"><span class="faq-num">${String(i+1).padStart(2,'0')}</span>${f.q}</span></div>
    <div class="faq-a"><p>${f.a}</p></div>
  </button>`).join('');
faq.querySelectorAll('.faq-item').forEach(it=>{
  it.addEventListener('click',()=>{
    const open = it.classList.toggle('open');
    it.setAttribute('aria-expanded', open);
  });
});

const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
(function(){
  const targets=[...document.querySelectorAll('.card, .stat-hub, [data-rev]')];
  if(reduce){ targets.forEach(t=>t.classList.add('in')); return; }
  const groups=new Map();
  targets.forEach(t=>{
    const key=t.parentElement;
    const n=(groups.get(key)||0); groups.set(key,n+1);
    t.style.setProperty('--rev-d',(n*0.08)+'s');
    if(!t.hasAttribute('data-rev')) t.style.transitionDelay=(n*0.08)+'s';
  });
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(t=>io.observe(t));
})();

(function(){
  if(reduce || innerWidth<760) return;
  const g=document.querySelector('.glow-drift'); if(!g) return;
  let last=-1, ticking=false;
  function move(){
    const y=scrollY*0.12;
    if(y!==last){ g.style.transform='translate3d(0,'+y+'px,0)'; last=y; }
    ticking=false;
  }
  addEventListener('scroll',()=>{ if(!ticking){ ticking=true; requestAnimationFrame(move); } },{passive:true});
})();

const escR = s => String(s).replace(/[&<>"]/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c]));
function starRow(n){ n=Math.max(1,Math.min(5,Math.round(n||5))); return '★'.repeat(n)+'☆'.repeat(5-n); }
function buildReviews(list){
  const track = document.getElementById('reviewTrack');
  const has = Array.isArray(list) && list.length;
  const chip = r => `<div class="review-chip">
      <div class="stars" aria-label="${(r.stars||5)} na 5">${starRow(r.stars)}</div>
      <div class="rtext">${escR(r.text||'')}</div>
      <div class="rname">— <b>${escR(r.name||'Anonim')}</b>${r.subject?' · '+escR(r.subject):''}</div>
    </div>`;
  const half = has
    ? list.map(chip).join('')
    : '<span class="rev-ph">✦ Tu będą Wasze opinie ✦</span>'.repeat(6);
  track.innerHTML = reduce ? half : half + half;
  if(!reduce){ track.style.animationDuration = (has ? Math.max(20, list.length*7) : 30) + 's'; }
  document.getElementById('reviews').style.display = 'block';
}
const REVIEWS_URL = "https://red-queen-3002.unicorner.workers.dev/reviews";
fetch(REVIEWS_URL)
  .then(r=>r.ok?r.json():Promise.reject())
  .then(buildReviews)
  .catch(()=>fetch('reviews.json',{cache:'no-store'})
    .then(r=>r.ok?r.json():[])
    .then(buildReviews)
    .catch(()=>buildReviews([])));

</script>

<script is:inline>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.ow'));
  if (!els.length) return;
  var tick = false;
  function upd(){
    tick = false;
    var vh = window.innerHeight;
    for (var i = 0; i < els.length; i++){
      var r = els[i].getBoundingClientRect();
      if (r.bottom < 0 || r.top > vh) continue;
      var p = (r.top + r.height/2 - vh/2) / (vh/2 + r.height/2);
      els[i].firstElementChild.style.transform = 'translateX(' + (p * (i % 2 ? -14 : 14)).toFixed(2) + 'vw)';
    }
  }
  window.addEventListener('scroll', function(){ if(!tick){ tick = true; requestAnimationFrame(upd); } }, {passive:true});
  window.addEventListener('resize', upd);
  upd();
})();

