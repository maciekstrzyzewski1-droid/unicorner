---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import FaultyTerminal from '../components/FaultyTerminal.jsx';
import BorderGlow from '../components/BorderGlow.jsx';
import HeroSkull from '../components/HeroSkull.jsx';
---

<Base>
<div class="glow-drift" aria-hidden="true"></div>
<div class="site-grid" id="siteGrid"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#27e8ff"/><stop offset="0.38" stop-color="#a78bfa"/>
      <stop offset="0.72" stop-color="#ff2e97"/><stop offset="1" stop-color="#ffd84a"/>
    </linearGradient>
  </defs>
</svg>

<!-- ===== INTRO: czaszka x-ray + panorama (skull-hero -> pan klub->nauka) ===== -->
<!-- Model 3D szkieletu: "three-skull" (Cullen Webber) — licencja MIT. -->
<div class="hero-screen" id="heroScreen">
  <div class="liquid-bg" id="liquidBars"><FaultyTerminal client:load tint="#bb1cfc" scale={1.7} curvature={0.22} mouseStrength={0.4} brightness={0.7} timeScale={0.4} scanlineIntensity={0.8} digitSize={1.5} dpr={1.5} /></div>
  <div class="hero-fx"><div class="scan"></div><div class="vig"></div></div>
  <div class="hero-skull" id="heroSkull"><HeroSkull client:load /></div>
  <div class="hero-hud" id="hudTitle">
    <div class="hh-brand">unicorner</div>

    <div class="hh-main">
      <h1 class="hh-head">Edukacja<br>po ludzku.</h1>
      <p class="hh-sub">Jedno miejsce.<br>Cała Twoja nauka.</p>
      <a class="hh-cta" href="#przedmioty" aria-label="Zacznij naukę">
        <BorderGlow client:load animated={true} borderRadius={36} glowRadius={46} edgeSensitivity={10} backgroundColor="#2e253e" glowColor="270 90 74" glowIntensity={2.4} colors={['#c084fc', '#a855f7', '#c084fc']} className="hh-glow">
          <span class="hh-cta-txt">Zacznij naukę <span class="arr">→</span></span>
        </BorderGlow>
      </a>
    </div>

    <div class="hh-scroll">
      <span class="hh-scroll-num">// 01</span>
      <span class="hh-scroll-label">Scroll to explore</span>
    </div>
  </div>

  <!-- WIDOK 2: kula + generator (wchodzi crossfadem przy scrollu, na tym samym tunelu) -->
</div>
<div class="hero-spacer"></div>

<div class="wrap">
  <div class="ow" aria-hidden="true"><span>NEXT LEVEL</span></div>

  <div class="row-label" data-rev id="przedmioty"><h2>Przedmioty</h2><span class="count" id="count"></span><span class="line"></span></div>
  <div class="grid" id="grid"></div>

  <div class="next-zone">
    <div class="next-card" id="nextCard"></div>
    <div class="about">
      <div class="item"><h4>Po co to jest</h4><p>Wkuwanie definicji rzadko wystarcza — egzaminy lubią przykłady i zastosowanie. Materiały są pod to ułożone.</p></div>
      <div class="item"><h4>Jak korzystać</h4><p>Wybierz przedmiot, przejdź fiszki, rozwiąż zadania, sprawdź się quizem. Postęp zapisuje się w przeglądarce.</p></div>
      <div class="item"><h4>Skąd się bierze</h4><p>To nasze własne opracowania na bazie zajęć. Robione, bo sami się z tego uczymy — i bo działa.</p></div>
    </div>
  </div>

  <div class="row-label" data-rev id="generator"><h2>Generator AI</h2><span class="count">beta</span><span class="line"></span></div>
  <a class="gen-band" href="generator.html" data-rev>
    <span class="gb-txt">
      <span class="wb-k">// notatki → nauka</span>
      <span class="wb-h">Twoje notatki. <span class="grad">Gotowa nauka.</span></span>
      <span class="wb-p">Wrzuć PDF z wykładu, zdjęcia notatek albo wklej tekst. AI ułoży z tego fiszki i quiz z wyjaśnieniami — i skupi się na tym, o co poprosisz.</span>
      <span class="wb-tags"><span>PDF</span><span>Zdjęcia notatek</span><span>Wklejony tekst</span></span>
      <span class="wb-go">Otwórz generator <span class="arr">→</span></span>
    </span>
    <span class="gb-demo" aria-hidden="true">
      <span class="gb-card gb-c2"></span>
      <span class="gb-card gb-c1">
        <span class="gb-face gb-f">Koszt alternatywny</span>
        <span class="gb-face gb-b">Wartość najlepszej opcji, z której rezygnujesz, wybierając inną.</span>
      </span>
      <span class="gb-quiz">
        <span class="gb-qn">Pytanie 3 / 10</span>
        <span class="gb-opt">Popyt rośnie przy wzroście ceny</span>
        <span class="gb-opt ok">Popyt spada przy wzroście ceny</span>
      </span>
    </span>
  </a>
  <style>
    #generator{position:relative;left:50%;transform:translateX(-50%);width:min(1680px,calc(100vw - 48px));}
    .gen-band{position:relative;width:min(1680px,calc(100vw - 48px));left:50%;translate:-50% 0;display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:24px;padding:28px 28px 26px;margin:0 0 34px;text-decoration:none;color:inherit;overflow:hidden;
      background:radial-gradient(520px 220px at 100% 0%,rgba(167,139,250,.12),transparent 60%),radial-gradient(460px 220px at 0% 100%,rgba(39,232,255,.07),transparent 60%),linear-gradient(160deg,var(--surface),var(--ink2));
      border:1px solid var(--line2);clip-path:polygon(0 0,calc(100% - 18px) 0,100% 18px,100% 100%,18px 100%,0 calc(100% - 18px));transition:transform .3s cubic-bezier(.16,1,.3,1),border-color .25s,box-shadow .3s;}
    .gen-band:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 18px 50px rgba(0,0,0,.5),0 0 26px rgba(167,139,250,.2);}
    .gen-band .gb-txt{display:grid;gap:10px;}
    .gen-band .wb-k{font-family:var(--mono);font-size:.72rem;letter-spacing:2px;text-transform:uppercase;color:var(--cyan);}
    .gen-band .wb-h{font-family:var(--disp);font-weight:700;font-size:clamp(1.5rem,3.4vw,2.2rem);line-height:1.1;}
    .gen-band .grad{background:var(--iris);-webkit-background-clip:text;background-clip:text;color:transparent;}
    .gen-band .wb-p{color:var(--muted);max-width:560px;font-size:.95rem;}
    .gen-band .wb-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
    .gen-band .wb-tags span{font-family:var(--mono);font-size:.7rem;color:var(--muted);background:var(--ink2);border:1px solid var(--line);border-radius:3px;padding:4px 9px;}
    .gen-band .wb-go{font-family:var(--mono);font-weight:600;font-size:.82rem;letter-spacing:1.5px;text-transform:uppercase;margin-top:6px;}
    .gen-band .wb-go .arr{color:var(--cyan);display:inline-block;transition:transform .25s;}
    .gen-band:hover .wb-go .arr{transform:translateX(4px);}
    .gb-demo{position:relative;height:250px;perspective:900px;}
    .gb-card{position:absolute;top:12px;left:4%;width:60%;height:124px;}
    .gb-c2{transform:translate(18px,-8px) rotate(4deg);background:var(--surface2);border:1px solid var(--line);opacity:.6;}
    .gb-c1{transform-style:preserve-3d;animation:gbFlip 7s cubic-bezier(.16,1,.3,1) infinite;}
    .gb-face{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:14px;border:1px solid var(--line2);backface-visibility:hidden;-webkit-backface-visibility:hidden;}
    .gb-f{background:linear-gradient(160deg,var(--surface),var(--ink2));font-family:var(--disp);font-weight:600;font-size:1.05rem;}
    .gb-f::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;background:var(--iris);}
    .gb-b{background:var(--surface2);transform:rotateY(180deg);font-size:.84rem;color:#cfcae8;}
    .gb-quiz{position:absolute;right:2%;bottom:0;width:64%;display:grid;gap:6px;padding:12px;background:rgba(7,6,15,.92);border:1px solid var(--line2);box-shadow:0 14px 40px rgba(0,0,0,.5);}
    .gb-qn{font-family:var(--mono);font-size:.62rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--cyan);}
    .gb-opt{font-size:.76rem;padding:7px 10px;border:1px solid var(--line);border-radius:4px;color:var(--muted);}
    .gb-opt.ok{animation:gbOk 7s ease infinite;}
    @keyframes gbFlip{0%,30%{transform:rotateY(0)}40%,80%{transform:rotateY(180deg)}90%,100%{transform:rotateY(360deg)}}
    @keyframes gbOk{0%,50%{border-color:var(--line);background:none;color:var(--muted)}58%,92%{border-color:rgba(90,209,160,.6);background:rgba(90,209,160,.1);color:#cdeede}100%{border-color:var(--line);background:none;color:var(--muted)}}
    @media(max-width:760px){.gen-band{grid-template-columns:1fr;padding:22px 18px}.gb-demo{height:240px}.gb-card{width:78%}.gb-quiz{width:80%}}
    @media(prefers-reduced-motion:reduce){.gb-c1,.gb-opt.ok{animation:none}}
  </style>

