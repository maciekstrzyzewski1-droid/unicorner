        </defs>
        <line x1="0" y1="96" x2="700" y2="96" stroke="url(#ufA)"/>
        <line x1="120" y1="150" x2="700" y2="150" stroke="url(#ufB)"/>
        <line x1="0" y1="286" x2="640" y2="286" stroke="url(#ufA)"/>
