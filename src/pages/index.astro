---
import Base from '../layouts/Base.astro';
---

<Base title="Unicorner — fundament Astro">
  <main class="min-h-dvh grid place-items-center bg-[#07060f] p-8 text-center text-neutral-200">
    <div class="max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-fuchsia-400">Faza 0 · fundament</p>
      <h1 class="mt-3 text-4xl font-bold text-white">Astro + Tailwind + React stoi ✅</h1>
      <p class="mt-4 leading-relaxed text-neutral-400">
        Build i dev działają. Dalej: design-system do <code class="text-cyan-300">Base.astro</code>,
        potem landing (hero three.js jako wyspa React), potem 15 przedmiotów w content collection —
        fundament pod docelowe 200.
      </p>
    </div>
  </main>
</Base>
