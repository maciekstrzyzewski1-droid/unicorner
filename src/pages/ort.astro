---
import Base from '../layouts/Base.astro';
import cssPrzedmiotMotyw from '../styles/przedmiot-motyw.css?raw';
import cssGigaNapis from '../styles/giga-napis.css?raw';
const title = "Obsługa Ruchu Turystycznego · Unicorner";
const description = "Obsługa ruchu turystycznego do egzaminu: rodzaje turystyki, etapy podróży, organizacja imprez, praca pilota i przewodnika. Kompendium i quiz z 41 pytaniami.";
---

<Base title={title} description={description}>
<style is:inline set:html={cssPrzedmiotMotyw}></style>
<style is:inline set:html={cssGigaNapis}></style>

<div class="scanbar" aria-hidden="true"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#5ad1ff"/><stop offset="0.34" stop-color="#a78bfa"/>
    <stop offset="0.66" stop-color="#f472b6"/><stop offset="1" stop-color="#fcd34d"/>
  </linearGradient></defs></svg>
<header class="uc-head">
  <div class="uc-head-in">
    <a class="uc-brand" href="index.html" aria-label="Unicorner — strona główna">
      <svg class="uc-horn" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 1 L15 22 H9 Z" fill="url(#irisGrad)"/>
        <path d="M10.4 7 L13.6 7 M9.8 12 L14.2 12 M9.2 17 L14.8 17" stroke="#0c0a18" stroke-width="1.1" fill="none" opacity="0.55"/>
      </svg>
      <span class="uc-wordmark">Uni<span class="ai">corner</span></span>
    </a>
    <span class="uc-sep">/</span>
    <span class="uc-subject">Obsługa Ruchu Turystycznego</span>
    <a class="uc-back" href="index.html">← Wszystkie przedmioty</a>
  </div>
</header>
<div class="page-intro">
  <span class="eyebrow"><span class="dot"></span>Obsługa Ruchu Turystycznego · US</span>
  <h1>Ruch turystyczny, <span class="grad">ogarnięty od kuchni.</span></h1>
  <p>Ruch turystyczny i jego determinanty, rodzaje turystyki, obsługa na etapach podróży, organizacja imprez oraz praca pilota i przewodnika — pojęcia i klasyfikacje plus quiz ze sprawdzaniem po każdej odpowiedzi.</p>
  <div class="meta">
    <span class="chip"><b>5</b> działów</span>
    <span class="chip">Ruch · Obsługa</span>
    <span class="chip">Imprezy</span>
    <span class="chip">Pilot i grupa</span>
  </div>
</div>
<div class="container">
  <div class="tabs">
    <button class="tab active" onclick="switchTab('ruch',this)">Ruch turystyczny</button>
    <button class="tab" onclick="switchTab('rodzaje',this)">Rodzaje turystyki</button>
    <button class="tab" onclick="switchTab('obsluga',this)">Obsługa</button>
    <button class="tab" onclick="switchTab('imprezy',this)">Imprezy</button>
    <button class="tab" onclick="switchTab('pilot',this)">Pilot i grupa</button>
    <button class="tab" onclick="switchTab('quiz',this)">Quiz</button>
  </div>

  <!-- ============ RUCH TURYSTYCZNY ============ -->
  <div class="section active" id="ruch">
    <div class="card">
      <div class="card-label">Definicja</div>
      <div class="card-title">Ruch turystyczny</div>
      <div class="card-body">Zjawisko przemieszczania się turystów — jego wielkość, strukturę i charakter kształtuje wiele czynników. Rozwija się dzięki determinantom popytowym (potrzeby, zamożność, czas wolny) i podażowym (walory, infrastruktura, transport).</div>
    </div>
    <div class="card">
      <div class="card-label">Determinanty rozwoju</div>
      <div class="card-title">Co napędza ruch turystyczny</div>
      <div class="card-body">Potrzeby turystów i walory; rozwój transportu i infrastruktury; wzrost czasu wolnego i zamożności; świadomość wartości wyjazdów; powstanie biur podróży; polityka państw; korzyści ekonomiczne z turystyki; urbanizacja; łatwy dostęp do informacji i mediów społecznościowych; ułatwienia w obrocie pieniężnym; globalizacja; sytuacja polityczno-gospodarcza i środowiskowa.</div>
    </div>
    <div class="card">
      <div class="card-label">Problem</div>
      <div class="card-title">Overtourism</div>
      <div class="card-body">Wg UN Tourism to <strong>nadmierny i negatywny wpływ turystyki</strong> na jakość życia mieszkańców oraz jakość doświadczeń odwiedzających. Skutek zbyt dużej koncentracji ruchu turystycznego.</div>
    </div>
    <div class="card">
      <div class="card-label">Badania — 1</div>
      <div class="card-title">Badania pierwotne ruchu turystycznego</div>
      <div class="card-body"><strong>Bezpośrednie</strong> (badanie turystów): pełne — metoda hotelowa i graniczna; częściowe — badania ankietowe. <strong>Pośrednie</strong> — wnioskowanie o ruchu na podstawie zjawisk pośrednio związanych z turystyką.</div>
    </div>
    <div class="card">
      <div class="card-label">Badania — 2</div>
      <div class="card-title">Badania wtórne</div>
      <div class="card-body">Czerpanie informacji z publikacji statystycznych. Najczęstsze źródła: <strong>UN Tourism</strong> (Światowa Organizacja Turystyki), <strong>EUROSTAT</strong>, <strong>WTTC</strong> (Światowa Rada Podróży i Turystyki), <strong>ETC</strong> (Europejska Komisja Turystyki).</div>
    </div>
  </div>

  <!-- ============ RODZAJE TURYSTYKI ============ -->
  <div class="section" id="rodzaje">
    <div class="card">
      <div class="card-label">Turystyka masowa</div>
      <div class="card-title">Cechy</div>
      <div class="card-body">Koncentracja przestrzenna i czasowa (sezonowość); małe zróżnicowanie zewnętrzne produktu przy dużym urozmaiceniu wewnętrznym; uzależnienie regionu recepcji od turystyki; dominacja dużych przedsiębiorstw; rosnący udział wydatków na turystykę; <strong>degradacyjny wpływ na środowisko</strong> przyrodnicze i antropogeniczne.</div>
    </div>
    <div class="card">
      <div class="card-label">Turystyka alternatywna</div>
      <div class="card-title">Przeciwieństwo masowej</div>
      <div class="card-body">Samodzielna organizacja (czasem z pomocą biur), charakter krajoznawczy, podróże w <strong>małych, nieformalnych grupach</strong> lub indywidualnie; wymaga zdolności organizacyjnych, wiedzy o obszarze, odporności psychicznej i przygotowania fizycznego.</div>
      <div class="tags">
        <span class="tag tag-green">Ekoturystyka (zielona, przyrodnicza, ekoetnoturystyka)</span>
        <span class="tag tag-green">Agroturystyka</span>
        <span class="tag tag-green">Turystyka aktywna (speleologia, wspinaczka)</span>
      </div>
    </div>
    <div class="card">
      <div class="card-label">Turystyka aktywna / kwalifikowana</div>
      <div class="card-title">Aktywności ekstremalne wg żywiołu</div>
      <div class="card-body">Podział wg środowiska:</div>
      <div class="tags">
        <span class="tag tag-amber">Powietrze: base jumping, bungee, paragliding, ballooning, skysurfing</span>
        <span class="tag tag-amber">Ziemia: climbing, zorbing, streetluge, mountainboarding, paintball</span>
        <span class="tag tag-amber">Woda: surfing, windsurfing, kitesurfing, rafting, canoeing</span>
      </div>
    </div>
    <div class="card">
      <div class="card-label">Idea przewodnia</div>
      <div class="card-title">Zrównoważony rozwój turystyki</div>
      <div class="card-body">Rozwój turystyki uwzględniający równowagę między korzyściami ekonomicznymi, dobrostanem mieszkańców i ochroną środowiska — tak, by zaspokajać potrzeby dziś, nie niszcząc możliwości przyszłych pokoleń.</div>
    </div>
  </div>

  <!-- ============ OBSŁUGA ============ -->
  <div class="section" id="obsluga">
    <div class="card">
      <div class="card-label">Definicja</div>
      <div class="card-title">Obsługa ruchu turystycznego</div>
      <div class="card-body">Obejmuje <strong>wszystkie świadczenia na rzecz turystów</strong> związane z realizacją podróży turystycznej oraz zaspokojeniem innych potrzeb zgłaszanych podczas jej trwania.</div>
    </div>
    <div class="card">
      <div class="card-label">Etap 1</div>
      <div class="card-title">Przygotowanie podróży</div>
      <div class="card-body">Podstawowe formy obsługi: <strong>informacja, poradnictwo, pośrednictwo, organizacja imprez turystycznych</strong>. To etap przed wyruszeniem — planowanie i rezerwacje.</div>
    </div>
    <div class="card">
      <div class="card-label">Etap 2</div>
      <div class="card-title">Przejazd (do celu i z powrotem)</div>
      <div class="card-body">Podstawowe formy: <strong>transport, pilotaż, przewodnictwo, informacja</strong>. Dodatkowe: nocleg, wyżywienie. To obsługa w trakcie przemieszczania.</div>
    </div>
    <div class="card">
      <div class="card-label">Etap 3</div>
      <div class="card-title">Pobyt w miejscu docelowym</div>
      <div class="card-body">Obsługa na miejscu: nocleg, wyżywienie, przewodnictwo, animacja, udostępnianie walorów oraz poradnictwo i pośrednictwo (usługi dodatkowe).</div>
    </div>
    <div class="card">
      <div class="card-label">Logistyka</div>
      <div class="card-title">Elementy logistyki obsługi</div>
      <div class="card-body">Informacja; poradnictwo i pośrednictwo; transport; hotelarstwo i gastronomia; udostępnienie walorów turystycznych. To one łącznie umożliwiają sprawną obsługę ruchu.</div>
    </div>
  </div>

  <!-- ============ IMPREZY ============ -->
  <div class="section" id="imprezy">
    <div class="card">
      <div class="card-label">Fazy organizacji</div>
      <div class="card-title">Cztery fazy imprezy turystycznej</div>
      <div class="card-body"><strong>1. Przygotowanie</strong> (planowanie, programowanie, kalkulacja, zamawianie świadczeń) → <strong>2. Sprzedaż</strong> → <strong>3. Realizacja</strong> → <strong>4. Rozliczenie</strong>.</div>
    </div>
    <div class="card">
      <div class="card-label">Faza przygotowania</div>
      <div class="card-title">Programowanie i kalkulacja</div>
      <div class="card-body"><strong>Programowanie</strong> — ustalenie celu, terminu i elementów imprezy. <strong>Kalkulacja</strong> — obliczenie kosztów i ceny. Następnie <strong>zamawianie świadczeń</strong> u producentów usług cząstkowych.</div>
    </div>
    <div class="card">
      <div class="card-label">Zamawianie świadczeń</div>
      <div class="card-title">Umowa z usługodawcami</div>
      <div class="card-body">Zawarcie umowy między producentami usług cząstkowych a organizatorem na określony rodzaj świadczeń. Podstawą zamówienia może być <strong>stała umowa</strong> albo <strong>każdorazowe zapytanie o usługę</strong>.</div>
    </div>
    <div class="card">
      <div class="card-label">Rodzaje umów</div>
      <div class="card-title">Czarterowa vs allotment</div>
      <div class="card-body"><strong>Umowa czarterowa</strong> — zakup określonej liczby usług w danym terminie za z góry ustaloną kwotę; <strong>brak możliwości zwrotu</strong>, więc ceny są niższe.<br><strong>Umowa allotmentu</strong> — dysponowanie uzgodnioną liczbą usług przez określony czas z <strong>prawem rezygnacji bez kosztów</strong> do wyznaczonego terminu.</div>
    </div>
    <div class="card">
      <div class="card-label">Umowy w biurze podróży</div>
      <div class="card-title">Z kim biuro zawiera umowy</div>
      <div class="card-body">Z kontrahentami (usługodawcami), z turystami — <strong>umowa o imprezę turystyczną</strong>, umowy agencyjne oraz umowy z pilotami i przewodnikami.</div>
    </div>
  </div>

  <!-- ============ PILOT I GRUPA ============ -->
  <div class="section" id="pilot">
    <div class="card">
      <div class="card-label">Kompetencje</div>
      <div class="card-title">Cechy i umiejętności pilota/przewodnika</div>
      <div class="card-body"><strong>Kompetencja</strong> — merytoryczne i formalne przygotowanie do realizacji imprezy. <strong>Cechy osobowościowe</strong> — sumienność, otwartość na doświadczenia, ekstrawersja, empatia (u pilota: niski neurotyzm, średnia ugodowość). <strong>Sprawność organizacyjna</strong> — dobry plan dnia, orientacja w terenie.</div>
    </div>
    <div class="card">
      <div class="card-label">Przekaz</div>
      <div class="card-title">Jaka powinna być treść informacji</div>
      <div class="card-body">Prawdziwa, aktualna, obiektywna; dostosowana do wieku, wiedzy i oczekiwań turystów; podawana od ogółu do szczegółu; z anegdotami, analogiami i ciekawostkami; kwestie etniczne, religijne i kulturowe prezentowane z szacunkiem i delikatnie.</div>
    </div>
    <div class="card">
      <div class="card-label">Role</div>
      <div class="card-title">Pilot trasowy vs rezydent</div>
      <div class="card-body"><strong>Pilot (trasowy)</strong> — towarzyszy grupie w trakcie podróży. <strong>Rezydent</strong> — przebywa czasowo w regionie recepcji i obsługuje turystów na miejscu (zbieżne zadania, ale stacjonarnie w destynacji).</div>
    </div>
    <div class="card">
      <div class="card-label">Obsługa imprezy przez pilota</div>
      <div class="card-title">Trzy części</div>
      <div class="card-body"><strong>Odprawa u referenta</strong> (program, lista uczestników i rooming-list, bilety, vouchery, kopie rezerwacji i umów, polisa, fundusz awaryjny) → <strong>realizacja imprezy</strong> → <strong>rozliczenie</strong> (podpisane vouchery, sprawozdanie, uaktualniona lista, rozliczenie gotówki, rachunek za pracę i diety).</div>
    </div>
    <div class="card">
      <div class="card-label">Typy turystów — 1</div>
      <div class="card-title">Wg przygotowania do wyjazdu</div>
      <div class="card-body"><strong>Przygotowani</strong> (miłośnicy historii, gotyku, znawcy poloników), <strong>nieprzygotowani</strong> (wrażliwi entuzjaści, turyści pasywni, snobi turystyczni) oraz <strong>pseudoturyści</strong>.</div>
    </div>
    <div class="card">
      <div class="card-label">Typy turystów — 2</div>
      <div class="card-title">Wg zachowania (Cohen)</div>
      <div class="card-body">Zorganizowany turysta masowy, indywidualny turysta masowy, <strong>explorer</strong> i <strong>drifter</strong> — od najbardziej zinstytucjonalizowanego po całkowicie samodzielnego wędrowca.</div>
    </div>
    <div class="card">
      <div class="card-label">Konflikty</div>
      <div class="card-title">Konflikty w grupie i ich rozwiązywanie</div>
      <div class="card-body">Konflikt interpersonalny = działania jednej osoby utrudniają działania innej. Źródła: <strong>konflikt interesów, adaptacyjny, postaw</strong>. Metody rozwiązywania: <strong>mediacja</strong> (pilot jako trzecia strona), <strong>kompromis</strong> (wzajemne ustępstwa), <strong>arbitraż</strong> (pilot narzuca rozwiązanie), negocjacje.</div>
    </div>
  </div>

  <!-- ============ QUIZ ============ -->
  <div class="section" id="quiz">
    <div id="quiz-container"></div>
  </div>

</div>

<div class="giant" aria-hidden="true"><span>OBSŁUGA</span></div>

<footer class="uc-foot">
  <div class="fwrap">
    <p class="disclaimer"><b>Projekt studencki.</b> Niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu ani z żadną katedrą. Materiały to własne opracowania na bazie zajęć — ucz się też z oryginalnych źródeł. Bez gwarancji kompletności.</p>
    <div class="foot-brand">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L15 22 H9 Z" fill="url(#irisGrad)"/></svg>
      <span>uni<span class="fb-corner">corner</span></span>
    </div>
  </div>
</footer>

<script is:inline>
const RAW = [
  // ZESTAW 1 — Ruch turystyczny (9)
  {set:0,q:"Który czynnik jest determinantą rozwoju ruchu turystycznego?",opts:["Spadek ilości czasu wolnego","Wzrost zamożności społeczeństw i rozwój transportu","Zamykanie biur podróży","Ograniczanie dostępu do informacji"],ans:1,exp:"Ruch turystyczny napędzają m.in.: potrzeby i walory, rozwój transportu i infrastruktury, wzrost czasu wolnego i zamożności, biura podróży, globalizacja i łatwy dostęp do informacji."},
  {set:0,q:"Overtourism wg UN Tourism to...",opts:["Turystyka poza sezonem","Nadmierny i negatywny wpływ turystyki na jakość życia mieszkańców i doświadczeń odwiedzających","Turystyka wyłącznie zagraniczna","Brak ruchu turystycznego w regionie"],ans:1,exp:"Overtourism = nadmierny, negatywny wpływ zbyt dużej koncentracji ruchu turystycznego na mieszkańców i na jakość doświadczeń samych turystów."},
  {set:0,q:"Badania pierwotne ruchu turystycznego to...",opts:["Czerpanie danych z publikacji statystycznych","Badania bezpośrednie turystów (np. metoda hotelowa, graniczna, ankiety) i pośrednie","Wyłącznie dane z EUROSTAT-u","Analiza sprawozdań finansowych biur podróży"],ans:1,exp:"Pierwotne = zbierane samodzielnie: bezpośrednie (metoda hotelowa, graniczna, ankiety) oraz pośrednie (wnioskowanie ze zjawisk związanych z turystyką)."},
  {set:0,q:"Metoda hotelowa i graniczna to przykłady...",opts:["Badań wtórnych","Bezpośrednich badań pełnych ruchu turystycznego","Metod kalkulacji imprezy","Form animacji"],ans:1,exp:"Metoda hotelowa i graniczna to bezpośrednie badania pełne turystów (badania pierwotne). Ankieta to badanie częściowe."},
  {set:0,q:"Badania wtórne ruchu turystycznego polegają na...",opts:["Ankietowaniu turystów na granicy","Czerpaniu informacji z publikacji statystycznych","Obserwacji grupy przez pilota","Kalkulacji kosztów imprezy"],ans:1,exp:"Wtórne = korzystanie z gotowych publikacji statystycznych, np. UN Tourism, EUROSTAT, WTTC, ETC."},
  {set:0,q:"Które z poniższych to źródło danych w badaniach wtórnych?",opts:["Rooming-list pilota","EUROSTAT i WTTC","Voucher hotelowy","Fundusz awaryjny imprezy"],ans:1,exp:"Najczęstsze źródła wtórne: UN Tourism (Światowa Organizacja Turystyki), EUROSTAT, WTTC (Światowa Rada Podróży i Turystyki), ETC (Europejska Komisja Turystyki)."},
  {set:0,q:"Skrót WTTC oznacza...",opts:["Światową Organizację Turystyki","Europejską Komisję Turystyki","Światową Radę Podróży i Turystyki","Światowy Trust Transportu Cywilnego"],ans:2,exp:"WTTC = World Travel & Tourism Council — Światowa Rada Podróży i Turystyki. UN Tourism to Światowa Organizacja Turystyki."},
  {set:0,q:"Ruch turystyczny kształtują czynniki wpływające na jego...",opts:["Wyłącznie cenę biletów lotniczych","Wielkość, strukturę i charakter","Tylko sezonowość","Wyłącznie długość pobytu"],ans:1,exp:"Determinanty kształtują wielkość, strukturę i charakter ruchu turystycznego oraz jego rozwój w czasie."},
  {set:0,q:"Globalizacja i media społecznościowe jako determinanty ruchu turystycznego działają przez...",opts:["Utrudnianie dostępu do informacji","Ułatwianie dostępu do informacji i inspiracji do podróży","Zmniejszanie mobilności","Ograniczanie obrotu pieniężnego"],ans:1,exp:"Łatwy dostęp do informacji, media społecznościowe, ułatwienia w obrocie pieniężnym i globalizacja obniżają barierę wyjazdu i napędzają ruch turystyczny."},

  // ZESTAW 2 — Rodzaje turystyki (8)
  {set:1,q:"Która cecha jest typowa dla turystyki masowej?",opts:["Podróże w małych, nieformalnych grupach","Samodzielna organizacja wyjazdu","Silna koncentracja czasowa (sezonowość) i degradacyjny wpływ na środowisko","Dominacja bardzo małych przedsiębiorstw"],ans:2,exp:"Turystyka masowa: koncentracja przestrzenna i czasowa, dominacja dużych przedsiębiorstw, uzależnienie regionu recepcji, degradacyjny wpływ na środowisko."},
  {set:1,q:"Turystyka alternatywna charakteryzuje się...",opts:["Masowymi wyjazdami przez wielkie biura","Podróżami w małych, nieformalnych grupach i samodzielną organizacją","Całkowitym brakiem wiedzy o obszarze","Dominacją dużych przedsiębiorstw"],ans:1,exp:"Alternatywna = przeciwieństwo masowej: samodzielna organizacja, małe/nieformalne grupy lub indywidualnie, wymaga wiedzy, przygotowania i odporności."},
  {set:1,q:"Ekoturystyka i agroturystyka to formy...",opts:["Turystyki masowej","Turystyki alternatywnej","Turystyki biznesowej","Turystyki tranzytowej"],ans:1,exp:"Turystyka alternatywna obejmuje najczęściej ekoturystykę (zieloną, przyrodniczą), agroturystykę i turystykę aktywną (np. speleologia, wspinaczka)."},
  {set:1,q:"Base jumping i paragliding to aktywności ekstremalne w środowisku...",opts:["Wody","Ziemi","Powietrza","Miejskim"],ans:2,exp:"Podział wg żywiołu: powietrze (base jumping, bungee, paragliding), ziemia (climbing, zorbing, streetluge), woda (surfing, rafting, canoeing)."},
  {set:1,q:"Rafting i kitesurfing zaliczamy do aktywności...",opts:["Powietrznych","Wodnych","Lądowych","Halowych"],ans:1,exp:"Rafting, canoeing, surfing, windsurfing i kitesurfing to aktywności ekstremalne w środowisku wodnym."},
  {set:1,q:"Zrównoważony rozwój turystyki oznacza...",opts:["Maksymalizację liczby turystów bez ograniczeń","Równowagę między korzyściami ekonomicznymi, dobrostanem mieszkańców i ochroną środowiska","Rezygnację z jakiejkolwiek turystyki","Turystykę wyłącznie krajową"],ans:1,exp:"Zrównoważony rozwój = zaspokajanie potrzeb turystycznych dziś bez niszczenia środowiska i możliwości przyszłych pokoleń; równowaga trzech filarów."},
  {set:1,q:"Małe zróżnicowanie zewnętrzne produktu przy dużym urozmaiceniu wewnętrznym to cecha...",opts:["Turystyki alternatywnej","Turystyki masowej","Agroturystyki","Turystyki kwalifikowanej"],ans:1,exp:"To jedna z cech turystyki masowej — produkty są do siebie podobne z zewnątrz, ale bogate wewnętrznie; obok sezonowości i koncentracji przestrzennej."},
  {set:1,q:"Turystyka alternatywna zwykle wymaga od uczestnika...",opts:["Braku jakiegokolwiek przygotowania","Zdolności organizacyjnych, wiedzy o obszarze i odporności psychicznej","Wyłącznie dużego budżetu","Podróżowania tylko w dużych grupach"],ans:1,exp:"Samodzielny charakter turystyki alternatywnej wymaga zdolności organizacyjnych, wiedzy o odwiedzanym obszarze, odporności psychicznej i przygotowania fizycznego."},

  // ZESTAW 3 — Obsługa ruchu turystycznego (7)
  {set:2,q:"Obsługa ruchu turystycznego obejmuje...",opts:["Wyłącznie transport turystów","Wszystkie świadczenia na rzecz turystów związane z podróżą i zaspokojeniem ich potrzeb podczas jej trwania","Tylko organizację imprez","Wyłącznie usługi noclegowe"],ans:1,exp:"Obsługa ruchu turystycznego = wszystkie świadczenia na rzecz turystów związane z realizacją podróży i zaspokojeniem potrzeb zgłaszanych podczas jej trwania."},
  {set:2,q:"Podstawową formą obsługi na etapie przygotowania podróży jest...",opts:["Pilotaż w autokarze","Informacja, poradnictwo, pośrednictwo i organizacja imprez","Wyżywienie w hotelu","Animacja czasu wolnego"],ans:1,exp:"Na etapie przygotowania obsługa to informacja, poradnictwo, pośrednictwo oraz organizacja imprez turystycznych — jeszcze przed wyjazdem."},
  {set:2,q:"Pilotaż i przewodnictwo to podstawowe formy obsługi na etapie...",opts:["Przygotowania podróży","Przejazdu i pobytu","Rozliczenia imprezy","Kalkulacji"],ans:1,exp:"Transport, pilotaż, przewodnictwo i informacja to formy obsługi na etapie przejazdu; przewodnictwo i animacja dochodzą podczas pobytu."},
  {set:2,q:"Które elementy należą do logistyki obsługi ruchu turystycznego?",opts:["Wyłącznie transport","Informacja, poradnictwo i pośrednictwo, transport, hotelarstwo i gastronomia, udostępnienie walorów","Tylko hotelarstwo","Kalkulacja i rozliczenie imprezy"],ans:1,exp:"Logistyka obsługi obejmuje: informację, poradnictwo i pośrednictwo, transport, hotelarstwo i gastronomię oraz udostępnienie walorów turystycznych."},
  {set:2,q:"Nocleg i wyżywienie to na etapie przejazdu formy obsługi...",opts:["Podstawowe","Dodatkowe","Zakazane","Rozliczeniowe"],ans:1,exp:"Na etapie przejazdu podstawowe formy to transport, pilotaż, przewodnictwo i informacja, a nocleg i wyżywienie są formami dodatkowymi."},
  {set:2,q:"Udostępnianie walorów turystycznych w obsłudze ruchu to...",opts:["Element logistyki obsługi","Rodzaj umowy czarterowej","Faza rozliczenia imprezy","Metoda badań wtórnych"],ans:0,exp:"Udostępnianie walorów turystycznych to jeden z elementów logistyki obsługi ruchu, obok informacji, transportu, hotelarstwa i gastronomii."},
  {set:2,q:"Głównym celem obsługi ruchu turystycznego jest...",opts:["Sprzedaż jak największej liczby biletów","Zaspokojenie potrzeb turystów na wszystkich etapach podróży","Ograniczenie liczby turystów","Prowadzenie badań statystycznych"],ans:1,exp:"Obsługa ma zapewnić świadczenia zaspokajające potrzeby turystów na etapach przygotowania, przejazdu i pobytu — kompleksowo w całej podróży."},

  // ZESTAW 4 — Imprezy turystyczne (8)
  {set:3,q:"Prawidłowa kolejność faz organizacji imprezy turystycznej to...",opts:["Sprzedaż → przygotowanie → rozliczenie → realizacja","Przygotowanie → sprzedaż → realizacja → rozliczenie","Realizacja → sprzedaż → przygotowanie → rozliczenie","Rozliczenie → realizacja → sprzedaż → przygotowanie"],ans:1,exp:"Fazy: 1. przygotowanie (planowanie, programowanie, kalkulacja, zamawianie świadczeń) → 2. sprzedaż → 3. realizacja → 4. rozliczenie."},
  {set:3,q:"Programowanie imprezy to...",opts:["Obliczenie kosztów i ceny","Ustalenie celu, terminu i elementów imprezy","Podpisanie umowy z turystą","Rozliczenie gotówki po imprezie"],ans:1,exp:"Programowanie = ustalenie celu, terminu i elementów imprezy. Obliczanie kosztów i ceny to kalkulacja."},
  {set:3,q:"Kalkulacja w organizacji imprezy oznacza...",opts:["Zamawianie świadczeń u usługodawców","Obliczenie kosztów i ustalenie ceny imprezy","Rozliczenie pilota z gotówki","Programowanie trasy"],ans:1,exp:"Kalkulacja = etap fazy przygotowania, w którym oblicza się koszty i ustala cenę imprezy."},
  {set:3,q:"Zamawianie świadczeń polega na...",opts:["Sprzedaży imprezy klientom","Zawarciu umowy między producentami usług cząstkowych a organizatorem imprezy","Rozliczeniu voucherów","Animacji podczas pobytu"],ans:1,exp:"Zamawianie świadczeń = umowa organizatora z producentami usług cząstkowych; podstawą jest stała umowa albo każdorazowe zapytanie o usługę."},
  {set:3,q:"Umowa czarterowa charakteryzuje się tym, że...",opts:["Można zrezygnować z usług bez kosztów do określonego terminu","Zamawiający kupuje określoną liczbę usług bez możliwości zwrotu, dlatego ceny są niższe","Dotyczy tylko umów z turystami","Nie określa terminu ani standardu"],ans:1,exp:"Czarter = zakup z góry określonej liczby usług za ustaloną kwotę, bez możliwości zwrotu — stąd ceny są niższe niż przy innych formach."},
  {set:3,q:"Umowa allotmentu pozwala zamawiającemu...",opts:["Kupić usługi bez prawa rezygnacji","Dysponować usługami przez określony czas z prawem rezygnacji bez kosztów do wyznaczonego terminu","Zamówić tylko jedną usługę","Sprzedać imprezę bez kalkulacji"],ans:1,exp:"Allotment = dysponowanie uzgodnioną liczbą usług przez określony czas z prawem rezygnacji (całości lub części) bez kosztów do umówionego terminu."},
  {set:3,q:"Umowa zawierana między biurem podróży a turystą to...",opts:["Umowa czarterowa","Umowa allotmentu","Umowa o imprezę turystyczną","Umowa agencyjna"],ans:2,exp:"Biuro zawiera z turystami umowę o imprezę turystyczną; z kontrahentami — umowy na świadczenia; osobno umowy agencyjne oraz z pilotami i przewodnikami."},
  {set:3,q:"Która z poniższych czynności należy do fazy przygotowania imprezy?",opts:["Rozliczenie diet pilota","Kalkulacja i zamawianie świadczeń","Sprzedaż wycieczek klientom","Sprawozdanie po powrocie"],ans:1,exp:"Faza przygotowania obejmuje planowanie, programowanie, kalkulację i zamawianie świadczeń. Sprzedaż, realizacja i rozliczenie to kolejne fazy."},

  // ZESTAW 5 — Pilot i grupa (9)
  {set:4,q:"Kompetencja pilota/przewodnika oznacza...",opts:["Umiejętność sprzedaży wycieczek","Merytoryczne i formalne przygotowanie do realizacji imprezy","Znajomość wyłącznie języków obcych","Posiadanie własnego autokaru"],ans:1,exp:"Kompetencja = merytoryczne i formalne przygotowanie do realizacji imprezy; obok cech osobowościowych i sprawności organizacyjnej."},
  {set:4,q:"Które cechy osobowości są pożądane u pilota/przewodnika?",opts:["Neurotyczność i zamknięcie na doświadczenia","Sumienność, otwartość na doświadczenia, ekstrawersja i empatia","Introwersja i wysoka konfliktowość","Obojętność wobec turystów"],ans:1,exp:"Pożądane: sumienność, otwartość na doświadczenia, ekstrawersja, empatia; u pilota dodatkowo niski poziom neurotyczności i średni poziom ugodowości."},
  {set:4,q:"Rezydent w obsłudze ruchu turystycznego to osoba, która...",opts:["Towarzyszy grupie wyłącznie w autokarze na trasie","Przebywa czasowo w regionie recepcji i obsługuje turystów na miejscu","Zajmuje się tylko kalkulacją imprez","Prowadzi badania statystyczne"],ans:1,exp:"Rezydent przebywa czasowo w regionie recepcji turystycznej i obsługuje tam turystów; zadania zbieżne z pilotem, ale realizowane stacjonarnie w destynacji."},
  {set:4,q:"Odprawa pilota u referenta obejmuje m.in....",opts:["Rozliczenie diet i rachunek za pracę","Program imprezy, listę uczestników, vouchery, polisę i fundusz awaryjny","Sprawozdanie z realizacji","Uaktualnioną listę uczestników po powrocie"],ans:1,exp:"Na odprawie pilot pobiera: program i warunki uczestnictwa, listę uczestników (rooming-list), bilety, vouchery, kopie rezerwacji i umów, polisę i fundusz awaryjny."},
  {set:4,q:"Rozliczenie imprezy przez pilota obejmuje...",opts:["Programowanie kolejnej imprezy","Podpisane vouchery, sprawozdanie, rozliczenie gotówki oraz rachunek za pracę i diety","Zamawianie świadczeń","Kalkulację ceny"],ans:1,exp:"Rozliczenie: podpisane przez obie strony vouchery (z uwagami), sprawozdanie i notatki, uaktualniona lista uczestników, rozliczenie pobranej gotówki, rachunek za pracę i diety."},
  {set:4,q:"Explorer i drifter to typy turystów wyróżnione ze względu na...",opts:["Merytoryczne przygotowanie do wyjazdu","Sposób zachowania w odwiedzanym środowisku (stopień samodzielności)","Wiek turysty","Rodzaj transportu"],ans:1,exp:"Wg zachowania (typologia Cohena): zorganizowany turysta masowy, indywidualny turysta masowy, explorer i drifter — od zinstytucjonalizowanego po samodzielnego."},
  {set:4,q:"Snob turystyczny i wrażliwy entuzjasta to podtypy turystów...",opts:["Przygotowanych","Nieprzygotowanych","Pseudoturystów","Zorganizowanych masowych"],ans:1,exp:"Wg przygotowania: przygotowani (miłośnicy historii, gotyku), nieprzygotowani (wrażliwi entuzjaści, turyści pasywni, snobi turystyczni) oraz pseudoturyści."},
  {set:4,q:"Źródłem konfliktów w grupie turystycznej NIE jest zwykle...",opts:["Konflikt interesów","Konflikt adaptacyjny","Konflikt postaw","Kalkulacja imprezy"],ans:3,exp:"Konflikty w grupie wynikają najczęściej z konfliktu interesów, adaptacyjnego i postaw. Kalkulacja to etap organizacji imprezy, nie źródło konfliktu."},
  {set:4,q:"Metoda rozwiązywania konfliktu, w której pilot narzuca skłóconym stronom rozwiązanie, to...",opts:["Mediacja","Kompromis","Arbitraż","Negocjacje"],ans:2,exp:"Arbitraż — w sytuacjach wyjątkowych pilot narzuca rozwiązanie. Mediacja = pomoc trzeciej strony, kompromis = wzajemne ustępstwa."}
];

const SETS = [
  {name:"Zestaw 1 – Ruch turystyczny",range:[0,9]},
  {name:"Zestaw 2 – Rodzaje turystyki",range:[9,17]},
  {name:"Zestaw 3 – Obsługa ruchu",range:[17,24]},
  {name:"Zestaw 4 – Imprezy turystyczne",range:[24,32]},
  {name:"Zestaw 5 – Pilot i grupa",range:[32,41]},
  {name:"Wszystkie (41 pytań)",range:[0,41]},
];
// Tasowanie opcji – zwraca {opts, ans} z pomieszaną kolejnością
function shuffle(q){
  const idxs=[0,1,2,3];
  for(let i=idxs.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idxs[i],idxs[j]]=[idxs[j],idxs[i]];}
  const newOpts=idxs.map(i=>q.opts[i]);
  const newAns=idxs.indexOf(q.ans);
  return{opts:newOpts,ans:newAns};
}

let activeSet=null; // null = wybór zestawu
let questions=[];
let shuffled=[];
let current=0,score=0,answered=[];

function switchTab(id,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
  if(id==='quiz')renderSetPicker();
}

function startSet(si){
  const s=SETS[si];
  questions=RAW.slice(s.range[0],s.range[1]);
  shuffled=questions.map(q=>shuffle(q));
  current=0;score=0;answered=new Array(questions.length).fill(null);
  activeSet=si;
  renderQuiz();
}

function renderSetPicker(){
  activeSet=null;
  const c=document.getElementById('quiz-container');
  c.innerHTML=`<div class="card"><div class="card-label">Wybierz zestaw pytań</div><div class="card-title" style="font-size:1.1rem;margin-bottom:1rem">Z czego chcesz się teraz pouczyć?</div>`+
  SETS.map((s,i)=>`<button class="opt" style="margin-bottom:6px" onclick="startSet(${i})">${s.name}</button>`).join('')+`</div>`;
}

function renderQuiz(){
  const c=document.getElementById('quiz-container');
  if(current>=questions.length){
    const pct=Math.round(score/questions.length*100);
    c.innerHTML=`<div class="card" style="text-align:center;padding:2.5rem">
      <div class="card-label">${SETS[activeSet].name}</div>
      <div class="score-big">${score}/${questions.length}</div>
      <div class="card-body" style="margin-bottom:1.5rem">
        ${pct>=80?'✅ Solidna znajomość materiału.':pct>=60?'⚠️ Kilka rzeczy warto powtórzyć.':'❌ Wróć do notatek i spróbuj ponownie.'}
        <br><span style="color:var(--ink-light)">${pct}% poprawnych odpowiedzi</span>
      </div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
        <button class="nav-btn primary" onclick="startSet(${activeSet})">Powtórz zestaw</button>
        <button class="nav-btn" onclick="renderSetPicker()">← Zmień zestaw</button>
      </div>
    </div>`;
    return;
  }
  const q=questions[current];
  const sh=shuffled[current];
  const isAnswered=answered[current]!==null;
  const pct=Math.round((current/questions.length)*100);
  c.innerHTML=`
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
    <div style="margin-bottom:.5rem"><button class="nav-btn" style="font-size:11px;padding:4px 12px" onclick="renderSetPicker()">← Zestawy</button></div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;margin-bottom:1rem">
        <span class="card-label">${SETS[activeSet].name.split('–')[1]||SETS[activeSet].name} · pytanie ${current+1}/${questions.length}</span>
        <span class="card-label">Wynik: ${score} pkt</span>
      </div>
      <div class="quiz-q">${q.q}</div>
      <div class="quiz-opts">
        ${sh.opts.map((o,i)=>{
          let cls='opt';
          if(isAnswered){if(i===sh.ans)cls+=' correct';else if(i===answered[current]&&i!==sh.ans)cls+=' wrong';}
          const oc=isAnswered?'':` onclick="pickAnswer(${i})"`;
          return `<button class="${cls}"${oc}>${o}</button>`;
        }).join('')}
      </div>
      ${isAnswered?`<div class="quiz-feedback ${answered[current]===sh.ans?'ok':'fail'}">${answered[current]===sh.ans?'✅':'❌'} ${q.exp}</div>`:''}
      <div class="quiz-nav">
        <span class="quiz-counter">${current+1} / ${questions.length}</span>
        ${current>0?`<button class="nav-btn" onclick="prevQ()">← Wstecz</button>`:''}
        ${isAnswered&&current<questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Dalej →</button>`:''}
        ${isAnswered&&current===questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Pokaż wynik</button>`:''}
      </div>
    </div>`;
}

function pickAnswer(i){
  if(answered[current]!==null)return;
  answered[current]=i;
  if(i===shuffled[current].ans)score++;
  renderQuiz();
}
function nextQ(){current++;renderQuiz();}
function prevQ(){if(current>0){current--;renderQuiz();}}

// inicjalizacja
document.addEventListener('DOMContentLoaded',()=>{
  const quizTab=document.querySelector('.tab[onclick*="quiz"]');
  if(quizTab) quizTab.addEventListener('click',renderSetPicker);
});
</script>

