---
import Base from '../layouts/Base.astro';
const title = "Regulamin · Unicorner";
const description = "Zasady korzystania z Unicorner, informacja o pochodzeniu pytań i materiałów oraz procedura zgłaszania naruszeń.";
const updated = "3 września 2026";
const mail = "unicornernotatki@gmail.com";
---

<Base title={title} description={description}>
<style is:inline>
  :root{
    --ink:#07060f; --ink2:#0b0918; --surface:#100d22; --line:#241d4a; --line2:#3a2e74;
    --text:#ece9f7; --muted:#9b93c4; --muted2:#6f679a;
    --accent:#a78bfa; --cyan:#27e8ff; --magenta:#ff2e97; --gold:#ffd84a;
    --iris:linear-gradient(115deg,#27e8ff 0%,#a78bfa 38%,#ff2e97 72%,#ffd84a 100%);
    --mono:'Chakra Petch','Space Grotesk',ui-monospace,monospace;
    --disp:'Chakra Petch','Space Grotesk',sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    background:
      radial-gradient(900px 500px at 85% -8%, #1e1646 0%, transparent 58%),
      radial-gradient(700px 460px at -8% 4%, #181133 0%, transparent 52%),
      var(--ink);
    color:var(--text); min-height:100vh; line-height:1.65; letter-spacing:.1px;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  a{color:var(--cyan); text-decoration:none; border-bottom:1px solid rgba(39,232,255,.35);}
  a:hover{border-bottom-color:var(--cyan);}
  .lwrap{max-width:820px; margin:0 auto; padding:0 22px 90px;}

  header.ltop{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:22px 0 8px;}
  .brand{display:flex; align-items:center; gap:10px; border:none;}
  .horn{width:24px; height:24px; flex-shrink:0;}
  .horn .seg{fill:url(#irisGrad);}
  .wordmark{font-family:var(--mono); font-weight:700; font-size:1.2rem; letter-spacing:.3px; color:var(--text);}
  .back{font-family:var(--mono); font-size:.8rem; font-weight:600; color:var(--muted); border:1px solid var(--line); background:var(--ink2); padding:7px 13px; border-radius:999px; transition:.2s;}
  .back:hover{color:var(--text); border-color:var(--line2);}

  .lhead{padding:36px 0 6px;}
  .eyebrow{display:inline-flex; align-items:center; gap:8px; font-family:var(--mono); font-size:.7rem; font-weight:600; letter-spacing:.6px; text-transform:uppercase; color:var(--muted); border:1px solid var(--line); background:var(--ink2); padding:6px 12px; border-radius:999px; margin-bottom:16px;}
  .eyebrow .dot{width:7px; height:7px; border-radius:50%; background:var(--accent); box-shadow:0 0 10px var(--accent);}
  h1{font-family:var(--mono); font-weight:700; font-size:clamp(1.7rem,4.5vw,2.5rem); line-height:1.1; letter-spacing:-.6px; margin-bottom:10px;}
  h1 .grad{background:var(--iris); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .updated{font-family:var(--mono); font-size:.82rem; color:var(--muted2);}
  .lede{color:var(--muted); font-size:1rem; margin-top:14px; max-width:680px;}
  .lede b{color:var(--text); font-weight:600;}

  section.lsec{padding:28px 0 0;}
  .lsec h2{font-family:var(--disp); font-size:1.16rem; font-weight:700; letter-spacing:.2px; margin-bottom:8px; display:flex; align-items:baseline; gap:10px;}
  .lsec h2 .n{font-family:var(--mono); font-size:.76rem; color:var(--accent); border:1px solid var(--line); border-radius:7px; padding:2px 8px;}
  .lsec p{color:var(--muted); font-size:.96rem; margin:8px 0;}
  .lsec p b, .lsec li b{color:var(--text); font-weight:600;}
  .lsec ul{list-style:none; margin:8px 0;}
  .lsec li{color:var(--muted); font-size:.95rem; padding:5px 0 5px 20px; position:relative;}
  .lsec li::before{content:"›"; position:absolute; left:2px; color:var(--accent); font-weight:700;}

  .callout{border:1px solid var(--line2); background:linear-gradient(160deg, rgba(167,139,250,.10), rgba(39,232,255,.05)); border-radius:16px; padding:20px 20px; margin:14px 0;}
  .callout h2{margin-bottom:10px;}
  .callout p{color:var(--text); font-size:.98rem;}
  .callout .tag{display:inline-block; font-family:var(--mono); font-size:.68rem; letter-spacing:1.4px; text-transform:uppercase; color:var(--accent); border:1px solid var(--line2); border-radius:999px; padding:4px 10px; margin-bottom:10px;}
  .contact{border:1px solid var(--line); background:var(--ink2); border-radius:14px; padding:16px 18px; margin:16px 0 0;}
  .contact .k{font-family:var(--mono); font-size:.72rem; letter-spacing:1px; text-transform:uppercase; color:var(--muted2); display:block; margin-bottom:4px;}

  .lfoot{margin-top:44px; padding-top:18px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:14px; justify-content:space-between; align-items:center; font-family:var(--mono); font-size:.78rem; color:var(--muted2);}
  .lfoot .fnav{display:flex; gap:16px; flex-wrap:wrap;}
  .lfoot a{color:var(--muted); border:none;}
  .lfoot a:hover{color:var(--text);}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#27e8ff"/><stop offset=".4" stop-color="#a78bfa"/><stop offset=".72" stop-color="#ff2e97"/><stop offset="1" stop-color="#ffd84a"/>
  </linearGradient>
</defs></svg>

<div class="lwrap">
  <header class="ltop">
    <a class="brand" href="index.html" aria-label="Unicorner — strona główna">
      <svg class="horn" viewBox="0 0 24 24" aria-hidden="true"><path class="seg" d="M12 1 L15 22 H9 Z"/></svg>
      <span class="wordmark">unicorner</span>
    </a>
    <a class="back" href="index.html">← Strona główna</a>
  </header>

  <div class="lhead">
    <span class="eyebrow"><span class="dot"></span>Zasady korzystania</span>
    <h1><span class="grad">Regulamin</span></h1>
    <p class="updated">Ostatnia aktualizacja: {updated}</p>
    <p class="lede">Unicorner to <b>nieoficjalny, studencki</b> serwis z materiałami do nauki. Poniżej zasady korzystania oraz — ważne — skąd biorą się pytania i co zrobić, jeśli uważasz, że coś narusza Twoje prawa.</p>
  </div>

  <section class="lsec">
    <h2><span class="n">01</span> O serwisie</h2>
    <p>Unicorner (unicorner.pl) prowadzi <b>Zespół Unicorner</b> — grupa studentów. Udostępniamy fiszki, zadania, quizy oraz generator materiałów oparty o AI, tworzone pomocniczo do nauki i powtórek.</p>
    <p>Serwis jest <b>niezależny i nieoficjalny</b> — niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu, żadną katedrą, platformą egzaminacyjną ani inną instytucją. Nazwy przedmiotów i kursów są użyte wyłącznie w celu opisania, czego dotyczą materiały.</p>
  </section>

  <section class="lsec callout">
    <span class="tag">Ważne</span>
    <h2>02 · O pytaniach i materiałach</h2>
    <p>Wszystkie pytania, quizy, zadania i fiszki na Unicorner to <b>nasze własne opracowania</b>, tworzone na podstawie ogólnodostępnego materiału z zajęć, podręczników i źródeł publicznych — częściowo z pomocą narzędzi AI.</p>
    <p><b>Nie korzystamy z zamkniętych baz pytań egzaminacyjnych ani z żadnych źródeł nielegalnych czy niedostępnych publicznie.</b> Nie publikujemy prezentacji ani materiałów wykładowców.</p>
    <p>Jeżeli pytanie na stronie przypomina pytanie z egzaminu, wynika to <b>wyłącznie z pokrywania się tego samego materiału</b> oraz sposobu, w jaki AI go przetwarza — takie podobieństwo jest <b>przypadkowe</b>. Materiały służą do nauki i powtórki; nie są „przeciekami” ani kopią żadnego konkretnego testu.</p>
  </section>

  <section class="lsec">
    <h2><span class="n">03</span> Charakter materiałów i brak gwarancji</h2>
    <p>Materiały mają charakter <b>pomocniczy i edukacyjny</b>. Mimo starań mogą zawierać błędy lub uproszczenia — dotyczy to zwłaszcza treści generowanych przez AI. <b>Nie gwarantujemy kompletności, poprawności ani zdania egzaminu.</b> Zawsze ucz się także z oryginalnych źródeł, a z serwisu korzystaj na własną odpowiedzialność.</p>
  </section>

  <section class="lsec">
    <h2><span class="n">04</span> Prawa autorskie</h2>
    <p>Opracowania, teksty i grafiki w serwisie (poza materiałami oznaczonymi inaczej) są <b>naszym utworem</b>. Możesz z nich korzystać do własnej nauki. Kopiowanie, publiczne udostępnianie lub redystrybucja bez naszej zgody nie są dozwolone.</p>
    <p>Znaki towarowe, nazwy i logo należące do osób trzecich pozostają własnością ich właścicieli. Wykorzystane komponenty zewnętrzne (np. model 3D „three-skull”, Cullen Webber, licencja MIT) są używane zgodnie z ich licencjami.</p>
  </section>

  <section class="lsec">
    <h2><span class="n">05</span> Zasady korzystania</h2>
    <ul>
      <li><b>Generator AI:</b> nie wgrywaj materiałów, do których nie masz praw. Pliki są przetwarzane wyłącznie w celu wygenerowania fiszek i quizu.</li>
      <li><b>Opinie:</b> zostawiaj kulturalne i zgodne z prawem wpisy. Możemy usuwać treści obraźliwe, spamowe lub naruszające prawa innych.</li>
      <li>Nie korzystaj z serwisu w sposób, który zakłóca jego działanie lub jest niezgodny z prawem.</li>
    </ul>
  </section>

  <section class="lsec">
    <h2><span class="n">06</span> Kontakt i zmiany</h2>
    <p>Możemy aktualizować regulamin wraz z rozwojem serwisu — aktualna wersja zawsze jest pod tym adresem, a data zmiany widnieje na górze. W sprawach prywatności zajrzyj do <a href="prywatnosc.html">Polityki prywatności</a>.</p>
    <div class="contact">
      <span class="k">Kontakt</span>
      <p style="color:var(--text);margin:0;"><a href={`mailto:${mail}`}>{mail}</a></p>
    </div>
  </section>

  <div class="lfoot">
    <div class="fnav">
      <a href="index.html">Strona główna</a>
      <a href="prywatnosc.html">Polityka prywatności</a>
      <a href="recenzje.html">Opinie</a>
    </div>
    <span>© 2026 Unicorner</span>
  </div>
</div>
</Base>
