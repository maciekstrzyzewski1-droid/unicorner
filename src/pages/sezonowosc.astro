---
import Base from '../layouts/Base.astro';
import cssStatKorelacjaMotyw from '../styles/stat-korelacja-motyw.css?raw';
import cssStatCyberpunkB from '../styles/stat-cyberpunk-b.css?raw';
import cssStatPelnyMotyw from '../styles/stat-pelny-motyw.css?raw';
import cssGigaNapis from '../styles/giga-napis.css?raw';
const title = "Sezonowość — analiza szeregów czasowych · Unicorner";
const description = "Wahania sezonowe: składowe szeregu czasowego, model addytywny i multiplikatywny, wskaźniki sezonowości, oczyszczanie i prognozowanie. Materiały, ściąga Excela, zadania i quiz.";
---

<Base title={title} description={description}>
<style is:inline set:html={cssStatKorelacjaMotyw}></style>
<style is:inline set:html={cssStatCyberpunkB}></style>
<style is:inline set:html={cssStatPelnyMotyw}></style>
<style is:inline set:html={cssGigaNapis}></style>

<div class="scanbar" aria-hidden="true"></div><div class="uc-sweep" aria-hidden="true"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#5ad1ff"/><stop offset="0.34" stop-color="#a78bfa"/>
    <stop offset="0.66" stop-color="#f472b6"/><stop offset="1" stop-color="#fcd34d"/>
  </linearGradient>
</defs></svg>

<div class="wrap">
  <header>
    <div class="topbar">
      <a class="brand" href="index.html">
        <svg class="horn" viewBox="0 0 24 24" aria-hidden="true"><path class="seg" d="M12 1 L15 22 H9 Z"/></svg>
        <span class="wordmark">Uni<span class="ai">corner</span></span>
      </a>
      <a class="back" href="index.html">← wszystkie przedmioty</a>
    </div>
  </header>

  <section class="hero">
    <span class="eyebrow"><span class="dot"></span>Statystyka · UEP</span>
    <h1>Analiza <span class="grad">sezonowości</span></h1>
    <p class="lede">Regularne wahania w szeregu czasowym: składowe szeregu, model <b>addytywny i multiplikatywny</b>, <b>wskaźniki sezonowości</b> (Sᵢ = yᵢ/ŷᵢ), oczyszczanie z sezonowości oraz prognozowanie trend + wskaźniki.</p>
  </section>

  <nav class="pills">
    <a href="#materialy">Materiały</a>
    <a href="#excel">Ściąga Excela</a>
    <a href="#zadania">Zadania</a>
    <a href="#quiz">Quiz</a>
  </nav>

  <!-- ===================== MATERIAŁY ===================== -->
  <section class="block" id="materialy">
    <div class="sec-head"><span class="num">01</span><h2>Materiały</h2><span class="line"></span></div>
    <p class="sub-note">Szereg czasowy to nie tylko trend. Na wartość w danym okresie składają się: długookresowa <b>tendencja</b>, powtarzalne <b>wahania sezonowe</b>, wolne <b>wahania cykliczne</b> i losowy „szum”. Sezonowość opisujemy <b>wskaźnikami sezonowości</b>.</p>

    <div class="cards">

      <div class="mcard">
        <h3>Składowe szeregu czasowego</h3>
        <div class="tagline">z czego składa się yₜ</div>
        <ul>
          <li><b>T — tendencja</b>: długookresowy kierunek zmian</li>
          <li><b>S — sezonowość</b>: regularne wahania w stałych odstępach (kwartał, miesiąc)</li>
          <li><b>C — wahania cykliczne</b>: długie cykle o zmiennym rytmie (koniunktura)</li>
          <li><b>ε — wahania przypadkowe</b>: losowy, nieprzewidywalny szum</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Addytywna vs multiplikatywna</h3>
        <div class="tagline">dwa modele sezonowości</div>
        <span class="fml">addytywny: <span class="v">yₜ = T + S + ε</span></span>
        <span class="fml">multiplikatywny ★: <span class="v">yₜ = T · S · ε</span></span>
        <ul>
          <li><b>Addytywny</b>: amplituda wahań stała, niezależna od trendu</li>
          <li><b>Multiplikatywny</b>: amplituda rośnie wraz z trendem (wahania proporcjonalne)</li>
          <li>W multiplikatywnym wskaźniki to ilorazy, ich średnia = 1</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Wskaźnik sezonowości Sᵢ</h3>
        <div class="tagline">model multiplikatywny</div>
        <span class="fml"><span class="v">Sᵢ = yᵢ / ŷᵢ</span> (średnia jednoimiennych)</span>
        <div class="scale">
          <div class="row"><span class="bar" style="width:70px;background:#f472b6"></span><span class="lbl"><b>S &gt; 1</b> — sezon wysoki (S=1,18 → +18% nad trendem)</span></div>
          <div class="row"><span class="bar" style="width:46px;background:#a78bfa"></span><span class="lbl"><b>S = 1</b> — brak wahań sezonowych</span></div>
          <div class="row"><span class="bar" style="width:30px;background:#3a2e74"></span><span class="lbl"><b>S &lt; 1</b> — sezon niski (S=0,86 → −14% pod trendem)</span></div>
        </div>
      </div>

      <div class="mcard">
        <h3>Zasady wskaźników</h3>
        <div class="tagline">warunki kontrolne</div>
        <ul>
          <li>Suma wskaźników <b>kwartalnych = 4,000</b></li>
          <li>Suma wskaźników <b>miesięcznych = 12,000</b></li>
          <li>Największa sezonowość = <b>największe odchylenie od 1</b> (S=0,70 silniejsza niż S=1,10)</li>
        </ul>
        <div class="callout">Jeśli suma nie wychodzi równa 4/12 — <b>normalizujemy</b>: każdy Sᵢ × (4 / suma wskaźników).</div>
      </div>

      <div class="mcard">
        <h3>Procedura — metoda trendu</h3>
        <div class="tagline">krok po kroku</div>
        <ul>
          <li><b>1.</b> Dopasuj trend ŷ = a₀ + a₁·t</li>
          <li><b>2.</b> Policz wskaźniki indywidualne yᵢ/ŷᵢ</li>
          <li><b>3.</b> Uśrednij jednoimienne okresy → Sᵢ (Q1, Q2, …)</li>
          <li><b>4.</b> Sprawdź sumę (=4) i w razie potrzeby znormalizuj</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Prognozowanie — trend + SI</h3>
        <div class="tagline">metoda 1</div>
        <span class="fml"><span class="v">ŷ(T+k) = (a₀ + a₁·(T+k)) · Sᵢ</span></span>
        <ul>
          <li>Policz wartość trendu dla przyszłego okresu</li>
          <li>Przemnóż przez wskaźnik sezonowości danego kwartału</li>
        </ul>
        <div class="callout">Inne metody: <b>szereg oczyszczony</b> (usuń S, prognozuj trend, dołóż S z powrotem) oraz <b>szeregi jednoimienne</b> (osobny trend dla każdego kwartału).</div>
      </div>

      <div class="mcard">
        <h3>Oczyszczanie z sezonowości</h3>
        <div class="tagline">deseasonalizacja</div>
        <span class="fml"><span class="v">y_oczyszczone = yᵢ / Sᵢ</span></span>
        <ul>
          <li>Usuwa wahania sezonowe — zostaje trend + szum</li>
          <li>Pozwala porównać okresy „w oderwaniu” od sezonu</li>
          <li>W modelu addytywnym: y − S</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Przykład — PolShop Online</h3>
        <div class="tagline">przychody kwartalne 2020–2024</div>
        <p>Trend: ŷ = 30,29 + 1,20·t (R² = 0,625 — sezonowość zaniża dopasowanie).</p>
        <ul>
          <li>Q1 = <b>0,857</b> (−14,3%) · Q2 = <b>1,033</b> (+3,3%)</li>
          <li>Q3 = <b>0,934</b> (−6,6%) · Q4 = <b>1,177</b> (+17,7%)</li>
          <li>Suma = 4,001 ≈ 4 ✓ · najsilniejszy sezon: <b>Q4</b> (Black Friday, święta)</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ===================== ŚCIĄGA EXCEL ===================== -->
  <section class="block" id="excel">
    <div class="sec-head"><span class="num">02</span><h2>Ściąga funkcji Excela</h2><span class="line"></span></div>
    <p class="sub-note">Najpierw trend (nachylenie + wyraz wolny), potem wskaźniki indywidualne, uśrednienie okresów jednoimiennych, kontrola sumy i ewentualna normalizacja. Prognoza to trend przemnożony przez wskaźnik.</p>
    <div class="xtable-wrap">
      <table class="xt">
        <thead><tr><th>Co liczysz</th><th>Funkcja Excela</th><th>Uwaga</th></tr></thead>
        <tbody>
          <tr><td class="measure"><b>Trend ŷ = a₀ + a₁·t</b></td><td class="fn">=REGLINX(t;Y;okresy)</td><td>Lub NACHYLENIE(a₁) i ODCIĘTA(a₀)</td></tr>
          <tr><td class="measure"><b>Wskaźnik indywidualny yᵢ/ŷᵢ</b></td><td class="fn">=yᵢ/ŷᵢ</td><td>Dla każdego okresu osobno</td></tr>
          <tr><td class="measure"><b>Wskaźnik sezonowości Sᵢ</b></td><td class="fn">=ŚREDNIA.JEŻELI(kwartały;"Q1";wsk)</td><td>Średnia z okresów jednoimiennych</td></tr>
          <tr><td class="measure"><b>Kontrola sumy</b></td><td class="fn">=SUMA(S1:S4)</td><td>Powinno wyjść 4 (kwartały)</td></tr>
          <tr><td class="measure"><b>Normalizacja</b></td><td class="fn">=Sᵢ*4/SUMA(S1:S4)</td><td>Gdy suma ≠ 4</td></tr>
          <tr><td class="measure"><b>Prognoza (trend + SI)</b></td><td class="fn">=(a₀+a₁*t)*Sᵢ</td><td>Model multiplikatywny</td></tr>
          <tr><td class="measure"><b>Oczyszczanie z sezonowości</b></td><td class="fn">=yᵢ/Sᵢ</td><td>Szereg bez wahań sezonowych</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== ZADANIA ===================== -->
  <section class="block" id="zadania">
    <div class="sec-head"><span class="num">03</span><h2>Zadania krok po kroku</h2><span class="line"></span></div>
    <p class="sub-note">Dane PolShop Online: trend ŷ = 30,29 + 1,20·t; wskaźniki Q1 = 0,857 · Q2 = 1,033 · Q3 = 0,934 · Q4 = 1,177. Model multiplikatywny. Akceptuję przecinek/kropkę i drobne zaokrąglenia.</p>
    <div id="exList"></div>
    <div class="progress"><span class="lbl" id="exLbl">0 / 0</span><div class="bar"><i id="exFill"></i></div></div>
  </section>

  <!-- ===================== QUIZ ===================== -->
  <section class="block" id="quiz">
    <div class="sec-head"><span class="num">04</span><h2>Quiz teoretyczny</h2><span class="line"></span></div>
    <p class="sub-note">Składowe szeregu, modele addytywny/multiplikatywny, wskaźniki i ich interpretacja, oczyszczanie i prognozowanie.</p>
    <div id="quizList"></div>
    <div class="quiz-score" id="quizScore" style="display:none">
      <div class="big" id="scoreBig">0 / 0</div>
      <div id="scoreMsg" style="color:var(--muted);margin-top:6px"></div>
    </div>
  </section>

  <div class="giant" aria-hidden="true"><span>SEZONOWOSC</span></div>

  <footer>
    <p class="disclaimer">
      <b>Projekt studencki.</b> Niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu ani żadną katedrą.
      Materiały to własne opracowania na bazie zajęć. Licz też z oryginalnych źródeł.
    </p>
  </footer>
</div>

<script is:inline>
const EXS=[
 {theme:'Wskaźnik indyw.', diff:'łatwe',
  title:'Wskaźnik indywidualny yᵢ/ŷᵢ',
  data:'2020 Q4: wartość rzeczywista yᵢ = 42,1 mln PLN, wartość z trendu ŷᵢ = 35,08 mln PLN. Policz wskaźnik indywidualny.',
  ans:1.20, tol:0.01, unit:'',
  sol:[['Wzór','wskaźnik indywidualny = yᵢ / ŷᵢ'],
       ['Podstawienie','= 42,1 / 35,08 = <span class="calc">1,200</span>'],
       ['Sens','ten kwartał leży 20% powyżej linii trendu']],
  excel:'=42,1/35,08'},

 {theme:'Wskaźnik sez.', diff:'średnie',
  title:'Wskaźnik sezonowości jako średnia',
  data:'Indywidualne wskaźniki dla Q1 z pięciu lat: 0,905 · 0,866 · 0,847 · 0,839 · 0,827. Policz wskaźnik sezonowości Q1.',
  ans:0.857, tol:0.003, unit:'',
  sol:[['Wzór','Sᵢ = średnia arytmetyczna wskaźników jednoimiennych'],
       ['Suma','0,905 + 0,866 + 0,847 + 0,839 + 0,827 = 4,284'],
       ['Wynik','= 4,284 / 5 = <span class="calc">0,857</span>']],
  excel:'=ŚREDNIA(0,905;0,866;0,847;0,839;0,827)'},

 {theme:'Kontrola', diff:'łatwe',
  title:'Suma wskaźników kwartalnych',
  data:'Wskaźniki: Q1 = 0,857, Q2 = 1,033, Q3 = 0,934, Q4 = 1,177. Policz ich sumę (warunek kontrolny).',
  ans:4.001, tol:0.003, unit:'',
  sol:[['Dodawanie','0,857 + 1,033 + 0,934 + 1,177 = <span class="calc">4,001</span>'],
       ['Wniosek','≈ 4,000 → warunek spełniony (dla kwartałów suma = 4)']],
  excel:'=SUMA(S1:S4)'},

 {theme:'Interpretacja', diff:'łatwe',
  title:'O ile procent powyżej trendu',
  data:'Wskaźnik sezonowości Q4 wynosi S = 1,177. O ile procent sprzedaż w Q4 jest przeciętnie powyżej trendu?',
  ans:17.7, tol:0.2, unit:'%',
  sol:[['Wzór','(S − 1) · 100%'],
       ['Podstawienie','= (1,177 − 1) · 100% = <span class="calc">17,7%</span>'],
       ['Sens','Q4 to najsilniejszy sezon (Black Friday, święta)']],
  excel:'=(1,177−1)*100'},

 {theme:'Interpretacja', diff:'łatwe',
  title:'O ile procent poniżej trendu',
  data:'Wskaźnik sezonowości Q1 wynosi S = 0,857. O ile procent sprzedaż w Q1 jest przeciętnie poniżej trendu?',
  ans:14.3, tol:0.2, unit:'%',
  sol:[['Wzór','(1 − S) · 100%'],
       ['Podstawienie','= (1 − 0,857) · 100% = <span class="calc">14,3%</span>'],
       ['Sens','Q1 to sezon niski — spowolnienie po świętach']],
  excel:'=(1−0,857)*100'},

 {theme:'Trend', diff:'średnie',
  title:'Wartość trendu dla przyszłego okresu',
  data:'Trend ŷ = 30,29 + 1,20·t. Policz wartość trendu dla 2025 Q1, czyli t = 21.',
  ans:55.49, tol:0.3, unit:'mln zł',
  sol:[['Podstawienie','ŷ = 30,29 + 1,20·21 = 30,29 + 25,20'],
       ['Wynik','ŷ = <span class="calc">55,49</span> mln zł (to jeszcze bez sezonowości)']],
  excel:'=30,29+1,20*21'},

 {theme:'Prognoza', diff:'trudne',
  title:'Prognoza metodą trend + wskaźniki (Q4)',
  data:'Dla 2025 Q4 wartość trendu wynosi 59,07 mln zł, a wskaźnik sezonowości Q4 to S = 1,177. Policz prognozę.',
  ans:69.5, tol:0.6, unit:'mln zł',
  sol:[['Wzór','ŷ = (a₀ + a₁·t) · Sᵢ'],
       ['Podstawienie','= 59,07 · 1,177 = <span class="calc">69,5</span> mln zł'],
       ['Sens','trend pomnożony przez wysoki sezon Q4']],
  excel:'=59,07*1,177'},

 {theme:'Szeregi jednoim.', diff:'średnie',
  title:'Prognoza — szeregi jednoimienne (Q1)',
  data:'Osobny trend dla Q1: y = 24,85 + 3,39·t (t = numer roku). Dla 2025 rok ma numer t = 6. Policz prognozę Q1 2025.',
  ans:45.2, tol:0.3, unit:'mln zł',
  sol:[['Podstawienie','y = 24,85 + 3,39·6 = 24,85 + 20,34'],
       ['Wynik','y = <span class="calc">45,2</span> mln zł']],
  excel:'=24,85+3,39*6'},

 {theme:'Oczyszczanie', diff:'średnie',
  title:'Oczyszczanie z sezonowości',
  data:'2024 Q4: wartość rzeczywista yᵢ = 63,1 mln zł, wskaźnik sezonowości S = 1,177. Policz wartość oczyszczoną z sezonowości.',
  ans:53.6, tol:0.3, unit:'mln zł',
  sol:[['Wzór','y_oczyszczone = yᵢ / Sᵢ'],
       ['Podstawienie','= 63,1 / 1,177 = <span class="calc">53,6</span> mln zł'],
       ['Sens','usuwamy efekt świątecznego sezonu — zostaje trend + szum']],
  excel:'=63,1/1,177'},

 {theme:'Porównanie', diff:'łatwe',
  title:'Średnia z dwóch prognoz',
  data:'Prognoza Q1 2025 metodą 1 = 47,5 mln zł, metodą 2 = 45,2 mln zł. Policz średnią z obu metod.',
  ans:46.35, tol:0.1, unit:'mln zł',
  sol:[['Dodawanie','(47,5 + 45,2) / 2 = 92,7 / 2'],
       ['Wynik','= <span class="calc">46,35</span> mln zł']],
  excel:'=ŚREDNIA(47,5;45,2)'}
];

const KEY='unicorner_sezon_v1';
let solved=JSON.parse(localStorage.getItem(KEY)||'{}');
const exList=document.getElementById('exList');
EXS.forEach((e,i)=>{
  const d=document.createElement('div'); d.className='ex'+(solved['e'+i]?' solved':''); d.id='ex'+i;
  d.innerHTML=`
    <div class="ex-top"><span class="ex-theme">${e.theme}</span><span class="ex-diff">${e.diff}</span></div>
    <h3>${i+1}. ${e.title}</h3>
    <div class="data">${e.data}</div>
    <div class="answer-row">
      <input type="text" inputmode="decimal" placeholder="Twój wynik" aria-label="wynik">
      ${e.unit?`<span class="unit">${e.unit}</span>`:''}
      <button class="btn" data-act="check">Sprawdź</button>
      <button class="btn ghost" data-act="show">Pokaż rozwiązanie</button>
    </div>
    <div class="verdict"></div>
    <div class="solution">
      <h4>Rozwiązanie</h4>
      ${e.sol.map(s=>`<div class="step"><b>${s[0]}:</b> ${s[1]}</div>`).join('')}
      <div class="excel-tag"><span>▦</span><b>W Excelu:</b> ${e.excel}</div>
    </div>`;
  const inp=d.querySelector('input'), verd=d.querySelector('.verdict'), sol=d.querySelector('.solution');
  const reveal=ok=>{ sol.classList.add('show'); if(ok){ d.classList.add('solved'); solved['e'+i]=1; localStorage.setItem(KEY,JSON.stringify(solved)); updateProg(); } };
  d.querySelector('[data-act=check]').onclick=()=>{
    const raw=inp.value.replace(',','.').replace(/[^0-9.\-]/g,'');
    if(raw===''){verd.className='verdict bad';verd.textContent='Wpisz wynik liczbowy.';return;}
    const v=parseFloat(raw); const ok=Math.abs(v-e.ans)<=(e.tol||0.01)+1e-9;
    if(ok){verd.className='verdict ok';verd.textContent='✓ Dobrze! Wynik: '+String(e.ans).replace('.',',')+(e.unit?' '+e.unit:'');}
    else{verd.className='verdict bad';verd.textContent='✗ Nie tym razem — sprawdź rozwiązanie poniżej.';}
    reveal(ok);
  };
  d.querySelector('[data-act=show]').onclick=()=>{ sol.classList.add('show'); };
  inp.addEventListener('keydown',ev=>{if(ev.key==='Enter')d.querySelector('[data-act=check]').click();});
  exList.appendChild(d);
});
function updateProg(){
  const done=EXS.filter((_,i)=>solved['e'+i]).length;
  document.getElementById('exLbl').textContent=done+' / '+EXS.length;
  document.getElementById('exFill').style.width=(done/EXS.length*100)+'%';
}
updateProg();

const QUIZ=[
 {q:'Na wartość szeregu czasowego yₜ składają się:',
  o:['Tylko tendencja i szum','Tendencja, wahania sezonowe, cykliczne i przypadkowe','Wyłącznie wahania sezonowe','Średnia i mediana'],c:1,
  e:'Klasyczny rozkład szeregu: <b>T</b> (tendencja), <b>S</b> (sezonowość), <b>C</b> (cykl) i <b>ε</b> (wahania przypadkowe).'},
 {q:'Wahania sezonowe to:',
  o:['Nieregularne, losowe odchylenia','Regularne wahania powtarzające się w stałych odstępach','Długookresowy kierunek zmian','Cykle koniunkturalne trwające kilka lat'],c:1,
  e:'Sezonowość = <b>regularne, powtarzalne</b> wahania w stałych odstępach (kwartał, miesiąc), w odróżnieniu od losowego szumu.'},
 {q:'Model multiplikatywny sezonowości ma postać:',
  o:['yₜ = T + S + ε','yₜ = T · S · ε','yₜ = T − S','yₜ = S / T'],c:1,
  e:'Model multiplikatywny: <b>yₜ = T · S · ε</b>. Amplituda wahań rośnie wraz z poziomem trendu.'},
 {q:'W modelu addytywnym amplituda wahań sezonowych:',
  o:['Rośnie wraz z trendem','Jest stała, niezależna od poziomu trendu','Zawsze maleje','Jest zawsze zerowa'],c:1,
  e:'Addytywny (yₜ = T + S + ε): wahania mają <b>stałą amplitudę</b>, niezależną od poziomu zjawiska.'},
