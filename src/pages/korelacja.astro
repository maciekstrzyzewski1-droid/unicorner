---
import Base from '../layouts/Base.astro';
import cssStatKorelacjaMotyw from '../styles/stat-korelacja-motyw.css?raw';
import cssStatCyberpunkB from '../styles/stat-cyberpunk-b.css?raw';
import cssStatPelnyMotyw from '../styles/stat-pelny-motyw.css?raw';
import cssGigaNapis from '../styles/giga-napis.css?raw';
const title = "Analiza korelacji — Pearson i Spearman · Unicorner";
const description = "Współczynnik korelacji liniowej Pearsona i korelacja rang Spearmana: wzory, interpretacja siły i kierunku, istotność. Materiały, ściąga Excela, zadania i quiz.";
---

<Base title={title} description={description}>
<style is:inline set:html={cssStatKorelacjaMotyw}></style>
<style is:inline set:html={cssStatCyberpunkB}></style>
<style is:inline set:html={cssStatPelnyMotyw}></style>
<style is:inline set:html={cssGigaNapis}></style>

<div class="scanbar" aria-hidden="true"></div><div class="uc-sweep" aria-hidden="true"></div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#5ad1ff"/><stop offset="0.34" stop-color="#a78bfa"/>
    <stop offset="0.66" stop-color="#f472b6"/><stop offset="1" stop-color="#fcd34d"/>
  </linearGradient>
</defs></svg>

<div class="wrap">
  <header>
    <div class="topbar">
      <a class="brand" href="index.html">
        <svg class="horn" viewBox="0 0 24 24" aria-hidden="true"><path class="seg" d="M12 1 L15 22 H9 Z"/></svg>
        <span class="wordmark">Uni<span class="ai">corner</span></span>
      </a>
      <a class="back" href="index.html">← wszystkie przedmioty</a>
    </div>
  </header>

  <section class="hero">
    <span class="eyebrow"><span class="dot"></span>Statystyka opisowa · UEP</span>
    <h1>Analiza <span class="grad">korelacji</span></h1>
    <p class="lede">Siła i kierunek zależności między dwiema zmiennymi: <b>współczynnik Pearsona</b> dla danych ilościowych i <b>korelacja rang Spearmana</b> dla porządkowych. Plus interpretacja i istotność statystyczna.</p>
  </section>

  <nav class="pills">
    <a href="#materialy">Materiały</a>
    <a href="#excel">Ściąga Excela</a>
    <a href="#zadania">Zadania</a>
    <a href="#quiz">Quiz</a>
  </nav>

  <!-- ===================== MATERIAŁY ===================== -->
  <section class="block" id="materialy">
    <div class="sec-head"><span class="num">01</span><h2>Materiały</h2><span class="line"></span></div>
    <p class="sub-note">Korelacja mierzy <b>współwystępowanie</b> zmian dwóch cech — jej <b>kierunek</b> (dodatni/ujemny) i <b>siłę</b>. Pierwszy krok zawsze: uzasadnij, że związek ma sens logiczny. Wybór miary zależy od skali pomiaru: ilościowa → Pearson, porządkowa → Spearman.</p>

    <div class="cards">

      <div class="mcard">
        <h3>Współczynnik Pearsona r</h3>
        <div class="tagline">zależność liniowa · dane ilościowe</div>
        <span class="fml"><span class="v">r = cov(x,y) / (Sₓ · Sᵧ)</span></span>
        <span class="fml">równoważnie:<br><span class="v">r = Σ(xᵢ−x̄)(yᵢ−ȳ) / √(Σ(xᵢ−x̄)²·Σ(yᵢ−ȳ)²)</span></span>
        <ul>
          <li>Założenia: obie zmienne <b>ilościowe</b>, zależność <b>w przybliżeniu liniowa</b></li>
          <li>cov(x,y) — kowariancja, Sₓ/Sᵧ — odchylenia standardowe</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Własności r</h3>
        <div class="tagline">co trzeba wiedzieć</div>
        <ul>
          <li>Przyjmuje wartości z przedziału <b>⟨−1; 1⟩</b></li>
          <li><b>Symetryczny</b>: r<sub>xy</sub> = r<sub>yx</sub></li>
          <li><b>Niemianowany</b> (bez jednostek)</li>
          <li><b>r = 0</b> → brak korelacji liniowej (niezależne)</li>
          <li><b>r &gt; 0</b> dodatnia, <b>r &lt; 0</b> ujemna; ±1 → zależność funkcyjna</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Skala interpretacji |r|</h3>
        <div class="tagline">jak nazwać siłę związku</div>
        <div class="scale">
          <div class="row"><span class="bar" style="width:24px;background:#3a2e74"></span><span class="lbl">&lt; 0,2 — <b>brak</b> zależności</span></div>
          <div class="row"><span class="bar" style="width:40px;background:#5a4fa0"></span><span class="lbl">0,2–0,4 — <b>słaba</b></span></div>
          <div class="row"><span class="bar" style="width:60px;background:#8b5cf6"></span><span class="lbl">0,4–0,7 — <b>umiarkowana</b></span></div>
          <div class="row"><span class="bar" style="width:80px;background:#c084fc"></span><span class="lbl">0,7–0,9 — <b>znacząca</b></span></div>
          <div class="row"><span class="bar" style="width:100px;background:#f472b6"></span><span class="lbl">0,9–1,0 — <b>bardzo silna</b></span></div>
        </div>
      </div>

      <div class="mcard">
        <h3>Korelacja rang Spearmana</h3>
        <div class="tagline">dane porządkowe / mała próba</div>
        <span class="fml"><span class="v">r_s = 1 − 6·Σdᵢ² / [n(n²−1)]</span></span>
        <ul>
          <li>dᵢ = r1ᵢ − r2ᵢ — różnica rang i-tego obiektu</li>
          <li>Założenie: ≥1 zmienna <b>porządkowa</b> (druga porządkowa lub ilościowa)</li>
          <li>Albo gdy zmienne ilościowe, ale <b>mało obserwacji</b></li>
          <li>Też z przedziału ⟨−1; 1⟩, symetryczny, niemianowany</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Procedura Spearmana</h3>
        <div class="tagline">krok po kroku</div>
        <ul>
          <li><b>1.</b> Uporządkuj obiekty wg każdej cechy (tak samo)</li>
          <li><b>2.</b> Nadaj <b>rangi</b> (1, 2, 3, …)</li>
          <li><b>3.</b> Policz dᵢ = różnica rang i dᵢ²</li>
          <li><b>4.</b> Podstaw do wzoru na r_s</li>
        </ul>
        <div class="callout"><b>Rangi wiązane:</b> gdy wartości są równe, każda dostaje <b>średnią</b> z rang, które by jej przypadły (np. pozycje 2 i 3 → obie 2,5).</div>
      </div>

      <div class="mcard">
        <h3>Istotność statystyczna</h3>
        <div class="tagline">czy związek jest „prawdziwy"</div>
        <span class="fml"><span class="v">t = r_s · √[(n−2)/(1−r_s²)]</span></span>
        <ul>
          <li><b>H₀:</b> cechy nieskorelowane w populacji</li>
          <li><b>H₁:</b> występuje korelacja</li>
          <li>t_kryt z rozkładu t-Studenta, df = <b>n−2</b>, zwykle α = 0,05</li>
          <li>|t| ≥ t_kryt → <b>odrzucamy H₀</b> (związek istotny)</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Korelacja ≠ przyczynowość</h3>
        <div class="tagline">najważniejsza pułapka</div>
        <p>Wysokie r mówi tylko, że zmienne <b>zmieniają się razem</b> — nie, że jedna powoduje drugą.</p>
        <ul>
          <li>Może istnieć <b>trzecia zmienna</b> wpływająca na obie</li>
          <li>Związek może być <b>pozorny</b> (przypadkowy)</li>
          <li>Dlatego krok 1 to <b>uzasadnienie logiczne</b> związku</li>
        </ul>
      </div>

      <div class="mcard">
        <h3>Pearson kontra Spearman</h3>
        <div class="tagline">którego użyć</div>
        <ul>
          <li><b>Pearson</b>: ilościowe, zależność liniowa, większa próba</li>
          <li><b>Spearman</b>: porządkowe (oceny, rankingi) lub mała próba</li>
          <li>Spearman = Pearson policzony <b>na rangach</b></li>
          <li>Spearman łapie zależność <b>monotoniczną</b>, niekoniecznie liniową</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- ===================== ŚCIĄGA EXCEL ===================== -->
  <section class="block" id="excel">
    <div class="sec-head"><span class="num">02</span><h2>Ściąga funkcji Excela</h2><span class="line"></span></div>
    <p class="sub-note">Pearsona policzysz jedną funkcją. Spearmana nie ma wprost — ranguj obie zmienne (<b>POZYCJA.ŚR</b> daje rangi wiązane jako średnie), a potem albo wzór na r_s, albo po prostu <b>WSP.KORELACJI na rangach</b> (Spearman to Pearson liczony na rangach).</p>
    <div class="xtable-wrap">
      <table class="xt">
        <thead><tr><th>Co liczysz</th><th>Funkcja Excela</th><th>Uwaga</th></tr></thead>
        <tbody>
          <tr><td class="measure"><b>Korelacja Pearsona r</b></td><td class="fn">=WSP.KORELACJI(Y;X)</td><td>Lub <span style="font-family:var(--mono)">=PEARSON(Y;X)</span> — to samo</td></tr>
          <tr><td class="measure"><b>Kowariancja</b></td><td class="fn">=KOWARIANCJA.POPUL(X;Y)</td><td>Dzielnik N (populacyjna)</td></tr>
          <tr><td class="measure"><b>Odchylenie standardowe</b></td><td class="fn">=ODCH.STANDARD.POPUL(X)</td><td>Do wzoru r = cov/(Sₓ·Sᵧ)</td></tr>
          <tr><td class="measure"><b>Rangi (z wiązanymi)</b></td><td class="fn">=POZYCJA.ŚR(wartość;zakres)</td><td>Średnie rangi dla wartości równych</td></tr>
          <tr><td class="measure"><b>Spearman r_s</b></td><td class="fn">=WSP.KORELACJI(rangi_Y;rangi_X)</td><td>Pearson policzony na rangach</td></tr>
          <tr><td class="measure"><b>Σdᵢ²</b><small>droga ze wzoru</small></td><td class="fn">=SUMA.KWADRATÓW(r1−r2)</td><td>Różnice rang do podniesienia do kwadratu</td></tr>
          <tr><td class="measure"><b>Współczynnik determinacji r²</b></td><td class="fn">=WSP.KORELACJI(Y;X)^2</td><td>Część wspólnej zmienności</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== ZADANIA ===================== -->
  <section class="block" id="zadania">
    <div class="sec-head"><span class="num">03</span><h2>Zadania krok po kroku</h2><span class="line"></span></div>
    <p class="sub-note">Przykład Pearsona: wydatki na odzież (y) a przeciętny dochód (x), 10 lat. Sumy pomocnicze: Σ(xᵢ−x̄)(yᵢ−ȳ) = 14929,59 • Σ(xᵢ−x̄)² = 397483,36 • Σ(yᵢ−ȳ)² = 589,03 • n = 10. Spearman: ranking ocen 6 studentów. Akceptuję przecinek/kropkę i drobne zaokrąglenia.</p>
    <div id="exList"></div>
    <div class="progress"><span class="lbl" id="exLbl">0 / 0</span><div class="bar"><i id="exFill"></i></div></div>
  </section>

  <!-- ===================== QUIZ ===================== -->
  <section class="block" id="quiz">
    <div class="sec-head"><span class="num">04</span><h2>Quiz teoretyczny</h2><span class="line"></span></div>
    <p class="sub-note">Wybór miary, własności r, interpretacja siły i kierunku, rangi i istotność.</p>
    <div id="quizList"></div>
    <div class="quiz-score" id="quizScore" style="display:none">
      <div class="big" id="scoreBig">0 / 0</div>
      <div id="scoreMsg" style="color:var(--muted);margin-top:6px"></div>
    </div>
  </section>

  <div class="giant" aria-hidden="true"><span>KORELACJA</span></div>

  <footer>
    <p class="disclaimer">
      <b>Projekt studencki.</b> Niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu ani żadną katedrą.
      Materiały to własne opracowania na bazie zajęć. Licz też z oryginalnych źródeł.
    </p>
  </footer>
</div>

<script is:inline>
const EXS=[
 {theme:'Kowariancja', diff:'łatwe',
  title:'Kowariancja cov(x,y)',
  data:'Z danych wydatki/dochód: Σ(xᵢ−x̄)(yᵢ−ȳ) = 14929,59, n = 10. Policz kowariancję.',
  ans:1492.96, tol:5, unit:'',
  sol:[['Wzór','cov(x,y) = Σ(xᵢ−x̄)(yᵢ−ȳ) / n'],
       ['Podstawienie','= 14929,59 / 10 = <span class="calc">1492,96</span>'],
       ['Sens','dodatnia → gdy dochód rośnie, wydatki też rosną']],
  excel:'=KOWARIANCJA.POPUL(X;Y)'},

 {theme:'Odch. standardowe', diff:'średnie',
  title:'Odchylenie standardowe dochodu Sₓ',
  data:'Σ(xᵢ−x̄)² = 397483,36, n = 10. Policz Sₓ.',
  ans:199.37, tol:1, unit:'',
  sol:[['Wzór','Sₓ = √(Σ(xᵢ−x̄)² / n)'],
       ['Podstawienie','= √(397483,36 / 10) = √39748,34'],
       ['Wynik','Sₓ = <span class="calc">199,37</span>']],
  excel:'=ODCH.STANDARD.POPUL(X)'},

 {theme:'Odch. standardowe', diff:'średnie',
  title:'Odchylenie standardowe wydatków Sᵧ',
  data:'Σ(yᵢ−ȳ)² = 589,03, n = 10. Policz Sᵧ.',
  ans:7.68, tol:0.1, unit:'',
  sol:[['Wzór','Sᵧ = √(Σ(yᵢ−ȳ)² / n)'],
       ['Podstawienie','= √(589,03 / 10) = √58,90'],
       ['Wynik','Sᵧ = <span class="calc">7,68</span>']],
  excel:'=ODCH.STANDARD.POPUL(Y)'},

 {theme:'Pearson', diff:'średnie',
  title:'Współczynnik Pearsona r (z cov i odchyleń)',
  data:'Wiedząc, że cov(x,y) = 1492,96, Sₓ = 199,37 i Sᵧ = 7,675, policz r.',
  ans:0.976, tol:0.01, unit:'',
  sol:[['Wzór','r = cov(x,y) / (Sₓ · Sᵧ)'],
       ['Podstawienie','= 1492,96 / (199,37 · 7,675) = 1492,96 / 1530,2'],
       ['Wynik','r = <span class="calc">0,976</span>']],
  excel:'=WSP.KORELACJI(Y;X)'},

 {theme:'Pearson', diff:'trudne',
  title:'Współczynnik Pearsona r (z sum)',
  data:'Z sum: Σ(xᵢ−x̄)(yᵢ−ȳ) = 14929,59, Σ(xᵢ−x̄)² = 397483,36, Σ(yᵢ−ȳ)² = 589,03. Policz r drugim wzorem.',
  ans:0.976, tol:0.01, unit:'',
  sol:[['Wzór','r = Σ(xᵢ−x̄)(yᵢ−ȳ) / √(Σ(xᵢ−x̄)²·Σ(yᵢ−ȳ)²)'],
       ['Podstawienie','= 14929,59 / √(397483,36 · 589,03) = 14929,59 / 15300'],
       ['Wynik','r = <span class="calc">0,976</span> → zależność <b>bardzo silna</b> dodatnia']],
  excel:'=WSP.KORELACJI(Y;X)'},

 {theme:'Spearman', diff:'łatwe',
  title:'Suma kwadratów różnic rang Σdᵢ²',
  data:'Różnice rang podniesione do kwadratu dla 6 studentów: 0 · 0,25 · 1 · 1 · 0,25 · 1. Policz Σdᵢ².',
  ans:3.5, tol:0, unit:'',
  sol:[['Dodawanie','0 + 0,25 + 1 + 1 + 0,25 + 1 = <span class="calc">3,5</span>'],
       ['Sens','suma dᵢ² wchodzi prosto do wzoru na r_s']],
  excel:'=SUMA(zakres dᵢ²)'},

 {theme:'Spearman', diff:'średnie',
  title:'Współczynnik korelacji rang Spearmana',
  data:'Σdᵢ² = 3,5, liczba obserwacji n = 6. Policz r_s.',
  ans:0.9, tol:0.02, unit:'',
  sol:[['Wzór','r_s = 1 − 6·Σdᵢ² / [n(n²−1)]'],
       ['Podstawienie','= 1 − 6·3,5 / [6·(36−1)] = 1 − 21/210'],
       ['Wynik','r_s = <span class="calc">0,900</span> → bardzo silna zgodność rankingów']],
  excel:'=WSP.KORELACJI(rangi_Y;rangi_X)'},

 {theme:'Rangi wiązane', diff:'łatwe',
  title:'Ranga wiązana',
  data:'Dwa obiekty mają identyczną wartość i przypadłyby im pozycje 2 oraz 3. Jaką rangę dostaje każdy z nich?',
  ans:2.5, tol:0, unit:'',
  sol:[['Reguła','ranga wiązana = średnia z rang, które by przypadły'],
       ['Obliczenie','(2 + 3) / 2 = <span class="calc">2,5</span>'],
       ['Sens','obie obserwacje dostają 2,5; następna ranga to 4']],
  excel:'=POZYCJA.ŚR(wartość;zakres)'},

 {theme:'Istotność', diff:'trudne',
  title:'Statystyka testowa t dla Spearmana',
  data:'r_s = 0,9, n = 6. Policz wartość statystyki testowej t = r_s·√[(n−2)/(1−r_s²)].',
  ans:4.13, tol:0.1, unit:'',
  sol:[['Podstawienie','t = 0,9 · √[(6−2)/(1−0,81)] = 0,9 · √(4/0,19)'],
       ['Obliczenie','= 0,9 · √21,05 = 0,9 · 4,588'],
       ['Wynik','t = <span class="calc">4,13</span>; t_kryt(α=0,05; df=4)=2,776 → odrzucamy H₀, związek istotny']],
  excel:'=0,9*PIERWIASTEK((6−2)/(1−0,9^2))'},

 {theme:'Pearson · od zera', diff:'trudne',
  title:'Policz r dla małego zbioru',
  data:'Dane: x = 1, 2, 3, 4, 5 oraz y = 2, 4, 5, 4, 5. Policz współczynnik Pearsona r.',
  ans:0.77, tol:0.02, unit:'',
  sol:[['Średnie','x̄ = 3, ȳ = 4'],
       ['Sumy','Σ(x−x̄)(y−ȳ) = 6 ; Σ(x−x̄)² = 10 ; Σ(y−ȳ)² = 6'],
       ['Wynik','r = 6 / √(10·6) = 6/√60 = <span class="calc">0,775</span> → zależność znacząca']],
  excel:'=WSP.KORELACJI({2;4;5;4;5};{1;2;3;4;5})'}
];

const KEY='unicorner_korel_v1';
let solved=JSON.parse(localStorage.getItem(KEY)||'{}');
const exList=document.getElementById('exList');
EXS.forEach((e,i)=>{
  const d=document.createElement('div'); d.className='ex'+(solved['e'+i]?' solved':''); d.id='ex'+i;
  d.innerHTML=`
    <div class="ex-top"><span class="ex-theme">${e.theme}</span><span class="ex-diff">${e.diff}</span></div>
    <h3>${i+1}. ${e.title}</h3>
    <div class="data">${e.data}</div>
    <div class="answer-row">
      <input type="text" inputmode="decimal" placeholder="Twój wynik" aria-label="wynik">
      ${e.unit?`<span class="unit">${e.unit}</span>`:''}
      <button class="btn" data-act="check">Sprawdź</button>
      <button class="btn ghost" data-act="show">Pokaż rozwiązanie</button>
    </div>
    <div class="verdict"></div>
    <div class="solution">
      <h4>Rozwiązanie</h4>
      ${e.sol.map(s=>`<div class="step"><b>${s[0]}:</b> ${s[1]}</div>`).join('')}
      <div class="excel-tag"><span>▦</span><b>W Excelu:</b> ${e.excel}</div>
    </div>`;
  const inp=d.querySelector('input'), verd=d.querySelector('.verdict'), sol=d.querySelector('.solution');
  const reveal=ok=>{ sol.classList.add('show'); if(ok){ d.classList.add('solved'); solved['e'+i]=1; localStorage.setItem(KEY,JSON.stringify(solved)); updateProg(); } };
  d.querySelector('[data-act=check]').onclick=()=>{
    const raw=inp.value.replace(',','.').replace(/[^0-9.\-]/g,'');
    if(raw===''){verd.className='verdict bad';verd.textContent='Wpisz wynik liczbowy.';return;}
    const v=parseFloat(raw); const ok=Math.abs(v-e.ans)<=(e.tol||0.01)+1e-9;
    if(ok){verd.className='verdict ok';verd.textContent='✓ Dobrze! Wynik: '+String(e.ans).replace('.',',')+(e.unit?' '+e.unit:'');}
    else{verd.className='verdict bad';verd.textContent='✗ Nie tym razem — sprawdź rozwiązanie poniżej.';}
    reveal(ok);
  };
  d.querySelector('[data-act=show]').onclick=()=>{ sol.classList.add('show'); };
  inp.addEventListener('keydown',ev=>{if(ev.key==='Enter')d.querySelector('[data-act=check]').click();});
  exList.appendChild(d);
});
function updateProg(){
  const done=EXS.filter((_,i)=>solved['e'+i]).length;
  document.getElementById('exLbl').textContent=done+' / '+EXS.length;
  document.getElementById('exFill').style.width=(done/EXS.length*100)+'%';
}
updateProg();

const QUIZ=[
 {q:'Współczynnik Pearsona stosujemy, gdy zmienne są:',
  o:['Jakościowe na skali porządkowej','Ilościowe o zależności liniowej','Nominalne i nieuporządkowane','Wyrażone w różnych jednostkach'],c:1,
  e:'Pearson wymaga danych <b>ilościowych</b> i zależności w przybliżeniu <b>liniowej</b>. Dla porządkowych używa się Spearmana.'},
 {q:'Korelację rang Spearmana wybierzemy, gdy:',
