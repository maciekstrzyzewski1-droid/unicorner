---
import Base from '../layouts/Base.astro';
import cssPrzedmiotMotyw from '../styles/przedmiot-motyw.css?raw';
import cssGigaNapis from '../styles/giga-napis.css?raw';
const title = "Geografia atrakcji turystycznych · Unicorner";
const description = "Geografia atrakcji turystycznych do egzaminu: środowisko przyrodnicze sześciu kontynentów, czyli góry, rzeki, jeziora, wulkany, pustynie i rekordy natury. Quiz z 40 pytaniami.";
---

<Base title={title} description={description}>
<style is:inline set:html={cssPrzedmiotMotyw}></style>
<style is:inline set:html={cssGigaNapis}></style>

<div class="scanbar" aria-hidden="true"></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="irisGrad" x1="0" y1="1" x2="1" y2="0">
    <stop offset="0" stop-color="#5ad1ff"/><stop offset="0.34" stop-color="#a78bfa"/>
    <stop offset="0.66" stop-color="#f472b6"/><stop offset="1" stop-color="#fcd34d"/>
  </linearGradient></defs></svg>
<header class="uc-head">
  <div class="uc-head-in">
    <a class="uc-brand" href="index.html" aria-label="Unicorner — strona główna">
      <svg class="uc-horn" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 1 L15 22 H9 Z" fill="url(#irisGrad)"/>
        <path d="M10.4 7 L13.6 7 M9.8 12 L14.2 12 M9.2 17 L14.8 17" stroke="#0c0a18" stroke-width="1.1" fill="none" opacity="0.55"/>
      </svg>
      <span class="uc-wordmark">Uni<span class="ai">corner</span></span>
    </a>
    <span class="uc-sep">/</span>
    <span class="uc-subject">Geografia atrakcji turystycznych</span>
    <a class="uc-back" href="index.html">← Wszystkie przedmioty</a>
  </div>
</header>
<div class="page-intro">
  <span class="eyebrow"><span class="dot"></span>Geografia atrakcji turystycznych · US</span>
  <h1>Świat, <span class="grad">kontynent po kontynencie.</span></h1>
  <p>Środowisko przyrodnicze sześciu kontynentów — ukształtowanie, góry i szczyty, rzeki, jeziora, wulkany i pustynie oraz świat roślin i zwierząt. Fakty, rekordy i atrakcje, plus quiz ze sprawdzaniem po każdej odpowiedzi.</p>
  <div class="meta">
    <span class="chip"><b>6</b> kontynentów</span>
    <span class="chip">Góry · Rzeki · Jeziora</span>
    <span class="chip">Wulkany</span>
    <span class="chip">Rekordy natury</span>
  </div>
</div>
<div class="container">
  <div class="tabs">
    <button class="tab active" onclick="switchTab('europa',this)">Europa</button>
    <button class="tab" onclick="switchTab('azja',this)">Azja</button>
    <button class="tab" onclick="switchTab('afryka',this)">Afryka</button>
    <button class="tab" onclick="switchTab('amerykapn',this)">Ameryka Płn.</button>
    <button class="tab" onclick="switchTab('amerykapd',this)">Ameryka Płd.</button>
    <button class="tab" onclick="switchTab('australia',this)">Australia i Oceania</button>
    <button class="tab" onclick="switchTab('quiz',this)">Quiz</button>
  </div>

  <!-- ============ EUROPA ============ -->
  <div class="section active" id="europa">
    <div class="card">
      <div class="card-label">Podstawy</div>
      <div class="card-title">Europa — położenie</div>
      <div class="card-body">Część Eurazji, drugi najmniejszy kontynent. Granica z Azją biegnie przez <strong>Ural</strong>, rzekę Ural, Morze Kaspijskie i Kaukaz. Najniższy punkt: <strong>Nizina Nadkaspijska (−28 m p.p.m.)</strong>.</div>
    </div>
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Od Alp po Kaukaz</div>
      <div class="card-body">Najwyższy szczyt Europy: <strong>Elbrus (5642 m n.p.m.)</strong> w Kaukazie. Najwyższy szczyt Alp: <strong>Mont Blanc (4808 m)</strong>. Główne pasma: Alpy (1200 km), Góry Skandynawskie (1800 km), Ural (2100 km), Karpaty, Pireneje.</div>
    </div>
    <div class="card">
      <div class="card-label">Rzeki</div>
      <div class="card-title">Wołga i Dunaj</div>
      <div class="card-body"><strong>Wołga (3531 km)</strong> — najdłuższa rzeka Europy, uchodzi do Morza Kaspijskiego. <strong>Dunaj (2850 km)</strong> — do Morza Czarnego, przepływa przez najwięcej państw. Ważne też: Ren, Łaba, Wisła.</div>
    </div>
    <div class="card">
      <div class="card-label">Wulkany</div>
      <div class="card-title">Obszary wulkaniczne Europy</div>
      <div class="card-body">Włochy: <strong>Wezuwiusz, Etna, Stromboli</strong>. Islandia: 22 czynne wulkany (m.in. <strong>Hekla</strong>, Eyjafjallajökull). Grecja: <strong>Santoryn</strong>. Azory (7 czynnych wulkanów) — styk płyt na Grzbiecie Śródatlantyckim.</div>
    </div>
    <div class="card">
      <div class="card-label">Przyroda</div>
      <div class="card-title">Świat roślin i zwierząt</div>
      <div class="card-body">Strefy roślinne od tundry na północy po roślinność śródziemnomorską na południu. Charakterystyczne zwierzęta: <strong>żubr, koziorożec alpejski, orzeł bielik, jeleń europejski</strong>, żółw błotny.</div>
    </div>
  </div>

  <!-- ============ AZJA ============ -->
  <div class="section" id="azja">
    <div class="card">
      <div class="card-label">Podstawy</div>
      <div class="card-title">Azja — kontynent rekordów</div>
      <div class="card-body"><strong>Największy kontynent świata</strong> (ok. 30% lądów). Skrajnie kontynentalna — największa odległość od morza sięga <strong>ok. 2400 km</strong>, stąd ogromne amplitudy temperatur i rozległe pustynie w głębi lądu.</div>
    </div>
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Himalaje i dach świata</div>
      <div class="card-body"><strong>Mount Everest (8848 m n.p.m.)</strong> w Himalajach — najwyższy szczyt Ziemi. Azja skupia większość najwyższych gór świata (Himalaje, Karakorum, Hindukusz, Tybet).</div>
    </div>
    <div class="card">
      <div class="card-label">Jeziora</div>
      <div class="card-title">Kaspijskie, Bajkał, Aralskie</div>
      <div class="card-body"><strong>Morze Kaspijskie (376 000 km²)</strong> — największe jezioro świata (reliktowe, słone). <strong>Bajkał</strong> — najgłębsze jezioro świata (<strong>1741 m</strong>, tektoniczne). <strong>Jezioro Aralskie</strong> — dawniej 4. jezioro świata, dziś przykład katastrofy ekologicznej (niemal wyschło).</div>
    </div>
    <div class="card">
      <div class="card-label">Rzeki i pustynie</div>
      <div class="card-title">Jangcy i Gobi</div>
      <div class="card-body"><strong>Jangcy (6300 km)</strong> — najdłuższa rzeka Azji. Inne wielkie rzeki: Ganges, Ob, Jenisej, Mekong. Pustynie: <strong>Gobi</strong> (chłodna, kontynentalna), Takla Makan, Ar-Rub al-Chali.</div>
    </div>
    <div class="card">
      <div class="card-label">Przyroda</div>
      <div class="card-title">Od tundry po tropiki</div>
      <div class="card-body">Wszystkie strefy klimatyczne — od arktycznej (renifer, chrobotek reniferowy) po równikową (dżungla). Największy archipelag świata — Archipelag Malajski.</div>
    </div>
  </div>

  <!-- ============ AFRYKA ============ -->
  <div class="section" id="afryka">
    <div class="card">
      <div class="card-label">Podstawy</div>
      <div class="card-title">Afryka — kontynent gorąca</div>
      <div class="card-body">Drugi co do wielkości kontynent, w większości w strefie międzyzwrotnikowej (równik przez środek) — najcieplejszy kontynent świata. Przez wschód biegnie <strong>Wielki Rów Afrykański</strong> (sejsmika i wulkanizm).</div>
    </div>
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Kilimandżaro</div>
      <div class="card-body">Najwyższy szczyt Afryki: <strong>Kibo/Kilimandżaro (5895 m n.p.m.)</strong> — wygasły wulkan w Tanzanii. Inne: Kenia, Ruwenzori, Atlas (na północy).</div>
    </div>
    <div class="card">
      <div class="card-label">Pustynie</div>
      <div class="card-title">Sahara i inne</div>
      <div class="card-body"><strong>Sahara</strong> — największa gorąca pustynia świata (ok. 9 mln km²). Na południu: <strong>Kalahari</strong> i <strong>Namib</strong> (nadmorska, jedna z najstarszych).</div>
    </div>
    <div class="card">
      <div class="card-label">Rzeki, jeziora, wodospady</div>
      <div class="card-title">Nil, Wiktoria, Wodospady Wiktorii</div>
      <div class="card-body"><strong>Nil</strong> — najdłuższa rzeka Afryki (i jedna z najdłuższych świata); <strong>Kongo</strong> — najzasobniejsza w wodę. Jeziora: <strong>Wiktoria</strong> (największe w Afryce), <strong>Tanganika</strong> (bardzo głębokie, w Rowie Afrykańskim). <strong>Wodospady Wiktorii</strong> na Zambezi.</div>
    </div>
    <div class="card">
      <div class="card-label">Przyroda</div>
      <div class="card-title">Sawanna i endemity</div>
      <div class="card-body">Symetryczny układ stref: wilgotne lasy równikowe → sawanny → pustynie → strefa śródziemnomorska. Zwierzęta: <strong>żyrafa, słoń, lew, krokodyl nilowy</strong>. Wyspy: Madagaskar, Zanzibar, Maskareny (Reunion, Mauritius).</div>
    </div>
  </div>

  <!-- ============ AMERYKA PÓŁNOCNA ============ -->
  <div class="section" id="amerykapn">
    <div class="card">
      <div class="card-label">Podstawy</div>
      <div class="card-title">Ameryka Północna</div>
      <div class="card-body">Rozciąga się od Arktyki po tropiki. <strong>Grenlandia</strong> — największa wyspa świata (pustynia lodowa). Na zachodzie młode <strong>Kordyliery</strong>, na wschodzie stare Appalachy.</div>
    </div>
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Denali</div>
      <div class="card-body">Najwyższy szczyt Ameryki Północnej: <strong>McKinley / Denali (6194 m n.p.m.)</strong> w Górach Alaska. Kordyliera Wulkaniczna — pas aktywności sejsmicznej i wulkanicznej.</div>
    </div>
    <div class="card">
      <div class="card-label">Rzeki</div>
      <div class="card-title">Missisipi-Missouri</div>
      <div class="card-body"><strong>Missisipi z Missouri (5970 km)</strong> — najdłuższy system rzeczny kontynentu, uchodzi deltą do Zatoki Meksykańskiej. Inne: Mackenzie (z Athabaską), Rio Grande, Kolorado.</div>
    </div>
    <div class="card">
      <div class="card-label">Atrakcje natury</div>
      <div class="card-title">Wielki Kanion, Niagara, fiordy</div>
      <div class="card-body"><strong>Wielki Kanion Kolorado</strong>, <strong>Wodospad Niagara (60 m)</strong> — jeden z najsłynniejszych na świecie, oraz <strong>Fiord Scoresby Sund</strong> na Grenlandii — najdłuższy fiord świata (313 km).</div>
    </div>
    <div class="card">
      <div class="card-label">Przyroda</div>
      <div class="card-title">Od tundry po tropiki</div>
      <div class="card-body">Strefy od arktycznej (tundra) przez tajgę, prerie i pustynie po tropiki. Zwierzęta: <strong>niedźwiedź grizzly, bizon, wapiti</strong>. Wyspy Karaibów: Kuba, Barbados, Grenada.</div>
    </div>
  </div>

  <!-- ============ AMERYKA POŁUDNIOWA ============ -->
  <div class="section" id="amerykapd">
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Andy — najdłuższe pasmo świata</div>
      <div class="card-body"><strong>Andy</strong> — najdłuższe pasmo górskie świata (ponad <strong>9000 km</strong>). Punkt kulminacyjny: <strong>Aconcagua (6960 m n.p.m.)</strong> — najwyższy szczyt obu Ameryk i najwyższy poza Azją. Towarzyszą im wulkanizm i trzęsienia ziemi.</div>
    </div>
    <div class="card">
      <div class="card-label">Rzeki</div>
      <div class="card-title">Amazonka</div>
      <div class="card-body"><strong>Amazonka</strong> — najzasobniejsza w wodę rzeka świata i największe dorzecze; przepływa przez największą puszczę tropikalną (Amazonię). Inne: Parana, Orinoko.</div>
    </div>
    <div class="card">
      <div class="card-label">Wodospady i jeziora</div>
      <div class="card-title">Angel, Iguazú, Titicaca</div>
      <div class="card-body"><strong>Salto Ángel</strong> (Wenezuela) — najwyższy wodospad świata. <strong>Iguazú</strong> — potężny system wodospadów na granicy Brazylii i Argentyny. <strong>Titicaca</strong> — najwyżej położone żeglowne jezioro świata.</div>
    </div>
    <div class="card">
      <div class="card-label">Pustynie i przyroda</div>
      <div class="card-title">Atacama i fauna Andów</div>
      <div class="card-body"><strong>Atacama</strong> (Chile) — najsuchsza pustynia świata. Zwierzęta: <strong>niedźwiedź andyjski, lama, alpaka, kondor</strong>. Pampa (step) na południu, wilgotne lasy w dorzeczu Amazonki.</div>
    </div>
  </div>

  <!-- ============ AUSTRALIA I OCEANIA ============ -->
  <div class="section" id="australia">
    <div class="card">
      <div class="card-label">Podstawy</div>
      <div class="card-title">Australia i Oceania</div>
      <div class="card-body">Najmniejszy i najsuchszy zamieszkany kontynent; Oceania to tysiące wysp (wyspy kontynentalne, wulkaniczne i koralowe — atole). Wielka izolacja sprzyjała powstaniu endemitów.</div>
    </div>
    <div class="card">
      <div class="card-label">Góry i szczyty</div>
      <div class="card-title">Kościuszko i Jaya</div>
      <div class="card-body">Najwyższy szczyt Australii: <strong>Góra Kościuszki (2228 / 2230 m n.p.m.)</strong>. Najwyższy szczyt Oceanii: <strong>Góra Jaya (Puncak Jaya, 4884 m)</strong> na Nowej Gwinei.</div>
    </div>
    <div class="card">
      <div class="card-label">Depresja i rzeki</div>
      <div class="card-title">Jezioro Eyre i Murray-Darling</div>
      <div class="card-body">Najniższy punkt Australii: <strong>Jezioro Eyre (−12 m p.p.m.)</strong> — bezodpływowe, słone, okresowo wysychające. Największy system rzeczny: <strong>Murray-Darling</strong>.</div>
    </div>
    <div class="card">
      <div class="card-label">Atrakcje natury</div>
      <div class="card-title">Wielka Rafa Koralowa i Uluru</div>
      <div class="card-body"><strong>Wielka Rafa Koralowa</strong> u wschodnich wybrzeży — największa rafa świata. <strong>Uluru (Ayers Rock)</strong> — słynny monolit w centrum Australii. Wody: Wielka Zatoka Australijska, Cieśnina Torresa.</div>
    </div>
    <div class="card">
      <div class="card-label">Przyroda</div>
      <div class="card-title">Torbacze i endemity</div>
      <div class="card-body">Świat zwierząt zdominowany przez torbacze: <strong>kangur, koala, diabeł tasmański</strong>, a także dziobak. Roślinność: eukaliptusy, buszowe zarośla (scrub), pustynie w głębi lądu.</div>
    </div>
  </div>

  <!-- ============ QUIZ ============ -->
  <div class="section" id="quiz">
    <div id="quiz-container"></div>
  </div>

</div>

<div class="giant" aria-hidden="true"><span>GEOGRAFIA</span></div>

<footer class="uc-foot">
  <div class="fwrap">
    <p class="disclaimer"><b>Projekt studencki.</b> Niepowiązany z Uniwersytetem Ekonomicznym w Poznaniu ani z żadną katedrą. Materiały to własne opracowania na bazie zajęć — ucz się też z oryginalnych źródeł. Bez gwarancji kompletności.</p>
    <div class="foot-brand">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 L15 22 H9 Z" fill="url(#irisGrad)"/></svg>
      <span>uni<span class="fb-corner">corner</span></span>
    </div>
  </div>
</footer>

<script is:inline>
const RAW = [
  // ZESTAW 1 — Europa (7)
  {set:0,q:"Najwyższy szczyt Europy to...",opts:["Mont Blanc (4808 m)","Elbrus (5642 m)","Matterhorn (4478 m)","Mount Everest (8848 m)"],ans:1,exp:"Najwyższy szczyt Europy to Elbrus (5642 m n.p.m.) w Kaukazie. Mont Blanc (4808 m) jest najwyższy w Alpach."},
  {set:0,q:"Najwyższy szczyt Alp to...",opts:["Elbrus","Mont Blanc","Kilimandżaro","Aconcagua"],ans:1,exp:"Mont Blanc (4808 m) to najwyższy szczyt Alp. Elbrus (Kaukaz) jest najwyższy w całej Europie."},
  {set:0,q:"Najdłuższa rzeka Europy to...",opts:["Dunaj","Ren","Wołga","Wisła"],ans:2,exp:"Wołga (3531 km) to najdłuższa rzeka Europy; uchodzi do Morza Kaspijskiego. Dunaj (2850 km) uchodzi do Morza Czarnego."},
  {set:0,q:"Wezuwiusz, Etna i Stromboli to wulkany położone w...",opts:["Grecji","Islandii","Włoszech","Hiszpanii"],ans:2,exp:"To wulkany włoskie. Islandia ma m.in. Heklę (22 czynne wulkany), Grecja — Santoryn."},
  {set:0,q:"Które państwo ma najwięcej czynnych wulkanów w Europie?",opts:["Islandia","Polska","Francja","Niemcy"],ans:0,exp:"Islandia leży na Grzbiecie Śródatlantyckim i ma 22 czynne wulkany (m.in. Hekla, Eyjafjallajökull)."},
  {set:0,q:"Charakterystycznym dużym ssakiem europejskich puszcz jest...",opts:["Żyrafa","Żubr","Kangur","Lama"],ans:1,exp:"Żubr to największy lądowy ssak Europy; obok niego koziorożec alpejski, jeleń europejski, orzeł bielik."},
  {set:0,q:"Najniżej położony punkt Europy to...",opts:["Nizina Nadkaspijska (−28 m)","Dolina Śmierci","Jezioro Eyre","Morze Martwe"],ans:0,exp:"Nizina Nadkaspijska leży ok. 28 m p.p.m. — to depresja przy Morzu Kaspijskim, najniższy punkt Europy."},

  // ZESTAW 2 — Azja (7)
  {set:1,q:"Najwyższy szczyt Ziemi to...",opts:["K2","Mount Everest (8848 m)","Elbrus","Aconcagua"],ans:1,exp:"Mount Everest (8848 m n.p.m.) w Himalajach to najwyższy szczyt Ziemi, położony w Azji."},
  {set:1,q:"Który kontynent jest największy na Ziemi?",opts:["Afryka","Ameryka Północna","Azja","Europa"],ans:2,exp:"Azja to największy kontynent świata (ok. 30% powierzchni lądów); skrajnie kontynentalna — do 2400 km od morza."},
  {set:1,q:"Największym jeziorem świata jest...",opts:["Bajkał","Morze Kaspijskie","Wiktoria","Titicaca"],ans:1,exp:"Morze Kaspijskie (376 000 km²) to największe jezioro świata — reliktowe i słone."},
  {set:1,q:"Najgłębszym jeziorem świata jest...",opts:["Bajkał (1741 m)","Tanganika","Morze Kaspijskie","Aralskie"],ans:0,exp:"Bajkał to najgłębsze jezioro świata (1741 m) — pochodzenia tektonicznego, w Azji."},
  {set:1,q:"Jezioro Aralskie jest dziś przykładem...",opts:["Największego jeziora świata","Katastrofy ekologicznej (niemal wyschło)","Najgłębszego jeziora","Sztucznego zbiornika zaporowego"],ans:1,exp:"Dawniej 4. jezioro świata, przez pobór wody na nawadnianie niemal wyschło — jedna z największych katastrof ekologicznych."},
  {set:1,q:"Najdłuższa rzeka Azji to...",opts:["Ganges","Mekong","Jangcy (6300 km)","Ob"],ans:2,exp:"Jangcy (6300 km) to najdłuższa rzeka Azji i trzecia najdłuższa na świecie."},
  {set:1,q:"Pustynia Gobi znajduje się w...",opts:["Afryce","Azji","Australii","Ameryce Południowej"],ans:1,exp:"Gobi to rozległa, chłodna pustynia kontynentalna w głębi Azji (Mongolia i Chiny)."},

  // ZESTAW 3 — Afryka (7)
  {set:2,q:"Najwyższy szczyt Afryki to...",opts:["Kenia","Kilimandżaro / Kibo (5895 m)","Atlas","Ruwenzori"],ans:1,exp:"Kibo w masywie Kilimandżaro (5895 m n.p.m.) to najwyższy szczyt Afryki — wygasły wulkan w Tanzanii."},
  {set:2,q:"Największa gorąca pustynia świata to...",opts:["Kalahari","Namib","Sahara","Gobi"],ans:2,exp:"Sahara (ok. 9 mln km²) to największa gorąca pustynia świata, w północnej Afryce."},
  {set:2,q:"Najdłuższa rzeka Afryki to...",opts:["Kongo","Niger","Nil","Zambezi"],ans:2,exp:"Nil to najdłuższa rzeka Afryki (i jedna z najdłuższych na świecie). Kongo jest najzasobniejsza w wodę."},
  {set:2,q:"Największe jezioro Afryki to...",opts:["Tanganika","Wiktoria","Malawi","Czad"],ans:1,exp:"Jezioro Wiktoria to największe jezioro Afryki. Tanganika jest znacznie głębsze (leży w Wielkim Rowie Afrykańskim)."},
  {set:2,q:"Wodospady Wiktorii leżą na rzece...",opts:["Nil","Kongo","Zambezi","Niger"],ans:2,exp:"Wodospady Wiktorii znajdują się na rzece Zambezi, na granicy Zambii i Zimbabwe."},
  {set:2,q:"Wielki Rów Afrykański to obszar...",opts:["Bez aktywności geologicznej","Sejsmiki i wulkanizmu we wschodniej Afryce","Pustynny na północy","Podmorski na Atlantyku"],ans:1,exp:"Wielki Rów Afrykański biegnie przez wschodnią Afrykę — strefa rozłamu, wzmożonej sejsmiki i wulkanizmu; leżą tam głębokie jeziora."},
  {set:2,q:"Największą wyspą Afryki jest...",opts:["Zanzibar","Madagaskar","Mauritius","Reunion"],ans:1,exp:"Madagaskar to największa wyspa Afryki, znana z licznych endemitów. Mniejsze: Zanzibar, Maskareny (Reunion, Mauritius)."},

  // ZESTAW 4 — Ameryka Północna (6)
  {set:3,q:"Najwyższy szczyt Ameryki Północnej to...",opts:["McKinley / Denali (6194 m)","Mount Whitney","Aconcagua","Logan"],ans:0,exp:"McKinley (Denali) — 6194 m n.p.m. w Górach Alaska — najwyższy szczyt Ameryki Północnej."},
  {set:3,q:"Największą wyspą świata jest...",opts:["Nowa Gwinea","Grenlandia","Borneo","Madagaskar"],ans:1,exp:"Grenlandia to największa wyspa świata — w większości pokryta lądolodem (pustynia lodowa), należy do Ameryki Północnej."},
  {set:3,q:"Najdłuższy system rzeczny Ameryki Północnej to...",opts:["Rio Grande","Kolorado","Missisipi z Missouri (5970 km)","Mackenzie"],ans:2,exp:"Missisipi z Missouri (5970 km) — najdłuższy system rzeczny kontynentu; uchodzi deltą do Zatoki Meksykańskiej."},
  {set:3,q:"Słynny wodospad na granicy USA i Kanady o wysokości ok. 60 m to...",opts:["Niagara","Angel","Iguazú","Wiktorii"],ans:0,exp:"Wodospad Niagara (ok. 60 m) — jeden z najsłynniejszych na świecie, na granicy USA i Kanady."},
  {set:3,q:"Wielki Kanion wyżłobiła rzeka...",opts:["Missisipi","Kolorado","Rio Grande","Mackenzie"],ans:1,exp:"Wielki Kanion w Arizonie został wyżłobiony przez rzekę Kolorado."},
  {set:3,q:"Najdłuższy fiord świata (313 km) to...",opts:["Sognefjord w Norwegii","Scoresby Sund na Grenlandii","Milford Sound","Fiord Ailuk"],ans:1,exp:"Scoresby Sund na Grenlandii (313 km) to najdłuższy fiord świata."},

  // ZESTAW 5 — Ameryka Południowa (7)
  {set:4,q:"Najdłuższe pasmo górskie świata to...",opts:["Himalaje","Andy (ponad 9000 km)","Kordyliery","Alpy"],ans:1,exp:"Andy ciągną się ponad 9000 km wzdłuż zachodniego wybrzeża Ameryki Południowej — najdłuższe pasmo górskie świata."},
  {set:4,q:"Najwyższy szczyt obu Ameryk to...",opts:["Denali","Aconcagua (6960 m)","Chimborazo","Cotopaxi"],ans:1,exp:"Aconcagua (6960 m n.p.m.) w Andach — najwyższy szczyt obu Ameryk i najwyższy poza Azją."},
  {set:4,q:"Najzasobniejsza w wodę rzeka świata to...",opts:["Nil","Amazonka","Jangcy","Missisipi"],ans:1,exp:"Amazonka to najzasobniejsza w wodę rzeka świata i ma największe dorzecze; płynie przez puszczę amazońską."},
  {set:4,q:"Najwyższy wodospad świata to...",opts:["Salto Ángel (Wenezuela)","Iguazú","Niagara","Wodospady Wiktorii"],ans:0,exp:"Salto Ángel w Wenezueli to najwyższy wodospad świata. Iguazú słynie z szerokości i liczby kaskad."},
  {set:4,q:"Wodospady Iguazú leżą na granicy...",opts:["Chile i Peru","Brazylii i Argentyny","Wenezueli i Kolumbii","Boliwii i Paragwaju"],ans:1,exp:"System wodospadów Iguazú znajduje się na granicy Brazylii i Argentyny."},
  {set:4,q:"Najsuchsza pustynia świata to...",opts:["Sahara","Atacama (Chile)","Gobi","Namib"],ans:1,exp:"Atacama w Chile to najsuchsza pustynia świata — miejscami opady praktycznie nie występują."},
  {set:4,q:"Titicaca to jezioro znane jako...",opts:["Największe jezioro świata","Najwyżej położone żeglowne jezioro świata","Najgłębsze jezioro świata","Największe słone jezioro"],ans:1,exp:"Titicaca w Andach (granica Peru i Boliwii) to najwyżej położone żeglowne jezioro świata."},

  // ZESTAW 6 — Australia i Oceania (6)
  {set:5,q:"Najwyższy szczyt Australii to...",opts:["Góra Jaya","Góra Kościuszki (2228 m)","Mount Cook","Uluru"],ans:1,exp:"Góra Kościuszki (2228/2230 m n.p.m.) to najwyższy szczyt kontynentu australijskiego."},
  {set:5,q:"Najwyższy szczyt Oceanii to...",opts:["Góra Kościuszki","Góra Jaya / Puncak Jaya (4884 m)","Mauna Kea","Mount Cook"],ans:1,exp:"Puncak Jaya (Góra Jaya, 4884 m) na Nowej Gwinei to najwyższy szczyt Oceanii."},
  {set:5,q:"Najniższy punkt Australii to...",opts:["Jezioro Eyre (−12 m)","Dolina Śmierci","Nizina Nadkaspijska","Morze Martwe"],ans:0,exp:"Jezioro Eyre (−12 m p.p.m.) — bezodpływowe, słone, okresowo wysychające — to najniższy punkt Australii."},
  {set:5,q:"Największa rafa koralowa świata to...",opts:["Rafa Belize","Wielka Rafa Koralowa","Rafa Androsa","Rafa Nowej Kaledonii"],ans:1,exp:"Wielka Rafa Koralowa u wschodnich wybrzeży Australii to największa rafa świata."},
  {set:5,q:"Słynny czerwony monolit w centrum Australii to...",opts:["Uluru (Ayers Rock)","Kata Tjuta","Mount Augustus","Devils Marbles"],ans:0,exp:"Uluru (Ayers Rock) to słynny monolit w centralnej Australii, święte miejsce Aborygenów."},
  {set:5,q:"Świat zwierzęcy Australii zdominowany jest przez...",opts:["Torbacze (kangur, koala, diabeł tasmański)","Wielkie koty","Naczelne","Niedźwiedzie"],ans:0,exp:"Izolacja kontynentu sprzyjała dominacji torbaczy: kangur, koala, diabeł tasmański, a także dziobak."}
];

const SETS = [
  {name:"Zestaw 1 – Europa",range:[0,7]},
  {name:"Zestaw 2 – Azja",range:[7,14]},
  {name:"Zestaw 3 – Afryka",range:[14,21]},
  {name:"Zestaw 4 – Ameryka Północna",range:[21,27]},
  {name:"Zestaw 5 – Ameryka Południowa",range:[27,34]},
  {name:"Zestaw 6 – Australia i Oceania",range:[34,40]},
  {name:"Wszystkie (40 pytań)",range:[0,40]},
];
// Tasowanie opcji – zwraca {opts, ans} z pomieszaną kolejnością
function shuffle(q){
  const idxs=[0,1,2,3];
  for(let i=idxs.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idxs[i],idxs[j]]=[idxs[j],idxs[i]];}
  const newOpts=idxs.map(i=>q.opts[i]);
  const newAns=idxs.indexOf(q.ans);
  return{opts:newOpts,ans:newAns};
}

let activeSet=null; // null = wybór zestawu
let questions=[];
let shuffled=[];
let current=0,score=0,answered=[];

function switchTab(id,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  btn.classList.add('active');
  if(id==='quiz')renderSetPicker();
}

function startSet(si){
  const s=SETS[si];
  questions=RAW.slice(s.range[0],s.range[1]);
  shuffled=questions.map(q=>shuffle(q));
  current=0;score=0;answered=new Array(questions.length).fill(null);
  activeSet=si;
  renderQuiz();
}

function renderSetPicker(){
  activeSet=null;
  const c=document.getElementById('quiz-container');
  c.innerHTML=`<div class="card"><div class="card-label">Wybierz zestaw pytań</div><div class="card-title" style="font-size:1.1rem;margin-bottom:1rem">Z czego chcesz się teraz pouczyć?</div>`+
  SETS.map((s,i)=>`<button class="opt" style="margin-bottom:6px" onclick="startSet(${i})">${s.name}</button>`).join('')+`</div>`;
}

function renderQuiz(){
  const c=document.getElementById('quiz-container');
  if(current>=questions.length){
    const pct=Math.round(score/questions.length*100);
    c.innerHTML=`<div class="card" style="text-align:center;padding:2.5rem">
      <div class="card-label">${SETS[activeSet].name}</div>
      <div class="score-big">${score}/${questions.length}</div>
      <div class="card-body" style="margin-bottom:1.5rem">
        ${pct>=80?'✅ Solidna znajomość materiału.':pct>=60?'⚠️ Kilka rzeczy warto powtórzyć.':'❌ Wróć do notatek i spróbuj ponownie.'}
        <br><span style="color:var(--ink-light)">${pct}% poprawnych odpowiedzi</span>
      </div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
        <button class="nav-btn primary" onclick="startSet(${activeSet})">Powtórz zestaw</button>
        <button class="nav-btn" onclick="renderSetPicker()">← Zmień zestaw</button>
      </div>
    </div>`;
    return;
  }
  const q=questions[current];
  const sh=shuffled[current];
  const isAnswered=answered[current]!==null;
  const pct=Math.round((current/questions.length)*100);
  c.innerHTML=`
    <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
    <div style="margin-bottom:.5rem"><button class="nav-btn" style="font-size:11px;padding:4px 12px" onclick="renderSetPicker()">← Zestawy</button></div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;margin-bottom:1rem">
        <span class="card-label">${SETS[activeSet].name.split('–')[1]||SETS[activeSet].name} · pytanie ${current+1}/${questions.length}</span>
        <span class="card-label">Wynik: ${score} pkt</span>
      </div>
      <div class="quiz-q">${q.q}</div>
      <div class="quiz-opts">
        ${sh.opts.map((o,i)=>{
          let cls='opt';
          if(isAnswered){if(i===sh.ans)cls+=' correct';else if(i===answered[current]&&i!==sh.ans)cls+=' wrong';}
          const oc=isAnswered?'':` onclick="pickAnswer(${i})"`;
          return `<button class="${cls}"${oc}>${o}</button>`;
        }).join('')}
      </div>
      ${isAnswered?`<div class="quiz-feedback ${answered[current]===sh.ans?'ok':'fail'}">${answered[current]===sh.ans?'✅':'❌'} ${q.exp}</div>`:''}
      <div class="quiz-nav">
        <span class="quiz-counter">${current+1} / ${questions.length}</span>
        ${current>0?`<button class="nav-btn" onclick="prevQ()">← Wstecz</button>`:''}
        ${isAnswered&&current<questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Dalej →</button>`:''}
        ${isAnswered&&current===questions.length-1?`<button class="nav-btn primary" onclick="nextQ()">Pokaż wynik</button>`:''}
      </div>
    </div>`;
}

function pickAnswer(i){
  if(answered[current]!==null)return;
  answered[current]=i;
  if(i===shuffled[current].ans)score++;
  renderQuiz();
}
function nextQ(){current++;renderQuiz();}
function prevQ(){if(current>0){current--;renderQuiz();}}

// inicjalizacja
document.addEventListener('DOMContentLoaded',()=>{
  const quizTab=document.querySelector('.tab[onclick*="quiz"]');
  if(quizTab) quizTab.addEventListener('click',renderSetPicker);
});
</script>

