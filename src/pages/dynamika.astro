  o:['Stałego, z góry przyjętego okresu bazowego','Okresu bezpośrednio go poprzedzającego','Średniej wartości z całego szeregu','Okresu następującego zaraz po nim'],c:1,
  e:'Łańcuchowy ma <b>podstawę zmienną</b> — każdy okres odnosi do poprzedniego (t−1). Pokazuje dynamikę rok do roku.'},
 {q:'Indeks jednopodstawowy 185,6% (2013 = 100) oznacza, że zjawisko:',
  o:['Spadło o 85,6% względem bazy','Wzrosło o 185,6% względem 2013','Wzrosło o 85,6% względem 2013','Jest 185,6 razy większe niż w 2013'],c:2,
  e:'Stopa zmian = indeks − 100%. 185,6% − 100% = <b>+85,6%</b> względem okresu bazowego 2013.'},
 {q:'Dlaczego średnie tempo zmian liczymy średnią geometryczną, a nie arytmetyczną?',
  o:['Bo jest łatwiejsza w ręcznym liczeniu','Bo zmiany w czasie się składają, nie sumują','Bo zawsze daje wyraźnie wyższy wynik','To w praktyce nie ma żadnego znaczenia'],c:1,
  e:'Dynamika kumuluje się multiplikatywnie — kolejne indeksy się <b>mnożą</b>. Średnia geometryczna oddaje to poprawnie, arytmetyczna by zawyżała.'},
 {q:'W indeksie CEN według Laspeyresa wagą są:',
  o:['Ceny pochodzące z okresu badanego','Ilości pochodzące z okresu bazowego','Ilości pochodzące z okresu badanego','Ceny pochodzące z okresu bazowego'],c:1,
  e:'Indeks cen → wagą jest <b>ilość</b>. Laspeyres używa ilości z <b>bazy</b> (q₀): Σq₀p₁ / Σq₀p₀.'},
 {q:'Indeks cen Paaschego używa jako wagi:',
  o:['Ilości pochodzące z okresu badanego','Ilości pochodzące z okresu bazowego','Ceny pochodzące z okresu bazowego','Średnie ilości z obu okresów'],c:0,
  e:'Paasche bierze ilości z okresu <b>badanego</b> (q₁): Σq₁p₁ / Σq₁p₀. Różnica L vs P to właśnie który okres dostarcza wag.'},
 {q:'Indeks Fishera to:',
  o:['Suma indeksów Laspeyresa i Paaschego','Średnia arytmetyczna indeksów L i P','Średnia geometryczna indeksów L i P','Iloraz indeksu L przez indeks P'],c:2,
  e:'Fisher = <b>√(I_L · I_P)</b> — średnia geometryczna indeksów Laspeyresa i Paaschego. Uznawany za „idealny”.'},
 {q:'Indeks WARTOŚCI można rozłożyć jako:',
  o:['Iw = I_cen · I_ilości','Iw = I_cen + I_ilości','Iw = I_cen − I_ilości','Iw = I_cen / I_ilości'],c:0,
  e:'Łączna zmiana wartości to <b>iloczyn</b> zmian cen i ilości, np. Iw = I_C^L · I_I^P = I_C^P · I_I^L = I_C^F · I_I^F.'},
 {q:'Której pary nie da się bezpośrednio porównać?',
  o:['Dwa zjawiska w indeksach łańcuchowych','Dwa zjawiska w indeksach jednopodstawowych','Jedno łańcuchowe, drugie jednopodstawowe','Dwa zjawiska w tych samych jednostkach'],c:2,
  e:'Mieszanki typów nie porównasz wprost — najpierw <b>sprowadź oba do tego samego typu</b> indeksu (oba łańcuchowe albo oba jednopodstawowe).'},
 {q:'Warunkiem poprawnej analizy szeregu czasowego NIE jest:',
  o:['Ta sama częstość zbierania danych','Ten sam zakres przestrzenny danych','Te same jednostki miary wartości','Rosnąca z czasem liczba obserwacji'],c:3,
  e:'Porównywalność wymaga tej samej częstości, zakresu i jednostek. Liczba obserwacji nie musi rosnąć — to nie warunek.'},
 {q:'Agregatowy indeks ilości 96,6% oznacza, że:',
  o:['Ceny spadły przeciętnie o 3,4%','Wolumen sprzedaży spadł o 3,4%','Wartość sprzedaży wzrosła o 96,6%','Ilość sprzedanych dóbr wzrosła o 3,4%'],c:1,
  e:'Indeks ilości < 100% → <b>spadek wolumenu</b>: 96,6% − 100% = −3,4%. Indeks ilości mierzy zmianę ilości przy ustalonych cenach.'},
 {q:'Aby zamienić indeks łańcuchowy na jednopodstawowy, trzeba:',
  o:['Dodać do indeksu łańcuchowego 100 punktów','Mnożyć ł iₜ przez s iₜ₋₁, dzielić przez 100','Podzielić indeks przez liczbę wszystkich okresów','Odjąć indeks z okresu bezpośrednio poprzedniego'],c:1,
  e:'s iₜ = ł iₜ · s iₜ₋₁ / 100. Kumulujesz dynamikę, mnożąc kolejny łańcuchowy przez jednopodstawowy z poprzedniego okresu.'},
 {q:'Indeks łańcuchowy dla pierwszego okresu szeregu:',
  o:['Zawsze przyjmuje wartość 100%','Zawsze jest równy zeru procent','Nie da się go w ogóle wyznaczyć','Równa się indeksowi jednopodstawowemu'],c:2,
  e:'Brak okresu poprzedniego (t−1), więc <b>nie da się go policzyć</b>. Pierwszy indeks jednopodstawowy z kolei zawsze = 100% (baza).'}
];
const quizList=document.getElementById('quizList'); let answered=0, correct=0;
QUIZ.forEach((q,i)=>{
  const order=q.o.map((t,idx)=>idx).sort(()=>Math.random()-0.5);
  const card=document.createElement('div'); card.className='quiz-card';
  card.innerHTML=`<div class="q-no">Pytanie ${i+1} / ${QUIZ.length}</div><div class="q-text">${q.q}</div><div class="opts"></div><div class="q-exp">${q.e}</div>`;
  const opts=card.querySelector('.opts'), exp=card.querySelector('.q-exp');
  order.forEach(idx=>{
    const b=document.createElement('button'); b.className='opt'; b.textContent=q.o[idx];
    b.onclick=()=>{
      opts.querySelectorAll('.opt').forEach(x=>x.disabled=true);
      if(idx===q.c){b.classList.add('correct');correct++;}
      else{b.classList.add('wrong');opts.querySelectorAll('.opt').forEach(x=>{if(x.textContent===q.o[q.c])x.classList.add('correct');});}
      exp.classList.add('show'); answered++;
      if(answered===QUIZ.length){
        const sc=document.getElementById('quizScore'); sc.style.display='block';
        document.getElementById('scoreBig').textContent=correct+' / '+QUIZ.length;
        const pct=correct/QUIZ.length;
        document.getElementById('scoreMsg').textContent=
          pct===1?'Komplet — indeksy masz w małym palcu. 🦄':pct>=0.7?'Dobrze. Dopnij wagi L vs P i jesteś gotowy.':'Wróć do kart o indeksach agregatowych — tam siedzi większość błędów.';
      }
    };
    opts.appendChild(b);
  });
  quizList.appendChild(card);
});
</script>

