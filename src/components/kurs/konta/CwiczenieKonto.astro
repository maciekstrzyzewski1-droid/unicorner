---
// Ćwiczenie „zaksięguj na jednym koncie i zamknij je” (jak zad. 5.2 i 5.3, bez podwójnego zapisu).
// Uczeń: przy każdej operacji wybiera stronę (Wn / Ma), wpisuje obroty obu stron, saldo końcowe i stronę salda.
// „Sprawdź” koloruje pola i dla złych pokazuje, jak je wyznaczyć. Poprawne wartości i wyjaśnienia liczone przy buildzie.
import { krokiJednegoKonta, zl, STRONA, NAZWA_TYPU, zapis } from '../../../lib/konta.js';
import { texInline } from '../../../lib/tex.js';
interface Props { tytul: string; konto: any; zmiany: any[]; zrodlo?: string }
const { tytul, konto, zmiany, zrodlo } = Astro.props;
const { wpisy, zam: z } = krokiJednegoKonta(konto, zmiany);
const typ = NAZWA_TYPU[konto.typ];
const typDop = konto.typ === 'A' ? 'aktywnego' : 'pasywnego';
const plus = konto.typ === 'A' ? 'Wn' : 'Ma', minus = konto.typ === 'A' ? 'Ma' : 'Wn';
const skl = (s: string, a: number[]) => (a.length > 1 ? `${a.map(zl).join(' + ')} = ${zl(a.reduce((x, y) => x + y, 0))}` : a.length ? zl(a[0]) : '0');
const pola = [
  ...zmiany.map((zm: any, i: number) => ({
    id: `op-${zm.nr}`, rodzaj: 'strona', ok: wpisy[i].strona,
    h: `<b>Operacja ${zm.nr}</b>: konto „${konto.nazwa}” ${zm.zmiana === '+' ? 'rośnie' : 'maleje'}. To konto ${typ}: zwiększenia po ${plus}, zmniejszenia po ${minus} → <b>${STRONA[wpisy[i].strona]}</b>, zapis „${zapis(wpisy[i].strona, zm.nr, zm.kwota)}”.`,
  })),
  { id: 'obrWn', rodzaj: 'liczba', ok: String(z.obrWn), h: `<b>Obroty Wn</b>: dodaj wszystko po stronie Wn${z.sp && z.spStrona === 'wn' ? ', razem z Sp.' : ''}: ${skl('wn', z.sklWn)}.` },
  { id: 'obrMa', rodzaj: 'liczba', ok: String(z.obrMa), h: `<b>Obroty Ma</b>: dodaj wszystko po stronie Ma${z.sp && z.spStrona === 'ma' ? ', razem z Sp.' : ''}: ${skl('ma', z.sklMa)}.` },
  { id: 'saldo', rodzaj: 'liczba', ok: String(z.saldo), h: `<b>Saldo końcowe</b> = większe obroty − mniejsze: ${zl(Math.max(z.obrWn, z.obrMa))} − ${zl(Math.min(z.obrWn, z.obrMa))} = ${zl(z.saldo)}.` },
  { id: 'saldoStr', rodzaj: 'strona', ok: z.saldoStrona ?? 'wn', h: `<b>Strona salda</b>: nazwa od strony, która przeważa. ${zl(z.obrWn)} po Wn, ${zl(z.obrMa)} po Ma → <b>saldo ${STRONA[z.saldoStrona ?? 'wn']}</b>. Konto ${typDop} ma normalnie saldo po ${plus}.` },
];
---
<section class="k-ct k-ck" data-ck>
  <div class="k-pyt-head">
    <span class="k-pyt-tag k-ct-tag">Zaksięguj</span>
    <h3 class="k-pyt-h">{tytul}</h3>
    {zrodlo && <span class="k-rozw-zr">{zrodlo}</span>}
  </div>
  <div class="k-ct-tresc"><slot /></div>
  <p class="k-ct-how">Konto „{konto.nazwa}” ({typ}), saldo początkowe {zl(z.sp)}. Przy każdej operacji stuknij stronę konta. Potem wpisz obroty (jak na zajęciach: razem z Sp.), saldo i jego stronę. Kliknij „Sprawdź”.</p>
  <ol class="k-ck-ops">
    {zmiany.map((zm: any) => (
      <li class="k-ck-op">
        <span class="k-ck-t"><span class="k-ck-nr">{zm.nr}.</span> <span set:html={texInline(zm.opis)} /> <b class="k-ck-kw">{zl(zm.kwota)}</b></span>
        <span class="k-ck-btns" role="group" data-pole={`op-${zm.nr}`}>
          <button type="button" class="k-ck-b" data-v="wn">Wn</button>
          <button type="button" class="k-ck-b" data-v="ma">Ma</button>
        </span>
      </li>
    ))}
  </ol>
  <div class="k-ck-pola">
    <label class="k-ck-f"><span>Obroty Wn</span><input class="k-ck-in" data-pole="obrWn" type="text" inputmode="numeric" autocomplete="off" /></label>
    <label class="k-ck-f"><span>Obroty Ma</span><input class="k-ck-in" data-pole="obrMa" type="text" inputmode="numeric" autocomplete="off" /></label>
    <label class="k-ck-f"><span>Saldo końcowe</span><input class="k-ck-in" data-pole="saldo" type="text" inputmode="numeric" autocomplete="off" /></label>
    <span class="k-ck-f"><span>To saldo…</span>
      <span class="k-ck-btns" role="group" data-pole="saldoStr">
        <button type="button" class="k-ck-b" data-v="wn">Wn</button>
        <button type="button" class="k-ck-b" data-v="ma">Ma</button>
      </span>
    </span>
  </div>
  <div class="k-ct-ctl" data-js-only hidden>
    <button type="button" class="k-btn" data-check>Sprawdź</button>
    <button type="button" class="k-btn k-btn-ghost" data-pokaz>Pokaż odpowiedzi</button>
    <button type="button" class="k-btn k-btn-ghost" data-clear>Wyczyść</button>
  </div>
  <div class="k-ct-wynik" hidden aria-live="polite">
    <p class="k-ct-sum" data-sum></p>
    <ul class="k-ct-bledy" data-bledy></ul>
  </div>
  <ul hidden data-expl>{pola.map((p) => <li data-id={p.id} data-ok={p.ok} data-rodzaj={p.rodzaj} set:html={texInline(p.h)} />)}</ul>
</section>

<script>
  const NBSP = ' ';
  const fmt = (s: string) => s.replace(/\B(?=(\d{3})+(?!\d))/g, NBSP);
  document.querySelectorAll<HTMLElement>('[data-ck]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => (el.hidden = false));
    const expl = Array.from(box.querySelectorAll<HTMLElement>('[data-expl] > li'));
    const wynik = box.querySelector<HTMLElement>('.k-ct-wynik')!;
    const sum = box.querySelector<HTMLElement>('[data-sum]')!;
    const bledy = box.querySelector<HTMLElement>('[data-bledy]')!;
    const pole = (id: string) => box.querySelector<HTMLElement>(`[data-pole="${id}"]`)!;
    const stan = (el: HTMLElement, c?: string) => { el.classList.remove('is-good', 'is-bad', 'is-empty', 'is-shown'); if (c) el.classList.add(c); };
    // przyciski Wn / Ma działają jak przełącznik
    box.querySelectorAll<HTMLElement>('.k-ck-btns').forEach((g) => g.querySelectorAll<HTMLButtonElement>('.k-ck-b').forEach((b) => b.addEventListener('click', () => {
      g.querySelectorAll('.k-ck-b').forEach((x) => x.classList.toggle('is-on', x === b));
      g.dataset.val = b.dataset.v; stan(g);
    })));
    box.querySelectorAll<HTMLInputElement>('.k-ck-in').forEach((x) => x.addEventListener('input', () => stan(x)));
    const wartosc = (el: HTMLElement) => el instanceof HTMLInputElement ? (el.value.replace(/[^\d]/g, '') || null) : (el.dataset.val ?? null);
    box.querySelector('[data-check]')!.addEventListener('click', () => {
      let good = 0, empty = 0; const zle: HTMLElement[] = [];
      expl.forEach((e) => {
        const el = pole(e.dataset.id!), v = wartosc(el);
        if (v === null) { empty++; stan(el, 'is-empty'); }
        else if (v === e.dataset.ok) { good++; stan(el, 'is-good'); }
        else { zle.push(e); stan(el, 'is-bad'); }
      });
      bledy.innerHTML = '';
      if (!zle.length && !empty) sum.innerHTML = '<b class="k-ct-ok">Wszystko dobrze!</b> Konto zaksięgowane i zamknięte poprawnie.';
      else {
        sum.innerHTML = `Dobrze: <b>${good}</b> · Źle: <b>${zle.length}</b> · Puste: <b>${empty}</b>` + (zle.length ? ' — tak wyznaczysz pola oznaczone na różowo:' : ' — uzupełnij puste pola i sprawdź jeszcze raz.');
        zle.forEach((e) => { const li = document.createElement('li'); li.innerHTML = e.innerHTML; bledy.appendChild(li); });
      }
      wynik.hidden = false;
    });
    box.querySelector('[data-pokaz]')!.addEventListener('click', () => {
      expl.forEach((e) => {
        const el = pole(e.dataset.id!);
        if (el instanceof HTMLInputElement) el.value = fmt(e.dataset.ok!);
        else { el.dataset.val = e.dataset.ok; el.querySelectorAll<HTMLElement>('.k-ck-b').forEach((b) => b.classList.toggle('is-on', b.dataset.v === e.dataset.ok)); }
        stan(el, 'is-shown');
      });
      sum.innerHTML = 'Tak wygląda poprawne rozwiązanie. Spróbuj jeszcze raz samodzielnie — „Wyczyść” opróżnia pola.';
      bledy.innerHTML = ''; wynik.hidden = false;
    });
    box.querySelector('[data-clear]')!.addEventListener('click', () => {
      expl.forEach((e) => {
        const el = pole(e.dataset.id!);
        if (el instanceof HTMLInputElement) el.value = '';
        else { delete el.dataset.val; el.querySelectorAll('.k-ck-b').forEach((b) => b.classList.remove('is-on')); }
        stan(el);
      });
      wynik.hidden = true;
    });
  });
</script>

<style>
  .k-ck-ops{list-style:none;margin:0 0 12px!important;padding:0!important;display:grid;gap:6px;}
  .k-ck-op{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 12px;margin:0!important;padding:6px 8px;border-left:2px solid var(--line2);font-size:.93rem;line-height:1.45;}
  .k-ck-op::before{content:none!important;}
  .k-ck-t{flex:1 1 240px;}
  .k-ck-nr{font-family:var(--mono);color:var(--muted);}
  .k-ck-kw{white-space:nowrap;font-variant-numeric:tabular-nums;}
  .k-ck-btns{display:inline-flex;gap:4px;padding:2px;border:1px solid transparent;}
  .k-ck-b{min-width:52px;height:38px;font-family:var(--mono);font-weight:700;font-size:.95rem;color:var(--text);background:rgba(255,255,255,.04);border:1px dashed var(--line2);cursor:pointer;}
  .k-ck-b.is-on{background:rgba(167,139,250,.22);border:1px solid var(--accent);}
  .k-ck-b:focus-visible{outline:2px solid var(--cyan);outline-offset:1px;}
  .k-ck-pola{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px 14px;margin:0 0 12px;}
  .k-ck-f{display:flex;flex-direction:column;gap:4px;font-size:.82rem;color:var(--muted);}
  .k-ck-in{height:40px;font-family:var(--mono);font-weight:700;font-size:16px;color:var(--text);background:rgba(255,255,255,.04);border:1px dashed var(--line2);border-radius:0;padding:0 8px;width:100%;max-width:170px;}
  .k-ck-in:focus{outline:2px solid var(--cyan);outline-offset:1px;border-style:solid;}
  .is-good.k-ck-in,.k-ck-btns.is-good{background:rgba(90,209,160,.16);border:1px solid var(--ok);}
  .is-bad.k-ck-in,.k-ck-btns.is-bad{background:rgba(255,46,151,.2);border:1px solid var(--magenta);}
  .is-empty.k-ck-in,.k-ck-btns.is-empty{background:rgba(255,216,74,.08);border-color:rgba(255,216,74,.5);}
  .is-shown.k-ck-in,.k-ck-btns.is-shown{background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.5);}
</style>
