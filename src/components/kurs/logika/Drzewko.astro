---
// Drzewko wyborów: skąd się bierze 2^n wierszy w tabeli zero-jedynkowej (tu n = 3 → 8 wierszy).
const W = 640, H = 300;
const lv = [40, 120, 200]; // y poziomów p, q, r
const leafY = 268;
const xs3 = Array.from({ length: 8 }, (_, i) => 40 + i * 80);
const xs2 = [0, 1, 2, 3].map((i) => (xs3[2 * i] + xs3[2 * i + 1]) / 2);
const xs1 = [0, 1].map((i) => (xs2[2 * i] + xs2[2 * i + 1]) / 2);
const root = (xs1[0] + xs1[1]) / 2;
const edges = [
  ...xs1.map((x, i) => ({ x1: root, y1: 8, x2: x, y2: lv[0] - 14, v: i })),
  ...xs2.map((x, i) => ({ x1: xs1[i >> 1], y1: lv[0] + 14, x2: x, y2: lv[1] - 14, v: i & 1 })),
  ...xs3.map((x, i) => ({ x1: xs2[i >> 1], y1: lv[1] + 14, x2: x, y2: lv[2] - 14, v: i & 1 })),
];
const node = (x, y, label, v) => ({ x, y, label, v });
const nodes = [
  ...xs1.map((x, i) => node(x, lv[0], 'p', i)),
  ...xs2.map((x, i) => node(x, lv[1], 'q', i & 1)),
  ...xs3.map((x, i) => node(x, lv[2], 'r', i & 1)),
];
const bits = (i) => [(i >> 2) & 1, (i >> 1) & 1, i & 1].join('');
---
<figure class="k-fig">
  <div class="k-fig-box">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Drzewko: p ma 2 możliwości, każda daje 2 możliwości q, każda z nich 2 możliwości r — razem 8 ścieżek">
      {edges.map((e) => <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.v ? '#27e8ff' : '#6f679a'} stroke-width="2" opacity=".8" />)}
      {nodes.map((n) => (
        <g>
          <circle cx={n.x} cy={n.y} r="14" fill={n.v ? 'rgba(39,232,255,.16)' : '#15131d'} stroke={n.v ? '#27e8ff' : '#6f679a'} stroke-width="1.6" />
          <text x={n.x} y={n.y + 5} text-anchor="middle" font-size="13" font-weight="700" font-family="inherit" fill={n.v ? '#9fe9ff' : '#9b93c4'}>{n.v}</text>
        </g>
      ))}
      {[['p', lv[0]], ['q', lv[1]], ['r', lv[2]]].map(([l, y]) => <text x="6" y={Number(y) + 5} font-size="14" font-style="italic" fill="#eef0ff" font-family="inherit">{l}</text>)}
      {xs3.map((x, i) => <text x={x} y={leafY} text-anchor="middle" font-size="13" font-family="inherit" fill="#eef0ff" font-weight="600">{bits(i)}</text>)}
      <text x={W / 2} y={H - 4} text-anchor="middle" font-size="12" font-family="inherit" fill="#9b93c4">8 ścieżek = 8 wierszy tabeli</text>
    </svg>
  </div>
  <figcaption><span class="k-lbl">Jak czytać ten schemat:</span> <slot /></figcaption>
</figure>
