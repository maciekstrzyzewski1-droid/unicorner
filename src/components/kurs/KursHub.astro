---
// Strona główna kursu: po co, jak czytać ramki, lista modułów. Użycie: src/pages/<kurs>.astro → <KursHub kurs="<kurs>" />
import Base from '../../layouts/Base.astro';
import '../../styles/wiedza.css';
import '../../styles/kurs.css';
import Bar from '../wiedza/Bar.astro';
import Powiadom from './Powiadom.astro';
import { getKurs, moduleUrl, courseUrl } from '../../data/kursy/index.js';
import { rozwiazaniaZMdx, numerowane } from '../../lib/kotwica.js';

interface Props { kurs: string }
const { COURSE, MODULES, KOLOKWIUM } = getKurs(Astro.props.kurs) as any;
const live = MODULES.filter((m) => m.status === 'live').length;

// Spis zadań z zajęć: każde <Rozwiazanie zrodlo="…"> z gotowych modułów, z linkiem prosto do rozwiązania.
const MDX = import.meta.glob('../../pages/*/*.mdx', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const rozw = (m: any) => rozwiazaniaZMdx(MDX[`../../pages/${COURSE.slug}/${m.slug}.mdx`] ?? '');
// Dwa rozwiązania z tą samą kotwicą na jednej stronie = zepsuty link. Build się zatrzymuje i mówi, co poprawić.
for (const m of MODULES.filter((x) => x.status === 'live')) {
  const ids = rozw(m).map((r) => r.id);
  const dup = ids.filter((id, i) => ids.indexOf(id) !== i);
  if (dup.length) throw new Error(`Moduł ${COURSE.slug}/${m.slug}: kilka rozwiązań z kotwicą „${dup[0]}” — nadaj jednemu własne id (<Rozwiazanie id="…">)`);
}
// „Zad. 2.15” przed „Zad. 2.16”, potem reszta (konspekt, zadania dodatkowe) w kolejności z modułu
const klucz = (r: any) => { const m = r.zrodlo.match(/^Zad\.\s*(\d+)\.(\d+)/); return m ? [0, +m[1], +m[2], r.i] : [1, 0, 0, r.i]; };
const poNumerze = (a: any, b: any) => { const x = klucz(a), y = klucz(b); for (let k = 0; k < 4; k++) if (x[k] !== y[k]) return x[k] - y[k]; return 0; };
const SPIS = MODULES.filter((m) => m.status === 'live')
  .map((m) => ({ m, zad: rozw(m).filter((r, i, all) => numerowane(r.zrodlo) && all.findIndex((x) => x.zrodlo === r.zrodlo) === i).map((r, i) => ({ ...r, i })).sort(poNumerze) }))
  .filter((x) => x.zad.length);
// „Przed kolokwium”: każdy wpis musi wskazywać istniejące rozwiązanie w gotowym module.
const KOL = KOLOKWIUM?.zadania?.map((z: any) => {
  const m = MODULES.find((x) => x.slug === z.modul);
  if (!m || m.status !== 'live') throw new Error(`KOLOKWIUM (${COURSE.slug}): moduł „${z.modul}” nie istnieje albo nie jest gotowy`);
  if (!rozw(m).some((r) => r.id === z.id)) throw new Error(`KOLOKWIUM (${COURSE.slug}): w module „${z.modul}” nie ma rozwiązania z kotwicą „${z.id}”`);
  return { ...z, m, href: `${moduleUrl(COURSE.slug, m)}#${z.id}` };
}) ?? [];
const RAMKI = [
  ['polecenie', '✎', 'Polecenie na kolokwium', 'Jak brzmi polecenie i przepis krok po kroku, jak je zrobić.'],
  ['intuicja', '◐', 'Po ludzku', 'Porównanie z życia, które działa tak samo jak pojęcie — nie tylko „brzmi podobnie”.'],
  ['skad', '?', 'Skąd to się bierze?', 'Dlaczego coś wygląda tak, a nie inaczej.'],
  ['botak', '§', 'Bo tak — to umowa', 'Rzeczy, których nie da się wywnioskować: tak się po prostu przyjęło. Mówimy to wprost.'],
  ['pulapka', '!', 'Pułapka', 'Błąd, który najczęściej pojawia się na kolokwiach.'],
  ['granica', '⊘', 'Granica metody', 'Kiedy dana metoda przestaje działać — i co wtedy.'],
  ['podobny', '≈', 'Podobny przykład', 'Drugi przykład tej samej metody albo antyprzykład.'],
];
const url = `https://unicorner.pl${courseUrl(COURSE.slug)}`;
---
<Base title={`${COURSE.seoTitle} · Unicorner`} description={COURSE.seoDesc}>
  <Fragment slot="head">
    <link rel="canonical" href={url} />
    <meta property="og:title" content={COURSE.seoTitle} />
    <meta property="og:description" content={COURSE.seoDesc} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content="https://unicorner.pl/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>

  <Bar crumbs={[{ label: COURSE.name }]} />

  <main id="main" class="k-shell">
    <header class="k-hero">
      <span class="wz-eyebrow"><span class="dot"></span>Kurs · {live} z {MODULES.length} modułów gotowe</span>
      <h1>{COURSE.h1} <span class="grad">{COURSE.h1Grad}</span></h1>
      <p class="k-lede">Na zajęciach wszystko leci szybko: nowe pojęcie, wzór, następny przykład. Wystarczy zgubić wątek w dziesiątej minucie, a reszta zajęć jest już w obcym języku. Ten kurs idzie wolniej. Każde pojęcie i każdy symbol ma tu wyjaśnienie, każdy krok ma swoje „dlaczego”, a każda metoda — przykład, w którym przestaje działać.</p>
      <div class="k-meta">
        <div><span class="k-meta-k">Dla kogo</span><b>{COURSE.dlaKogo}</b></div>
        <div><span class="k-meta-k">Wymagania</span><b>{COURSE.wymagania}</b></div>
        {COURSE.slowniczek && <div><span class="k-meta-k">Ściąga</span><b><a href={COURSE.slowniczek.url} class="k-link">{COURSE.slowniczek.tytul} →</a></b></div>}
      </div>
    </header>

    {KOL.length > 0 && (
      <section class="k-hub-sec k-kol" data-kol={COURSE.slug}>
        <h2 class="k-hub-h"><span class="k-kol-ic" aria-hidden="true">★</span>{KOLOKWIUM.tytul}</h2>
        <p class="k-hub-p">{KOLOKWIUM.opis}</p>
        <ol class="k-kol-lista">
          {KOL.map((z: any) => (
            <li class="k-kol-el">
              <label class="k-kol-chk"><input type="checkbox" class="k-kol-cb" data-id={z.id} aria-label={`Przerobione: ${z.nr}`} /></label>
              <a href={z.href} class="k-kol-a">
                <span class="k-kol-nr">{z.nr}</span>
                <span class="k-kol-t"><b>{z.nazwa}</b><span>moduł {z.m.nr} · {z.m.title}</span></span>
                <i aria-hidden="true">→</i>
              </a>
            </li>
          ))}
        </ol>
        <p class="k-kol-licz" data-js-only hidden><span data-licz>0</span> z {KOL.length} przerobione</p>
      </section>
    )}

    <section class="k-hub-sec">
      <h2 class="k-hub-h">Moduły</h2>
      <ol class="k-mods">
        {MODULES.map((m) => (
          <li class={`k-mod ${m.status === 'live' ? 'is-live' : 'is-soon'}`}>
            {m.status === 'live' && m.cwiczenia ? (
              <>
                <a href={moduleUrl(COURSE.slug, m)}>
                  <span class="k-mod-nr">{String(m.nr).padStart(2, '0')}</span>
                  <span class="k-mod-t"><b>{m.title}</b><span>{m.short}</span></span>
                  <span class="k-mod-go">{m.minutes ? `${m.minutes} min` : ''} <i>→</i></span>
                </a>
                <a class="k-mod-cw" href={`${moduleUrl(COURSE.slug, m)}#${m.cwiczenia}`}>Szybka powtórka: same ćwiczenia →</a>
              </>
            ) : m.status === 'live' ? (
              <a href={moduleUrl(COURSE.slug, m)}>
                <span class="k-mod-nr">{String(m.nr).padStart(2, '0')}</span>
                <span class="k-mod-t"><b>{m.title}</b><span>{m.short}</span></span>
                <span class="k-mod-go">{m.minutes ? `${m.minutes} min` : ''} <i>→</i></span>
              </a>
            ) : (
              <div>
                <span class="k-mod-nr">{String(m.nr).padStart(2, '0')}</span>
                <span class="k-mod-t"><b>{m.title}</b><span>{m.short}</span></span>
                <span class="k-mod-go k-mod-soon">wkrótce</span>
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    {SPIS.length > 0 && (
      <section class="k-hub-sec">
        <h2 class="k-hub-h">Znajdź zadanie z zajęć</h2>
        <p class="k-hub-p">Masz numer zadania ze zbioru, z listy albo z konspektu? Kliknij go — otworzy się rozwiązanie krok po kroku. Przykłady własne kursu są w modułach.</p>
        <div class="k-spis">
          {SPIS.map(({ m, zad }) => (
            <div class="k-spis-w">
              <a class="k-spis-m" href={moduleUrl(COURSE.slug, m)}><span>{String(m.nr).padStart(2, '0')}</span>{m.title}</a>
              <div class="k-spis-z">
                {zad.map((r) => <a href={`${moduleUrl(COURSE.slug, m)}#${r.id}`} title={r.tytul}>{r.zrodlo}</a>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {live < MODULES.length && <Powiadom kurs={COURSE.slug} nazwa={COURSE.name} />}

    <section class="k-hub-sec">
      <h2 class="k-hub-h">Jak czytać ten kurs</h2>
      <p class="k-hub-p">W tekście pojawiają się kolorowe ramki. Każdy kolor znaczy zawsze to samo:</p>
      <div class="k-legenda">
        {RAMKI.map(([k, ic, l, d]) => (
          <div class={`k-ramka k-${k}`}><div class="k-ramka-lbl"><span class="k-ramka-ic" aria-hidden="true">{ic}</span>{l}</div><div class="k-ramka-body"><p>{d}</p></div></div>
        ))}
      </div>
      <p class="k-hub-p">Każdy moduł zaczyna się od listy poleceń, które pojawiają się na kolokwium — przy każdym jest przepis, przykłady i ćwiczenia. Zadania są rozpisane krok po kroku, a kroki i tabele odsłaniasz po jednym, więc możesz najpierw spróbować samodzielnie. Na końcu modułu są ćwiczenia do szybkiej powtórki na telefonie: od razu widzisz, czy dobrze, i dlaczego.</p>
    </section>

    <p class="k-bug">Kurs to nasze własne opracowanie — nie kopiujemy slajdów ani skryptów i nie jesteśmy powiązani z uczelnią ani prowadzącymi. Zapis bywa różny w różnych grupach; gdy prowadzący zapisuje coś inaczej, liczy się jego wersja. Błąd albo niejasność? <a href="/kontakt.html">Napisz</a>.</p>
  </main>

  {KOL.length > 0 && (
    <script>
      // „Przed kolokwium”: odhaczone zadania zostają w tej przeglądarce (localStorage; bez niego lista działa, tylko nie pamięta).
      document.querySelectorAll<HTMLElement>('[data-kol]').forEach((box) => {
        const klucz = `unicorner:kolokwium:${box.dataset.kol}`;
        const cbs = Array.from(box.querySelectorAll<HTMLInputElement>('.k-kol-cb'));
        const licz = box.querySelector<HTMLElement>('[data-licz]');
        let zrobione: string[] = [];
        try { zrobione = JSON.parse(localStorage.getItem(klucz) || '[]'); } catch { zrobione = []; }
        const odswiez = () => {
          cbs.forEach((c) => c.closest('li')?.classList.toggle('is-done', c.checked));
          if (licz) licz.textContent = String(cbs.filter((c) => c.checked).length);
        };
        cbs.forEach((c) => {
          c.checked = zrobione.includes(c.dataset.id!);
          c.addEventListener('change', () => {
            odswiez();
            try { localStorage.setItem(klucz, JSON.stringify(cbs.filter((x) => x.checked).map((x) => x.dataset.id))); } catch { /* bez pamięci */ }
          });
        });
        box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => (el.hidden = false));
        odswiez();
      });
    </script>
  )}

  <footer class="wz-foot">
    <div class="wz-wrap">
      <span>unicorner · {COURSE.name.toLowerCase()}</span>
      <nav aria-label="Stopka"><a href="/index.html">Strona główna</a>{COURSE.slowniczek && <a href={COURSE.slowniczek.url}>{COURSE.slowniczek.tytul}</a>}<a href="/kontakt.html">Kontakt</a></nav>
    </div>
  </footer>
</Base>
