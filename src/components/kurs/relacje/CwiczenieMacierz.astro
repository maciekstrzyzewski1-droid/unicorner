---
// Ćwiczenie „wypełnij macierz relacji”: uczeń stuka komórki (· → 0 → 1), „Sprawdź” koloruje i dla złych komórek
// pokazuje, jak je policzyć. Poprawna macierz `m` i opisy `dlaczego(i, j)` liczone przy buildzie (np. z lib/relacje.js).
import { tex, texInline } from '../../../lib/tex.js';
import Macierz from './Macierz.astro';
type El = number | string;
interface Props { tytul: string; w: El[]; k: El[]; m: number[][]; t: string; dlaczego: (i: number, j: number) => string; zrodlo?: string }
const { tytul, w, k, m, t, dlaczego, zrodlo } = Astro.props;
const html = (s: string) => (s.includes('class="katex"') ? s : texInline(s));
const opisy = m.flatMap((row, i) => row.map((_, j) => ({ id: `${i}-${j}`, h: html(dlaczego(i, j)) })));
---
<section class="k-ct k-cm" data-cm>
  <div class="k-pyt-head">
    <span class="k-pyt-tag k-ct-tag">Wypełnij macierz</span>
    <h3 class="k-pyt-h">{tytul}</h3>
    {zrodlo && <span class="k-rozw-zr">{zrodlo}</span>}
  </div>
  <div class="k-ct-tresc"><slot /></div>
  <p class="k-ct-how" data-js-only hidden>Stuknij w pole, żeby wpisać wartość (każde stuknięcie: · → 0 → 1). Na komputerze możesz wpisywać 0 i 1 z klawiatury. Kiedy skończysz, kliknij „Sprawdź”.</p>
  <div class="k-cm-mx"><Macierz w={w} k={k} m={m} t={t} tryb="cwicz" /></div>
  <div class="k-ct-ctl" data-js-only hidden>
    <button type="button" class="k-btn" data-check>Sprawdź</button>
    <button type="button" class="k-btn k-btn-ghost" data-show>Pokaż odpowiedzi</button>
    <button type="button" class="k-btn k-btn-ghost" data-clear>Wyczyść</button>
  </div>
  <div class="k-ct-wynik" hidden aria-live="polite">
    <p class="k-ct-sum" data-sum></p>
    <ul class="k-ct-bledy" data-bledy></ul>
  </div>
  <ul hidden data-expl>{opisy.map((o) => <li data-cell={o.id} set:html={o.h} />)}</ul>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cm]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { if (el.closest('[data-cm]') === box) el.hidden = false; });
    const cells = Array.from(box.querySelectorAll<HTMLButtonElement>('.k-mx-btn'));
    const at = (r: number, c: number) => cells.find((b) => Number(b.dataset.r) === r && Number(b.dataset.c) === c);
    const wynik = box.querySelector<HTMLElement>('.k-ct-wynik')!;
    const sum = box.querySelector<HTMLElement>('[data-sum]')!;
    const bledy = box.querySelector<HTMLElement>('[data-bledy]')!;
    const set = (b: HTMLButtonElement, v: string) => { b.dataset.v = v; b.textContent = v === '' ? '·' : v; b.classList.remove('is-good', 'is-bad', 'is-empty', 'is-shown'); };
    cells.forEach((b) => {
      b.addEventListener('click', () => { const v = b.dataset.v ?? ''; set(b, v === '' ? '0' : v === '0' ? '1' : ''); });
      b.addEventListener('keydown', (e) => {
        const r = Number(b.dataset.r), c = Number(b.dataset.c);
        const go = (nr: number, nc: number) => { const x = at(nr, nc); if (x) { e.preventDefault(); x.focus(); } };
        if (e.key === '0' || e.key === '1') { e.preventDefault(); set(b, e.key); (at(r, c + 1) ?? at(r + 1, 0))?.focus(); }
        else if (e.key === 'Backspace' || e.key === 'Delete') { e.preventDefault(); set(b, ''); }
        else if (e.key === 'ArrowDown') go(r + 1, c);
        else if (e.key === 'ArrowUp') go(r - 1, c);
        else if (e.key === 'ArrowRight') go(r, c + 1);
        else if (e.key === 'ArrowLeft') go(r, c - 1);
      });
    });
    box.querySelector('[data-check]')!.addEventListener('click', () => {
      let good = 0, empty = 0;
      const wrong: HTMLButtonElement[] = [];
      cells.forEach((b) => {
        const v = b.dataset.v ?? '';
        b.classList.remove('is-good', 'is-bad', 'is-empty');
        if (v === '') { empty++; b.classList.add('is-empty'); }
        else if (v === b.dataset.ok) { good++; b.classList.add('is-good'); }
        else { wrong.push(b); b.classList.add('is-bad'); }
      });
      bledy.innerHTML = '';
      if (!wrong.length && !empty) sum.innerHTML = '<b class="k-ct-ok">Wszystko dobrze!</b> Każda komórka się zgadza.';
      else {
        sum.innerHTML = `Dobrze: <b>${good}</b> · Źle: <b>${wrong.length}</b> · Puste: <b>${empty}</b>` +
          (wrong.length ? ' — tak policzysz pola oznaczone na różowo:' : ' — uzupełnij puste pola (szare) i sprawdź jeszcze raz.');
        wrong.slice(0, 5).forEach((b) => {
          const src = box.querySelector(`[data-expl] [data-cell="${b.dataset.r}-${b.dataset.c}"]`);
          if (src) { const li = document.createElement('li'); li.innerHTML = src.innerHTML; bledy.appendChild(li); }
        });
        if (wrong.length > 5) { const li = document.createElement('li'); li.textContent = `…i jeszcze ${wrong.length - 5}. Popraw te powyżej i sprawdź ponownie.`; bledy.appendChild(li); }
      }
      wynik.hidden = false;
    });
    box.querySelector('[data-show]')!.addEventListener('click', () => {
      cells.forEach((b) => { set(b, b.dataset.ok!); b.classList.add('is-shown'); });
      sum.innerHTML = 'Tak wygląda wypełniona macierz. Spróbuj jeszcze raz samodzielnie — „Wyczyść” zeruje pola.';
      bledy.innerHTML = '';
      wynik.hidden = false;
    });
    box.querySelector('[data-clear]')!.addEventListener('click', () => { cells.forEach((b) => set(b, '')); wynik.hidden = true; });
  });
</script>

<style>
  .k-cm-mx{overflow-x:auto;padding:4px 0 10px;}
  .k-cm-mx :global(.k-mx-vals){grid-auto-rows:2.6em;grid-template-columns:repeat(var(--n),max(2.7em,var(--cw)));gap:3px;}
  .k-cm-mx :global(.k-mx-ch){grid-template-columns:repeat(var(--n),max(2.7em,var(--cw)));gap:3px;}
  .k-cm-mx :global(.k-mx-rh){grid-auto-rows:2.6em;row-gap:3px;}
  .k-cm-mx :global(.k-mx-btn){height:100%;}
</style>
