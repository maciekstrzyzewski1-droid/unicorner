---
// Sprawdzenie wymiarów przed mnożeniem: (m × r) · (r × n) → (m × n). Środkowe liczby na złoto (muszą być równe),
// zewnętrzne na turkusowo (to wymiary wyniku). Gdy środkowe się różnią — czerwony werdykt „nie da się”.
import { tex } from '../../../lib/tex.js';
interface Props { a: [number, number]; b: [number, number]; nA?: string; nB?: string }
const { a, b, nA = 'A', nB = 'B' } = Astro.props;
const ok = a[1] === b[0];
---
<div class:list={['k-wy', ok ? 'is-ok' : 'is-nie']}>
  <div class="k-wy-row">
    <span class="k-wy-m"><span class="k-wy-n" set:html={tex(nA)} /><span class="k-wy-d"><b class="is-z">{a[0]}</b> × <b class="is-s">{a[1]}</b></span></span>
    <span class="k-wy-op">·</span>
    <span class="k-wy-m"><span class="k-wy-n" set:html={tex(nB)} /><span class="k-wy-d"><b class="is-s">{b[0]}</b> × <b class="is-z">{b[1]}</b></span></span>
    {ok && <><span class="k-wy-op">→</span><span class="k-wy-m"><span class="k-wy-n">wynik</span><span class="k-wy-d"><b class="is-z">{a[0]}</b> × <b class="is-z">{b[1]}</b></span></span></>}
  </div>
  <p class="k-wy-v">
    {ok
      ? <>Środkowe liczby: <b class="is-s">{a[1]}</b> i <b class="is-s">{b[0]}</b> — równe, więc <b>da się pomnożyć</b>. Wynik ma wymiar z liczb zewnętrznych: <b class="is-z">{a[0]} × {b[1]}</b>.</>
      : <>Środkowe liczby: <b class="is-s">{a[1]}</b> i <b class="is-s">{b[0]}</b> — różne, więc <b class="is-x">tego iloczynu nie da się policzyć</b>.</>}
  </p>
</div>

<style>
  .k-wy{margin:10px 0 14px;padding:10px 14px;border:1px solid var(--line2);background:var(--ink2);border-left:3px solid var(--ok);}
  .k-wy.is-nie{border-left-color:var(--magenta);}
  .k-wy-row{display:flex;flex-wrap:wrap;align-items:flex-end;gap:6px 12px;}
  .k-wy-m{display:inline-flex;flex-direction:column;align-items:center;gap:2px;}
  .k-wy-n{font-size:1.05rem;color:#fff;}
  .k-wy-d{font-family:var(--mono);font-size:1.05rem;color:var(--muted);white-space:nowrap;padding:2px 8px;border:1px solid var(--line2);}
  .k-wy-op{font-size:1.2rem;color:var(--muted);padding-bottom:4px;}
  .k-wy b{font-weight:800;}
  .k-wy .is-s{color:var(--gold);}
  .k-wy .is-z{color:var(--cyan);}
  .k-wy .is-x{color:var(--magenta);}
  .k-wy-v{font-size:.9rem;color:#d6d2ea;line-height:1.55;margin:8px 0 0!important;}
</style>
