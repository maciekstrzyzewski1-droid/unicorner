---
// Pięć własności wyznacznika ze slajdów — każda pokazana na tej samej macierzy 2×2: przed i po operacji, z wyznacznikami.
// Wyznaczniki liczone przy buildzie; jeśli przykład nie pokazuje własności, build się wywraca.
import { tex, texInline } from '../../../lib/tex.js';
import { mat, det, krok, T, Q } from '../../../lib/macierze.js';
import Mx from './Mx.astro';
const B = mat([[2, 1], [3, 4]]);
const dB = det(B);
const k1 = krok(B, [{ t: 'dod', w: 1, z: 0, c: 1 }]);
const k3 = krok(B, [{ t: 'zam', a: 0, b: 1 }]);
const k4 = krok(B, [{ t: 'razy', w: 0, c: 3 }]);
const zer = mat([[2, 1], [0, 0]]);
const karty = [
  { nr: 1, tytul: 'Dodanie wielokrotności innego wiersza — wyznacznik bez zmian', po: k1.po, op: 'w_2\' = w_2 + w_1', oznacz: [{ i: 1, styl: 'zloto' }], spr: (d: Q) => d.eq(dB),
    tekst: 'Do wiersza 2 dodaliśmy wiersz 1: $(3, 4) + (2, 1) = (5, 5)$. Wyznacznik dalej wynosi $5$. To najważniejsza własność — dzięki niej wolno „zerować” liczby przed liczeniem wyznacznika.' },
  { nr: 2, tytul: 'Wiersz (kolumna) z samych zer — wyznacznik równy 0', po: zer, op: '', oznacz: [{ i: 1, styl: 'roz' }], spr: (d: Q) => d.zero,
    tekst: 'Każdy składnik wyznacznika zawiera jedną liczbę z każdego wiersza. Gdy cały wiersz to zera, każdy składnik jest zerem.' },
  { nr: 3, tytul: 'Zamiana dwóch wierszy — zmiana znaku', po: k3.po, op: 'w_1 \\leftrightarrow w_2', oznacz: [{ i: 0, styl: 'zloto' }, { i: 1, styl: 'zloto' }], spr: (d: Q) => d.eq(dB.neg()),
    tekst: 'Te same liczby, inna kolejność wierszy: $5$ zmienia się w $-5$. Każda kolejna zamiana znowu odwraca znak.' },
  { nr: 4, tytul: 'Pomnożenie wiersza przez c — wyznacznik razy c', po: k4.po, op: 'w_1\' = w_1 \\cdot 3', oznacz: [{ i: 0, styl: 'zloto' }], spr: (d: Q) => d.eq(dB.mul(3)),
    tekst: 'Wiersz 1 razy $3$, więc wyznacznik też razy $3$: $5 \\cdot 3 = 15$. Działa w obie strony: z wiersza można „wyciągnąć” wspólny czynnik przed wyznacznik.' },
  { nr: 5, tytul: 'Transpozycja nie zmienia wyznacznika', po: T(B), op: 'A^T', oznacz: [], spr: (d: Q) => d.eq(dB),
    tekst: 'Wiersze zamienione na kolumny, a wyznacznik ten sam. Dlatego każda własność dla wierszy działa też dla kolumn.' },
].map((k) => {
  const d = det(k.po);
  if (!k.spr(d)) throw new Error(`GaleriaWyznacznika: przykład ${k.nr} nie pokazuje własności`);
  return { ...k, d, html: texInline(k.tekst) };
});
---
<div class="k-gw">
  {karty.map((k) => (
    <div class="k-gw-k">
      <div class="k-gw-h"><span class="k-gw-nr">{k.nr}</span> {k.tytul}</div>
      <div class="k-gw-row">
        <div class="k-gw-m"><Mx m={B} t="A =" maly /><span class="k-gw-d" set:html={tex(`\\det = ${dB.tex()}`)} /></div>
        <div class="k-gw-arr">{k.op ? <span set:html={tex(k.op)} /> : <span>zamiast wiersza 2 — zera</span>}<span aria-hidden="true">⟶</span></div>
        <div class="k-gw-m"><Mx m={k.po} maly wiersze={k.oznacz} /><span class:list={['k-gw-d', { 'is-zm': !k.d.eq(dB) }]} set:html={tex(`\\det = ${k.d.tex()}`)} /></div>
      </div>
      <p class="k-gw-t" set:html={k.html} />
    </div>
  ))}
</div>

<style>
  .k-gw{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;margin:1.3em 0 1.6em;}
  .k-gw-k{border:1px solid var(--line2);background:var(--ink2);padding:12px 14px;}
  .k-gw-h{font-family:var(--disp);font-weight:700;font-size:.98rem;color:#fff;line-height:1.3;margin-bottom:10px;display:flex;gap:8px;align-items:flex-start;}
  .k-gw-nr{flex:0 0 auto;display:inline-grid;place-items:center;width:22px;height:22px;font-family:var(--mono);font-size:.78rem;color:#0b0918;background:var(--accent);}
  .k-gw-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .k-gw-m{display:flex;flex-direction:column;align-items:center;gap:4px;}
  .k-gw-d{font-size:.9rem;}
  .k-gw-d.is-zm :global(.katex){color:var(--gold)!important;}
  .k-gw-arr{display:flex;flex-direction:column;align-items:center;font-size:.8rem;color:var(--muted);gap:2px;}
  .k-gw-t{font-size:.88rem;line-height:1.55;color:#d6d2ea;margin:10px 0 0!important;}
</style>
