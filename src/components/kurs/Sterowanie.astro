---
// Przyciski „krok po kroku” dla rysunków z lib/krokowka.ts: start, legenda kolorów trybu kroków, podpis kroku,
// Wstecz / Dalej / Odtwórz / Zamknij i licznik. Wstaw do pudełka z atrybutem data-kbox (poza .k-fig-box — patrz niżej),
// obok ukrytej listy <ol hidden data-kroki>. Bez JS nic z tego nie widać.
// legenda — kolory używane tylko w trybie kroków (np. obwódka kratki liczonej teraz); jest w panelu, więc widać ją przy każdym kroku.
// Tu są też style elementów dokładanych przez skrypt: przelatująca liczba (.k-lot) i błysk (.k-blysk).
import Legenda from './Legenda.astro';
interface Props { start?: string; opis?: string; legenda?: [string, string][] }
const { start = '▶ Zobacz krok po kroku', opis, legenda } = Astro.props;
---
<div class="k-kk-go" data-kk-go hidden>
  <button type="button" class="k-btn" data-kk-start>{start}</button>
  {opis && <span class="k-kk-go-t">{opis}</span>}
</div>
<div class="k-kk-ctl" data-kk-ctl hidden>
  {legenda && <div class="k-kk-leg"><Legenda items={legenda} /></div>}
  <p class="k-kk-cap" data-kk-cap aria-live="polite"></p>
  <div class="k-kk-btns">
    <button type="button" class="k-btn k-btn-ghost" data-kk-prev>‹ Wstecz</button>
    <button type="button" class="k-btn" data-kk-next>Dalej ›</button>
    <button type="button" class="k-btn k-btn-ghost" data-kk-auto>▶ Odtwórz</button>
    <button type="button" class="k-btn k-btn-ghost" data-kk-stop>Zamknij</button>
    <span class="k-kk-licz" data-kk-licz></span>
  </div>
</div>

<style>
  .k-kk-go{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin:12px 0 2px;}
  .k-kk-go[hidden]{display:none;}
  .k-kk-go-t{font-size:.82rem;color:var(--muted);}
  /* podpis i przyciski przyklejone do dołu ekranu, dopóki rysunek jest widoczny — rachunek zawsze obok kratki;
     dlatego Sterowanie stoi poza .k-fig-box (ten ma overflow, a sticky działa tylko bez przewijanego rodzica) */
  .k-kk-ctl{position:sticky;bottom:0;z-index:5;margin:12px 0 2px;padding:8px 12px 10px;border-left:2px solid var(--cyan);
    background:linear-gradient(rgba(0,229,255,.06),rgba(0,229,255,.06)),#100f17;box-shadow:0 -8px 18px rgba(0,0,0,.55);}
  .k-kk-ctl[hidden]{display:none;}
  .k-kk-leg{margin:0 0 6px;padding-bottom:6px;border-bottom:1px solid var(--line);}
  .k-kk-leg :global(.k-leg){margin:0!important;font-size:.74rem;gap:2px 14px;}
  .k-kk-licz{margin-left:auto;font-family:var(--mono);font-size:.72rem;color:var(--muted);white-space:nowrap;}
  .k-kk-cap{margin:0 0 10px!important;font-size:.95rem;line-height:1.7;min-height:3.4em;}
  .k-kk-btns{display:flex;flex-wrap:wrap;align-items:center;gap:8px;}
  .k-kk-btns button:disabled{opacity:.4;cursor:default;transform:none;filter:none;}
  @media(max-width:560px){
    .k-kk-leg :global(.k-leg){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 10px;font-size:.7rem;}
    .k-kk-cap{font-size:.92rem;line-height:1.6;}
    .k-kk-btns{gap:6px;}
    .k-kk-btns .k-btn{padding:8px 11px;font-size:.76rem;}
  }
  /* elementy dokładane przez skrypt */
  :global([data-kbox] .k-lot){position:absolute;z-index:6;display:grid;place-items:center;pointer-events:none;border-radius:4px;color:#fff;white-space:nowrap;
    padding:0 4px;transition:transform .65s cubic-bezier(.45,0,.2,1);box-shadow:0 6px 18px rgba(0,0,0,.45);}
  :global([data-kbox] .k-lot.is-zloto){background:rgba(255,216,74,.45);}
  :global([data-kbox] .k-lot.is-cyan){background:rgba(39,232,255,.36);}
  :global([data-kbox] .k-lot.is-ok){background:rgba(90,209,160,.45);}
  :global([data-kbox] .k-lot.is-fiolet){background:rgba(167,139,250,.42);}
  :global([data-kbox] .k-blysk){animation:k-kk-blysk .8s ease-out;}
  @keyframes k-kk-blysk{0%{box-shadow:0 0 0 3px rgba(255,216,74,.9);}100%{box-shadow:0 0 0 0 rgba(255,216,74,0);}}
  @media (prefers-reduced-motion: reduce){ :global([data-kbox] .k-blysk){animation:none;} }
</style>
