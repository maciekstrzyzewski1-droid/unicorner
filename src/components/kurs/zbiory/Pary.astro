---
// Iloczyn kartezjański zbiorów skończonych w układzie współrzędnych: kropka = para (x, y).
// Przełącznik A×B / B×A / oba naraz (oba: widać, że B×A to odbicie A×B względem prostej y = x).
import { tex, texInline } from '../../../lib/tex.js';
interface Props { A: number[]; B: number[] }
const { A, B } = Astro.props;
const all = [...A, ...B, 0];
const lo = Math.min(...all) - 1, hi = Math.max(...all) + 1;
const n = hi - lo, s = Math.max(26, Math.min(40, Math.floor(320 / n))), pad = 30;
const size = n * s + 2 * pad;
const X = (v: number) => pad + (v - lo) * s, Y = (v: number) => pad + (hi - v) * s;
const ab = A.flatMap((a) => B.map((b) => [a, b]));
const ba = B.flatMap((b) => A.map((a) => [b, a]));
// lista par jako HTML (łamie się między parami, więc mieści się na telefonie)
const lista = (nazwa: string, P: number[][]) => `${tex(`${nazwa} = \\{`)}${P.map(([x, y], i) => `<span class="k-pary-p">${tex(`(${x}, ${y})${i < P.length - 1 ? ',' : ''}`)}</span>`).join(' ')}${tex('\\}')}`;
const ticks = Array.from({ length: n + 1 }, (_, i) => lo + i).filter((v) => v !== lo && v !== hi);
---
<figure class="k-fig k-pary" data-pary data-tryb="oba">
  <div class="k-pary-ctl" data-js-only hidden>
    <button type="button" class="k-opt k-opt-sm is-on" data-t="ab" set:html={tex('A \\times B')} />
    <button type="button" class="k-opt k-opt-sm" data-t="ba" set:html={tex('B \\times A')} />
    <button type="button" class="k-opt k-opt-sm" data-t="oba">oba naraz</button>
  </div>
  <div class="k-fig-box">
    <svg viewBox={`0 0 ${size} ${size}`} role="img" aria-label={`Układ współrzędnych z punktami iloczynu kartezjańskiego A × B, A = {${A.join(', ')}}, B = {${B.join(', ')}}`}>
      {Array.from({ length: n + 1 }, (_, i) => lo + i).map((v) => (
        <g stroke="rgba(255,255,255,.07)" stroke-width="1">
          <line x1={X(v)} y1={pad} x2={X(v)} y2={size - pad} />
          <line x1={pad} y1={Y(v)} x2={size - pad} y2={Y(v)} />
        </g>
      ))}
      <g stroke="#9b93c4" stroke-width="1.6">
        <line x1={pad - 6} y1={Y(0)} x2={size - pad + 10} y2={Y(0)} />
        <line x1={X(0)} y1={size - pad + 6} x2={X(0)} y2={pad - 10} />
      </g>
      <path d={`M${size - pad + 14},${Y(0)} l-9,-4.5 v9 z M${X(0)},${pad - 14} l-4.5,9 h9 z`} fill="#9b93c4" />
      <text x={size - pad + 8} y={Y(0) - 10} class="k-pary-ax">x</text>
      <text x={X(0) + 10} y={pad - 4} class="k-pary-ax">y</text>
      {ticks.map((v) => v !== 0 && (
        <g class="k-pary-t">
          <text x={X(v)} y={Y(0) + 19} text-anchor="middle">{v}</text>
          <text x={X(0) - 7} y={Y(v) + 4.5} text-anchor="end">{v}</text>
        </g>
      ))}
      <text x={X(0) - 7} y={Y(0) + 17} text-anchor="end" class="k-pary-t">0</text>
      <line class="k-pary-diag" x1={X(lo)} y1={Y(lo)} x2={X(hi)} y2={Y(hi)} stroke="#ffd84a" stroke-width="1.4" stroke-dasharray="5 5" />
      <g class="k-pary-g" data-g="ab">{ab.map(([x, y]) => <circle cx={X(x)} cy={Y(y)} r="6.5" fill="#27e8ff" />)}</g>
      <g class="k-pary-g" data-g="ba">{ba.map(([x, y]) => <circle cx={X(x)} cy={Y(y)} r="6.5" fill="none" stroke="#ff2e97" stroke-width="2.6" />)}</g>
    </svg>
  </div>
  <div class="k-pary-l">
    <p data-g="ab"><b class="k-pary-ab">●</b> <span set:html={lista('A \\times B', ab)} /></p>
    <p data-g="ba"><b class="k-pary-ba">○</b> <span set:html={lista('B \\times A', ba)} /></p>
    <p data-g="oba" class="k-pary-o" set:html={texInline('Żółta przerywana linia to prosta $y = x$. Kropki $B \\times A$ są odbiciem kropek $A \\times B$ w tej prostej — bo w każdej parze zamieniamy miejscami $x$ i $y$.')} />
  </div>
  <figcaption><span class="k-lbl">Jak czytać ten rysunek:</span> <slot /></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-pary]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { if (el.closest('[data-pary]') === box) el.hidden = false; });
    const set = (t: string) => {
      box.dataset.tryb = t;
      box.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((b) => b.classList.toggle('is-on', b.dataset.t === t));
      box.querySelectorAll<HTMLElement>('.k-pary-l [data-g]').forEach((p) => (p.hidden = !(t === 'oba' || p.dataset.g === t)));
    };
    box.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((b) => b.addEventListener('click', () => set(b.dataset.t!)));
    set('ab');
  });
</script>

<style>
  .k-pary svg{max-width:420px;}
  .k-pary-ctl{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
  .k-pary-ctl .k-opt{justify-content:center;min-width:72px;min-height:38px;}
  .k-pary-ctl .k-opt.is-on{border-color:var(--gold);background:rgba(255,216,74,.12);}
  .k-pary-ax{font-family:var(--mono);font-size:17px;font-style:italic;fill:#eef0ff;}
  .k-pary-t text,.k-pary-t{font-family:var(--mono);font-size:14px;fill:#9b93c4;}
  .k-pary-diag{opacity:0;transition:opacity .2s;}
  [data-tryb="oba"] .k-pary-diag{opacity:.8;}
  [data-tryb="ab"] .k-pary-g[data-g="ba"],[data-tryb="ba"] .k-pary-g[data-g="ab"]{display:none;}
  .k-pary-l{margin-top:10px;font-size:.92rem;line-height:1.7;}
  .k-pary-l :global(.k-pary-p){white-space:nowrap;}
  .k-pary-l p{margin:0 0 6px!important;}
  .k-pary-ab{color:var(--cyan);} .k-pary-ba{color:var(--magenta);}
  .k-pary-o{color:var(--muted);}
</style>
