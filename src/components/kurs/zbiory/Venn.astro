---
// Diagram Venna dla dwóch zbiorów z konkretnymi elementami. Elementy rozmieszczane kodem w czterech obszarach
// (tylko A, A i B, tylko B, poza A i B). Przycisk działania podświetla obszary wyniku i pokazuje wynik.
// Bez JS: rysunek + lista wszystkich wyników pod spodem.
import { tex, texInline } from '../../../lib/tex.js';
import { DZIALANIA, sprawdz, wynik, zapis, region, regiony } from '../../../lib/zbiory.js';
type El = number | string;
interface Props { U?: El[]; A: El[]; B: El[]; dzialania?: string[] }
const { A, B } = Astro.props;
const maU = !!Astro.props.U;
const U: El[] = Astro.props.U ?? [...A, ...B.filter((x) => !A.some((a) => String(a) === String(x)))];
sprawdz(U, A, B);
const dzialania = Astro.props.dzialania ?? (maU ? ['suma', 'iloczyn', 'roznicaAB', 'roznicaBA', 'dopA', 'dopB'] : ['suma', 'iloczyn', 'roznicaAB', 'roznicaBA']);

// geometria
const W = 440, H = 280, R = 90, cy = 140, ax = 172, bx = 268;
const hh = Math.sqrt(R * R - ((bx - ax) / 2) ** 2);
const mx = (ax + bx) / 2, yT = +(cy - hh).toFixed(1), yB = +(cy + hh).toFixed(1);
const P = {
  '11': `M${mx},${yT} A${R} ${R} 0 0 1 ${mx},${yB} A${R} ${R} 0 0 1 ${mx},${yT}Z`,
  '10': `M${mx},${yT} A${R} ${R} 0 1 0 ${mx},${yB} A${R} ${R} 0 0 1 ${mx},${yT}Z`,
  '01': `M${mx},${yT} A${R} ${R} 0 1 1 ${mx},${yB} A${R} ${R} 0 0 0 ${mx},${yT}Z`,
  '00': `M8,8 H${W - 8} V${H - 8} H8 Z M${mx},${yT} A${R} ${R} 0 1 0 ${mx},${yB} A${R} ${R} 0 1 0 ${mx},${yT}Z`,
};
// kandydaci na miejsca elementów
const m = 14, gap = 27;
const etykiety = [[24, 30], [112, 50], [328, 50]];
const reg = (x: number, y: number) => {
  const dA = Math.hypot(x - ax, y - cy), dB = Math.hypot(x - bx, y - cy);
  const inA = dA < R - m, outA = dA > R + m, inB = dB < R - m, outB = dB > R + m;
  if (inA && inB) return '11';
  if (inA && outB) return '10';
  if (outA && inB) return '01';
  if (outA && outB && x > 24 && x < W - 24 && y > 26 && y < H - 22 && etykiety.every(([lx, ly]) => Math.hypot(x - lx, y - ly) > 24)) return '00';
  return null;
};
const kotwica: Record<string, [number, number]> = { '10': [124, cy], '11': [mx, cy], '01': [W - 124, cy] };
const kand: Record<string, { x: number; y: number; d: number }[]> = { '10': [], '11': [], '01': [], '00': [] };
for (let x = 20; x <= W - 20; x += 3) for (let y = 20; y <= H - 16; y += 3) {
  const r = reg(x, y);
  if (!r) continue;
  const d = r === '00' ? -Math.min(Math.hypot(x - ax, y - cy), Math.hypot(x - bx, y - cy)) : Math.hypot(x - kotwica[r][0], y - kotwica[r][1]);
  kand[r].push({ x, y, d });
}
const poz = new Map<string, { x: number; y: number; r: string }>();
for (const r of ['10', '11', '01', '00']) {
  const el = U.filter((x) => region(A, B, x) === r);
  if (!el.length) continue;
  const wyb: { x: number; y: number }[] = [];
  for (const c of kand[r].sort((p, q) => p.d - q.d)) {
    if (wyb.length === el.length) break;
    if (wyb.every((w) => Math.hypot(w.x - c.x, w.y - c.y) >= gap)) wyb.push(c);
  }
  if (wyb.length < el.length) throw new Error(`Venn: za dużo elementów w obszarze ${r} (${el.length})`);
  wyb.sort((p, q) => (Math.abs(p.y - q.y) < 12 ? p.x - q.x : p.y - q.y));
  el.forEach((x, i) => poz.set(String(x), { ...wyb[i], r }));
}
const wyniki = dzialania.map((k) => ({ k, t: DZIALANIA[k].t, regiony: regiony(k).join(' '), w: wynik(U, A, B, k), regula: DZIALANIA[k].regula }));
---
<figure class="k-fig k-venn" data-venn>
  <div class="k-fig-box">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Diagram Venna: A = ${A.join(', ')}; B = ${B.join(', ')}${maU ? `; poza nimi: ${U.filter((x) => region(A, B, x) === '00').join(', ')}` : ''}`}>
      {Object.entries(P).map(([r, d]) => (r !== '00' || maU) && <path class="k-venn-r" data-r={r} d={d} fill-rule="evenodd" />)}
      {maU && <rect x="8" y="8" width={W - 16} height={H - 16} fill="none" stroke="#6f679a" stroke-width="1.5" />}
      <circle cx={ax} cy={cy} r={R} fill="none" stroke="#27e8ff" stroke-width="2.2" />
      <circle cx={bx} cy={cy} r={R} fill="none" stroke="#ff2e97" stroke-width="2.2" />
      {maU && <text x="24" y="34" text-anchor="middle" class="k-venn-lab" fill="#9b93c4">U</text>}
      <text x="112" y="54" text-anchor="middle" class="k-venn-lab" fill="#27e8ff">A</text>
      <text x="328" y="54" text-anchor="middle" class="k-venn-lab" fill="#ff2e97">B</text>
      {U.map((x) => { const p = poz.get(String(x))!; return <text class="k-venn-el" data-r={p.r} x={p.x} y={p.y + 5} text-anchor="middle">{x}</text>; })}
    </svg>
  </div>
  <div class="k-venn-ctl" data-js-only hidden>
    {wyniki.map((w) => <button type="button" class="k-opt k-opt-sm" data-op={w.k} data-reg={w.regiony} set:html={tex(w.t)} />)}
  </div>
  <ul class="k-venn-w">
    {wyniki.map((w) => (
      <li data-op={w.k}>
        <span set:html={tex(`${w.t} = ${zapis(w.w)}`)} />
        <span class="k-venn-reg" set:html={`— ${texInline(w.regula)}.`} />
      </li>
    ))}
  </ul>
  <figcaption><span class="k-lbl">Jak czytać ten rysunek:</span> <slot /></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-venn]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { if (el.closest('[data-venn]') === box) el.hidden = false; });
    const btns = Array.from(box.querySelectorAll<HTMLButtonElement>('.k-venn-ctl [data-op]'));
    const items = Array.from(box.querySelectorAll<HTMLElement>('.k-venn-w [data-op]'));
    const pick = (b: HTMLButtonElement | null) => {
      const reg = b ? b.dataset.reg!.split(' ') : [];
      btns.forEach((x) => x.classList.toggle('is-on', x === b));
      items.forEach((li) => (li.hidden = !b || li.dataset.op !== b.dataset.op));
      box.classList.toggle('is-pick', !!b);
      box.querySelectorAll<SVGElement>('[data-r]').forEach((el) => el.classList.toggle('is-on', reg.includes(el.dataset.r!)));
    };
    btns.forEach((b) => b.addEventListener('click', () => pick(b.classList.contains('is-on') ? null : b)));
    pick(null);
  });
</script>

<style>
  .k-venn-r{fill:transparent;transition:fill .2s;}
  .k-venn-r.is-on{fill:rgba(255,216,74,.24);}
  .k-venn-lab{font-family:var(--mono);font-size:21px;font-weight:800;font-style:italic;}
  .k-venn-el{font-family:var(--mono);font-size:18px;font-weight:700;fill:#eef0ff;transition:fill .2s,opacity .2s;}
  .is-pick .k-venn-el{opacity:.38;}
  .is-pick .k-venn-el.is-on{opacity:1;fill:#ffd84a;}
  .k-venn-ctl{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;}
  .k-venn-ctl .k-opt{justify-content:center;min-width:64px;min-height:38px;}
  .k-venn-ctl .k-opt.is-on{border-color:var(--gold);background:rgba(255,216,74,.12);}
  .k-venn-w{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:6px;}
  .k-venn-w li{padding:8px 12px;background:rgba(255,216,74,.06);border-left:2px solid var(--gold);font-size:.92rem;line-height:1.55;}
  .k-venn-reg{color:var(--muted);}
</style>
