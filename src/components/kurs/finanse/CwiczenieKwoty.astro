---
// „Wypełnij tabelę sam” dla kwot (procent składany, plan spłaty kredytu): uczeń wpisuje liczby, „Sprawdź” koloruje pola
// i dla złych pokazuje, jak je policzyć. Poprawne wartości i opisy liczone przy buildzie (lib/finanse.js: cwSkladany, cwPlan).
// Komórka: { dana: true, tex } — podana w zadaniu; { v, pok, opis } — do wpisania: v = dokładna wartość (kropka dziesiętna),
// pok = zapis odpowiedzi („1157,63”), opis = jak ją policzyć. tol — ile złotych różnicy jeszcze uznajemy (zaokrąglenia).
import { tex, texInline } from '../../../lib/tex.js';
interface Kom { dana?: boolean; tex?: string; v?: string; pok?: string; opis?: string; et?: string }
interface Props { tytul: string; zrodlo?: string; kolumny: string[]; wiersze: Kom[][]; tol?: number; tag?: string; wspolne?: string }
const { tytul, zrodlo, kolumny, wiersze, tol = 0.011, tag = 'Wypełnij tabelę', wspolne } = Astro.props;
const html = (s: string) => (s.includes('class="katex"') ? s : texInline(s));
const opisy = wiersze.flatMap((w, i) => w.map((c, j) => (c.dana ? null : { id: `${i}-${j}`, h: html(c.opis ?? '') }))).filter(Boolean) as { id: string; h: string }[];
const et = kolumny.map((k) => k.replace(/<[^>]+>|\$/g, ''));
const maGrosze = wiersze.some((w) => w.some((c) => !c.dana && c.pok && c.pok.includes(',')));
---
<section class="k-ct k-ck" data-ck data-tol={tol}>
  <div class="k-pyt-head">
    <span class="k-pyt-tag k-ct-tag">{tag}</span>
    <h3 class="k-pyt-h">{tytul}</h3>
    {zrodlo && <span class="k-rozw-zr">{zrodlo}</span>}
  </div>
  <div class="k-ct-tresc"><slot /></div>
  <p class="k-ct-how">Wpisz liczby w puste pola — bez „zł”{maGrosze ? ', grosze po przecinku (np. 1102,50)' : ''}. Kiedy skończysz, kliknij „Sprawdź”.{maGrosze ? ' Wynik różniący się o 1 grosz (inne zaokrąglenie) też uznajemy.' : ''}</p>
  <div class="k-ck-scroll k-tp-scroll">
    <table class="k-ck-t">
      <thead><tr>{kolumny.map((k) => <th scope="col" set:html={html(k)} />)}</tr></thead>
      <tbody>
        {wiersze.map((w, i) => (
          <tr>
            {w.map((c, j) => c.dana
              ? (j === 0 ? <th scope="row" class="k-ck-dana" data-et={et[0]} set:html={tex(c.tex ?? '')} /> : <td class="k-ck-dana" data-et={et[j]}><span set:html={tex(c.tex ?? '')} /></td>)
              : (
                <td data-et={et[j]}>
                  <input class="k-ck-in" type="text" inputmode="decimal" autocomplete="off" autocapitalize="off" spellcheck="false"
                    data-v={c.v} data-pok={c.pok} data-id={`${i}-${j}`} aria-label={`${c.et ?? `wiersz ${i + 1}`}, ${kolumny[j].replace(/<[^>]+>|\$/g, '')}`} />
                </td>
              ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="k-ct-ctl" data-js-only hidden>
    <button type="button" class="k-btn" data-check>Sprawdź</button>
    <button type="button" class="k-btn k-btn-ghost" data-show>Pokaż odpowiedzi</button>
    <button type="button" class="k-btn k-btn-ghost" data-clear>Wyczyść</button>
  </div>
  <div class="k-ct-wynik" hidden aria-live="polite">
    <p class="k-ct-sum" data-sum></p>
    {wspolne && <p class="k-ck-wsp" data-wsp hidden set:html={html(wspolne)} />}
    <ul class="k-ct-bledy" data-bledy></ul>
  </div>
  <ul hidden data-expl>{opisy.map((o) => <li data-cell={o.id} set:html={o.h} />)}</ul>
</section>

<script>
  // „1 157,63 zł”, „1157.63”, „12 000”, „5%” → liczba; '' → null; śmieci → NaN
  const parse = (raw: string): number | null => {
    let s = raw.replace(/[\s   ]/g, '').replace(/zł|zl|pln|%/gi, '').replace(/[−–—]/g, '-');
    if (s === '') return null;
    if (s.includes(',') && s.includes('.')) s = s.replace(/\./g, '');
    s = s.replace(',', '.');
    if (!/^-?(\d+\.?\d*|\.\d+)$/.test(s)) return NaN;
    return Number(s);
  };
  document.querySelectorAll<HTMLElement>('[data-ck]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { if (el.closest('[data-ck]') === box) el.hidden = false; });
    const tol = Number(box.dataset.tol) || 0.011;
    const ins = Array.from(box.querySelectorAll<HTMLInputElement>('.k-ck-in'));
    const wynik = box.querySelector<HTMLElement>('.k-ct-wynik')!;
    const sum = box.querySelector<HTMLElement>('[data-sum]')!;
    const bledy = box.querySelector<HTMLElement>('[data-bledy]')!;
    const wsp = box.querySelector<HTMLElement>('[data-wsp]');
    const reset = (x: HTMLInputElement) => x.classList.remove('is-good', 'is-bad', 'is-empty', 'is-shown');
    ins.forEach((x, k) => {
      x.addEventListener('input', () => reset(x));
      x.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); (ins[k + 1] ?? box.querySelector<HTMLButtonElement>('[data-check]'))?.focus(); } });
    });
    box.querySelector('[data-check]')!.addEventListener('click', () => {
      let good = 0, empty = 0, zlyZapis = false;
      const wrong: HTMLInputElement[] = [];
      ins.forEach((x) => {
        reset(x);
        const v = parse(x.value);
        if (v === null) { empty++; x.classList.add('is-empty'); }
        else if (!Number.isNaN(v) && Math.abs(v - Number(x.dataset.v)) <= tol + 1e-9) { good++; x.classList.add('is-good'); }
        else { if (Number.isNaN(v)) zlyZapis = true; wrong.push(x); x.classList.add('is-bad'); }
      });
      bledy.innerHTML = '';
      if (!wrong.length && !empty) sum.innerHTML = '<b class="k-ct-ok">Wszystko dobrze!</b> Każda liczba się zgadza.';
      else {
        sum.innerHTML = `Dobrze: <b>${good}</b> · Źle: <b>${wrong.length}</b> · Puste: <b>${empty}</b>`
          + (wrong.length ? ' — tak policzysz pola oznaczone na różowo:' : ' — uzupełnij puste pola i sprawdź jeszcze raz.')
          + (zlyZapis ? ' (Nie rozpoznaję części zapisów — wpisuj same liczby, np. 1102,50.)' : '');
        wrong.slice(0, 4).forEach((x) => {
          const src = box.querySelector(`[data-expl] [data-cell="${x.dataset.id}"]`);
          if (src) { const li = document.createElement('li'); li.innerHTML = src.innerHTML; bledy.appendChild(li); }
        });
        if (wrong.length > 4) { const li = document.createElement('li'); li.textContent = `…i jeszcze ${wrong.length - 4}. Popraw te powyżej i sprawdź ponownie.`; bledy.appendChild(li); }
      }
      if (wsp) wsp.hidden = !wrong.length;
      wynik.hidden = false;
    });
    box.querySelector('[data-show]')!.addEventListener('click', () => {
      ins.forEach((x) => { x.value = x.dataset.pok!; reset(x); x.classList.add('is-shown'); });
      sum.innerHTML = 'Tak wygląda poprawnie wypełniona tabela. Spróbuj jeszcze raz samodzielnie — „Wyczyść” opróżnia pola.';
      if (wsp) wsp.hidden = false;
      bledy.innerHTML = '';
      wynik.hidden = false;
    });
    box.querySelector('[data-clear]')!.addEventListener('click', () => { ins.forEach((x) => { x.value = ''; reset(x); }); wynik.hidden = true; });
  });
</script>

<style>
  .k-ck-scroll{overflow-x:auto;margin:0 0 12px;padding-bottom:2px;}
  .k-ck-t{border-collapse:collapse;font-size:.95rem;}
  .k-ck-t th,.k-ck-t td{border:1px solid var(--line2);padding:4px 5px;text-align:center;vertical-align:middle;}
  .k-ck-t thead th{font-family:var(--mono);font-size:.64rem;font-weight:600;letter-spacing:.4px;text-transform:uppercase;color:#fff;
    background:rgba(167,139,250,.1);line-height:1.3;max-width:7.5em;padding:6px 6px;}
  .k-ck-dana{color:#fff;white-space:nowrap;padding:4px 9px!important;}
  th.k-ck-dana{color:var(--muted);font-weight:500;}
  .k-ck-t :global(.katex){font-size:1em!important;}
  .k-ck-in{width:5.6em;height:38px;font-family:var(--mono);font-weight:700;font-size:.95rem;text-align:center;color:var(--text);
    background:rgba(255,255,255,.04);border:1px dashed var(--line2);border-radius:0;padding:0 3px;}
  .k-ck-in:focus{outline:2px solid var(--cyan);outline-offset:1px;border-style:solid;}
  .k-ck-in.is-good{background:rgba(90,209,160,.16);border:1px solid var(--ok);}
  .k-ck-in.is-bad{background:rgba(255,46,151,.2);border:1px solid var(--magenta);color:#ffd0e6;}
  .k-ck-in.is-empty{background:rgba(255,216,74,.08);border-color:rgba(255,216,74,.5);}
  .k-ck-in.is-shown{background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.5);}
  .k-ck-wsp{margin:6px 0 8px!important;padding:8px 12px;border-left:2px solid var(--cyan);background:rgba(0,229,255,.05);font-size:.92rem;line-height:1.7;}
  /* telefon: każdy wiersz to kafelek, nazwa kolumny nad polem */
  @media(max-width:560px){
    .k-ck-t,.k-ck-t tbody{display:block;}
    .k-ck-t thead{display:none;}
    .k-ck-t tr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px 5px;margin:0 0 8px;padding:6px;border:1px solid var(--line2);}
    .k-ck-t tbody th{grid-column:1/-1;text-align:left;border:0;padding:0 2px;color:#fff!important;font-weight:600;}
    .k-ck-t tbody th[data-et]::before{content:attr(data-et) " ";}
    .k-ck-t td{display:flex;flex-direction:column;justify-content:flex-start;gap:3px;padding:0!important;border:0;}
    .k-ck-t td::before{content:attr(data-et);font-family:var(--mono);font-size:.54rem;letter-spacing:.3px;text-transform:uppercase;color:var(--muted);line-height:1.2;min-height:2.4em;white-space:normal;}
    .k-ck-t td.k-ck-dana{align-items:center;}
    .k-ck-t td.k-ck-dana > span{display:flex;align-items:center;justify-content:center;height:38px;}
    .k-ck-in{width:100%;font-size:16px;} /* 16 px: iPhone nie powiększa strony po stuknięciu w pole */
  }
</style>
