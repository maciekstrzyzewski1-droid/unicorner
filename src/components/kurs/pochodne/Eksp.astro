---
// „Tak samo stromy jak wysoki”: wykres eˣ w dwóch punktach (x = 0 i x = 1), w każdym styczna i schodek.
// Styczna do eˣ przecina oś x dokładnie 1 w lewo od punktu, więc schodek „1 w prawo” kończy się na wykresie:
// wysokość punktu (niebieski odcinek) to zarazem nachylenie stycznej. Statyczny rysunek, liczby z Math.exp.
import { skala, sciezka, osie, prosta } from '../../../lib/wykres.js';
import { texInline } from '../../../lib/tex.js';
import Legenda from '../Legenda.astro';
const W = 300, H = 300;
const S = skala({ x0: -1.4, x1: 1.9, y0: -0.45, y1: 3.4, w: W, h: H, pad: 22, rowne: true });
const r1 = (v: number) => Math.round(v * 10) / 10;
const PANELE = [0, 1].map((x0) => {
  const y0 = Math.exp(x0);
  return {
    x0, y0,
    st: prosta(x0, y0, y0, S),
    krok: { x1: r1(S.X(x0 - 1)), x2: r1(S.X(x0)), y: r1(S.Y(0)) },
    gora: { x: r1(S.X(x0)), y1: r1(S.Y(0)), y2: r1(S.Y(y0)) },
    p: { x: r1(S.X(x0)), y: r1(S.Y(y0)) },
    wys: x0 === 0 ? '1' : '2,72',
    podpis: x0 === 0
      ? 'Przy $x = 0$: wysokość $1$, nachylenie stycznej $1$.'
      : 'Przy $x = 1$: wysokość $e \\approx 2{,}72$, nachylenie stycznej też $\\approx 2{,}72$.',
  };
});
const leg: [string, string][] = [['fiolet', 'krok o $1$ w prawo'], ['cyan', 'wysokość punktu — i zarazem o ile styczna idzie w górę'], ['bialy', 'styczna (przerywana)']];
---
<figure class="k-fig k-eksp">
  <div class="k-eksp-g">
    {PANELE.map((p) => (
      <div>
        <svg viewBox={`0 0 ${W} ${H}`} class="k-w" role="img" aria-label={`Wykres e do potęgi x i styczna w punkcie x = ${p.x0}`}>
          <Fragment set:html={osie(S, { siatka: true })} />
          <path d={sciezka(Math.exp, -1.4, 1.9, S)} class="k-w-krzywa" />
          <line class="k-eksp-st" x1={p.st.x1} y1={p.st.y1} x2={p.st.x2} y2={p.st.y2} />
          <line class="k-eksp-x" x1={p.krok.x1} y1={p.krok.y} x2={p.krok.x2} y2={p.krok.y} />
          <line class="k-eksp-y" x1={p.gora.x} y1={p.gora.y1} x2={p.gora.x} y2={p.gora.y2} />
          <circle class="k-w-pkt" cx={p.p.x} cy={p.p.y} r="5" />
          <text class="k-w-tbig k-w-tc" x={(p.krok.x1 + p.krok.x2) / 2} y={p.krok.y - 9} text-anchor="middle">1</text>
          <text class="k-w-tbig k-w-ta" x={p.gora.x + 9} y={(p.gora.y1 + p.gora.y2) / 2 + 5}>{p.wys}</text>
          <text class="k-w-et" x={S.X(-1.35)} y={S.Y(0.62)}>y = eˣ</text>
        </svg>
        <p class="k-eksp-p" set:html={texInline(p.podpis)} />
      </div>
    ))}
  </div>
  <Legenda items={leg} />
  <figcaption><span class="k-lbl">Jak czytać:</span> <slot /></figcaption>
</figure>

<style>
  .k-eksp{container:eksp / inline-size;}
  .k-eksp-g{display:grid;grid-template-columns:minmax(0,1fr);gap:10px 32px;}
  @container eksp (min-width: 600px){ .k-eksp-g{grid-template-columns:minmax(0,1fr) minmax(0,1fr);max-width:700px;} }
  .k-eksp svg{max-width:330px;}
  .k-eksp-st{stroke:#f2f0fa;stroke-width:2;stroke-dasharray:8 6;}
  .k-eksp-x{stroke:#b4a7ec;stroke-width:4;stroke-linecap:round;}
  .k-eksp-y{stroke:#7db3e8;stroke-width:4;stroke-linecap:round;}
  .k-eksp-p{margin:4px 0 0!important;font-size:.9rem;line-height:1.55;color:var(--muted);max-width:330px;}
  .k-eksp :global(.k-leg){margin-top:8px!important;}
</style>
