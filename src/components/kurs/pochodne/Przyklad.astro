---
// Przykład z listy zwinięty w <details> (bez JS też działa): nagłówek „Przykład r) · f(x) = …”, w środku pełny Rachunek.
// Kotwica zad-<id> — do niej prowadzi tabela odpowiedzi (Odpowiedzi.astro).
import { tex } from '../../../lib/tex.js';
import { ETYKIETA } from '../../../lib/pochodne.js';
import Rachunek from './Rachunek.astro';
interface Props { id: string; d: any; otwarty?: boolean; nazwa?: string }
const { id, d, otwarty = false, nazwa } = Astro.props;
---
<a id={`zad-${id}`} class="k-anchor"></a>
<details class="k-det" open={otwarty}>
  <summary><span class="k-det-n">{nazwa ?? `Przykład ${ETYKIETA(id)}`}</span> <span set:html={tex(d.f)} /></summary>
  <Rachunek d={d} />
</details>

<style>
  .k-det{margin:.7em 0;border:1px solid var(--line2);background:rgba(13,12,19,.6);}
  .k-det > summary{cursor:pointer;list-style:none;display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;padding:10px 14px;}
  .k-det > summary::-webkit-details-marker{display:none;}
  .k-det > summary::before{content:'▸';color:var(--cyan);font-size:.9rem;width:1em;}
  .k-det[open] > summary::before{content:'▾';}
  .k-det > summary:hover{background:rgba(39,232,255,.04);}
  .k-det-n{font-family:var(--mono);font-size:.78rem;font-weight:700;letter-spacing:.8px;color:var(--cyan);text-transform:uppercase;}
  .k-det > :global(.k-rach){margin:0 10px 12px;}
  @media(max-width:560px){ .k-det > :global(.k-rach){margin:0 4px 10px;} }
</style>
