---
// Ćwiczenie „wpisz sam” do wzoru 3 (moduł Pochodne). Dwa tryby:
//  tryb="zapis"    — zamień zapis na potęgę: uczeń wpisuje wykładnik (np. √x = x^[1/2]),
//  tryb="pochodna" — policz pochodną a·xⁿ: uczeń wpisuje współczynnik i nowy wykładnik.
// Poprawne wartości i wyjaśnienia liczone przy buildzie (lib/pochodne.js: cwZapis, cwPotegi).
// Pola przyjmują 3, −2, 1/3, −4/3, 0,5. „Sprawdź” koloruje pola i dla złych pokazuje, jak je policzyć.
import { tex, texInline } from '../../../lib/tex.js';
interface Props { tytul: string; tryb: 'zapis' | 'pochodna'; wiersze: any[]; zrodlo?: string }
const { tytul, tryb, wiersze, zrodlo } = Astro.props;
const ok = (u: number[]) => `${u[0]}/${u[1]}`;
const pok = (u: number[]) => (u[0] < 0 ? '−' : '') + (u[1] === 1 ? `${Math.abs(u[0])}` : `${Math.abs(u[0])}/${u[1]}`);
---
<section class="k-ct k-cp" data-cp>
  <div class="k-pyt-head">
    <span class="k-pyt-tag k-ct-tag">{tryb === 'zapis' ? 'Wpisz wykładnik' : 'Wpisz pochodną'}</span>
    <h3 class="k-pyt-h">{tytul}</h3>
    {zrodlo && <span class="k-rozw-zr">{zrodlo}</span>}
  </div>
  <div class="k-ct-tresc"><slot /></div>
  <p class="k-ct-how">Wpisz liczby w pola (ułamek jako 1/3 albo −4/3). Kiedy skończysz, kliknij „Sprawdź”.</p>
  <ol class="k-cp-l">
    {wiersze.map((w, i) => tryb === 'zapis' ? (
      <li class="k-cp-w">
        <span class="k-cp-f" set:html={tex(`${w.t} = x`)} />
        <input class="k-cp-in is-wyk" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false"
          data-ok={ok(w.n)} data-pok={pok(w.n)} data-id={`${i}-n`} aria-label={`wykładnik w przykładzie ${i + 1}`} />
      </li>
    ) : (
      <li class="k-cp-w">
        <span class="k-cp-f" set:html={tex(`(${w.f})' =`)} />
        <span class="k-cp-r">
          <input class="k-cp-in" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false"
            data-ok={ok(w.wsp)} data-pok={pok(w.wsp)} data-id={`${i}-a`} aria-label={`liczba przed x w przykładzie ${i + 1}`} />
          <span class="k-cp-x" set:html={tex('\\cdot\\, x')} />
          <input class="k-cp-in is-wyk" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false"
            data-ok={ok(w.wyk)} data-pok={pok(w.wyk)} data-id={`${i}-n`} aria-label={`wykładnik w przykładzie ${i + 1}`} />
        </span>
      </li>
    ))}
  </ol>
  <div class="k-ct-ctl" data-js-only hidden>
    <button type="button" class="k-btn" data-cp-check>Sprawdź</button>
    <button type="button" class="k-btn k-btn-ghost" data-cp-show>Pokaż odpowiedzi</button>
    <button type="button" class="k-btn k-btn-ghost" data-cp-clear>Wyczyść</button>
  </div>
  <div class="k-ct-wynik" hidden aria-live="polite">
    <p class="k-ct-sum" data-sum></p>
    <ul class="k-ct-bledy" data-bledy></ul>
  </div>
  <ul hidden data-expl>
    {wiersze.flatMap((w, i) => tryb === 'zapis'
      ? [<li data-cell={`${i}-n`} set:html={texInline(`$${w.t}$: ${w.jak}`)} />]
      : [
          <li data-cell={`${i}-a`} set:html={texInline(`$(${w.f})'$ — ${w.dlaWsp}`)} />,
          <li data-cell={`${i}-n`} set:html={texInline(`$(${w.f})'$ — ${w.dlaWyk}`)} />,
        ])}
  </ul>
</section>

<script>
  const gcd = (a: number, b: number): number => { a = Math.abs(a); b = Math.abs(b); while (b) [a, b] = [b, a % b]; return a || 1; };
  // "−4/3", "-4/3", "0,5", "1.25", "4" → "n/d" (skrócony), null (puste) albo 'x' (nie rozumiem)
  const parse = (raw: string): string | null => {
    const s = raw.trim().replace(/[−–—]/g, '-').replace(',', '.').replace(/\s+/g, '');
    if (s === '') return null;
    let n: number, d: number, m: RegExpMatchArray | null;
    if ((m = s.match(/^(-?)(\d+)\/(-?)(\d+)$/))) { n = Number(m[2]) * (m[1] ? -1 : 1) * (m[3] ? -1 : 1); d = Number(m[4]); if (d === 0) return 'x'; }
    else if ((m = s.match(/^(-?)(\d*)\.(\d+)$/))) { d = 10 ** m[3].length; n = (Number(m[2] || '0') * d + Number(m[3])) * (m[1] ? -1 : 1); }
    else if ((m = s.match(/^(-?\d+)$/))) { n = Number(m[1]); d = 1; }
    else return 'x';
    const g = gcd(n, d);
    return `${n / g || 0}/${d / g}`;
  };
  document.querySelectorAll<HTMLElement>('[data-cp]').forEach((box) => {
    box.querySelectorAll<HTMLElement>('[data-js-only]').forEach((el) => { if (el.closest('[data-cp]') === box) el.hidden = false; });
    const ins = Array.from(box.querySelectorAll<HTMLInputElement>('.k-cp-in'));
    const wynik = box.querySelector<HTMLElement>('.k-ct-wynik')!;
    const sum = box.querySelector<HTMLElement>('[data-sum]')!;
    const bledy = box.querySelector<HTMLElement>('[data-bledy]')!;
    const reset = (x: HTMLInputElement) => x.classList.remove('is-good', 'is-bad', 'is-empty', 'is-shown');
    ins.forEach((x, k) => {
      x.addEventListener('input', () => reset(x));
      x.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); (ins[k + 1] ?? box.querySelector<HTMLButtonElement>('[data-cp-check]'))?.focus(); } });
    });
    box.querySelector('[data-cp-check]')!.addEventListener('click', () => {
      let good = 0, empty = 0, zlyZapis = false; const wrong: HTMLInputElement[] = [];
      ins.forEach((x) => {
        reset(x);
        const v = parse(x.value);
        if (v === null) { empty++; x.classList.add('is-empty'); }
        else if (v === x.dataset.ok) { good++; x.classList.add('is-good'); }
        else { if (v === 'x') zlyZapis = true; wrong.push(x); x.classList.add('is-bad'); }
      });
      bledy.innerHTML = '';
      if (!wrong.length && !empty) sum.innerHTML = '<b class="k-ct-ok">Wszystko dobrze!</b> Każde pole się zgadza.';
      else {
        sum.innerHTML = `Dobrze: <b>${good}</b> · Źle: <b>${wrong.length}</b> · Puste: <b>${empty}</b>` +
          (wrong.length ? ' — tak policzysz pola oznaczone na różowo:' : ' — uzupełnij puste pola i sprawdź jeszcze raz.') +
          (zlyZapis ? ' (Nie rozpoznaję części zapisów — wpisuj liczby jak 3, −2, 1/3 albo 0,5.)' : '');
        wrong.slice(0, 4).forEach((x) => {
          const src = box.querySelector(`[data-expl] [data-cell="${x.dataset.id}"]`);
          if (src) { const li = document.createElement('li'); li.innerHTML = src.innerHTML; bledy.appendChild(li); }
        });
        if (wrong.length > 4) { const li = document.createElement('li'); li.textContent = `…i jeszcze ${wrong.length - 4}. Popraw te powyżej i sprawdź ponownie.`; bledy.appendChild(li); }
      }
      wynik.hidden = false;
    });
    box.querySelector('[data-cp-show]')!.addEventListener('click', () => {
      ins.forEach((x) => { x.value = x.dataset.pok!; reset(x); x.classList.add('is-shown'); });
      sum.innerHTML = 'Tak wyglądają poprawne odpowiedzi. Spróbuj jeszcze raz samodzielnie — „Wyczyść” opróżnia pola.';
      bledy.innerHTML = ''; wynik.hidden = false;
    });
    box.querySelector('[data-cp-clear]')!.addEventListener('click', () => { ins.forEach((x) => { x.value = ''; reset(x); }); wynik.hidden = true; });
  });
</script>

<style>
  .k-cp-l{list-style:none!important;margin:0 0 12px!important;padding:0!important;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px 18px;}
  .k-cp-w{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;margin:0!important;padding:8px 10px;border:1px solid var(--line);background:rgba(255,255,255,.02);max-width:none!important;}
  .k-cp-f{white-space:nowrap;font-size:1.05rem;}
  .k-cp-r{display:inline-flex;align-items:flex-start;gap:2px;}
  .k-cp-x{font-size:1.1rem;align-self:center;}
  .k-cp-in{width:3.4em;height:38px;font-family:var(--mono);font-weight:700;font-size:16px;text-align:center;color:var(--text);
    background:rgba(255,255,255,.04);border:1px dashed var(--line2);border-radius:0;padding:0 2px;}
  .k-cp-in.is-wyk{height:30px;width:3.1em;font-size:16px;margin-top:-10px;border-color:rgba(195,177,255,.5);color:#c3b1ff;}
  .k-cp-in:focus{outline:2px solid var(--cyan);outline-offset:1px;border-style:solid;}
  .k-cp-in.is-good{background:rgba(90,209,160,.16);border:1px solid var(--ok);}
  .k-cp-in.is-bad{background:rgba(255,46,151,.2);border:1px solid var(--magenta);color:#ffd0e6;}
  .k-cp-in.is-empty{background:rgba(255,216,74,.08);border-color:rgba(255,216,74,.5);}
  .k-cp-in.is-shown{background:rgba(167,139,250,.12);border:1px solid rgba(167,139,250,.5);}
</style>
