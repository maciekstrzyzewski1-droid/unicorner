---
// „Ten sam rachunek w innych punktach”: nachylenie siecznej dla Δx = 0,01 w x₀ = 1, 2, 3 (lib/pochodne.js: wzor2x)
// i liczba, do której zmierza przy coraz mniejszym kroku — za każdym razem 2 · x₀. Rachunki w komórkach w dwóch linijkach (mieszczą się na telefonie).
import { wzor2x } from '../../../lib/pochodne.js';
import { tex } from '../../../lib/tex.js';
const W = wzor2x();
const dwie = (a: string, b: string) => `<span class="k-dwax-l">${tex(a)}</span><span class="k-dwax-l">${tex(b)}</span>`;
---
<div class="k-tab k-dwax">
  <table>
    <thead>
      <tr>
        <th>start <span set:html={tex('x_0')} /></th>
        <th>wartość po kroku: <span set:html={tex('(x_0 + 0{,}01)^2')} /></th>
        <th>o ile w górę <span set:html={tex('\\Delta y')} /></th>
        <th>nachylenie siecznej</th>
        <th>zmierza do<span class="k-dwax-sub">gdy krok → 0</span></th>
      </tr>
    </thead>
    <tbody>
      {W.map((w) => (
        <tr>
          <td set:html={tex(String(w.x0))} />
          <td set:html={dwie(`${w.tx.x1} \\cdot ${w.tx.x1}`, `= ${w.tx.fx1}`)} />
          <td set:html={dwie(`${w.tx.fx1} - ${w.fx0}`, `= ${w.tx.dy}`)} />
          <td set:html={dwie(`${w.tx.dy} : 0{,}01`, `= ${w.tx.q}`)} />
          <td class="k-dwax-gr" set:html={dwie(`${w.gr}`, `= 2 \\cdot ${w.x0}`)} />
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .k-dwax :global(.k-dwax-l){display:block;white-space:nowrap;}
  .k-dwax-sub{display:block;font-weight:400;font-size:.8em;color:var(--muted);}
  .k-dwax .k-dwax-gr{color:#fff;font-weight:600;background:rgba(95,176,127,.1);}
  .k-dwax :global(th){font-family:inherit!important;letter-spacing:0!important;font-weight:600;}
  @media(max-width:560px){
    .k-dwax :global(th){font-size:.72rem!important;}
    .k-dwax-sub{font-size:.9em;}
    .k-dwax :global(th),.k-dwax :global(td){padding:6px 5px!important;}
    .k-dwax :global(table){font-size:.84rem!important;}
  }
</style>
