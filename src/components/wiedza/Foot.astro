<script is:inline>
  (function(){
    var cards=document.querySelectorAll('.wz-card');
    if(!('IntersectionObserver' in window)){cards.forEach(function(c){c.classList.add('in')});return;}
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){
      var d=(+e.target.dataset.i||0)%6; setTimeout(function(){e.target.classList.add('in')},d*60); io.unobserve(e.target);}})},{rootMargin:'0px 0px -8% 0px'});
    cards.forEach(function(c,i){c.dataset.i=i;io.observe(c);
      c.addEventListener('pointermove',function(ev){var r=c.getBoundingClientRect();
        c.style.setProperty('--mx',(ev.clientX-r.left)+'px');c.style.setProperty('--my',(ev.clientY-r.top)+'px');});});
  })();
</script>
